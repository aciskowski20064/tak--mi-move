---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import Todo from '~/components/ui/Todo.astro';
import { pages } from '~/data/copy/pages';

/**
 * Brief §49: Claude Code nie może przedstawiać wygenerowanego tekstu
 * jako gotowej porady prawnej. Strona istnieje, żeby linki w stopce
 * nie prowadziły w pustkę, ale do czasu dostarczenia treści jest
 * wyłączona z indeksowania.
 */
const t = pages.legal.privacy;
---

<Base title={t.meta.title} description={t.meta.description} noindex>
  <PageHeader title={t.title} crumbs={[{ label: t.title, href: '/polityka-prywatnosci' }]} />

  <Section size="md">
    <p class="legal__notice">{pages.legal.notice}</p>
    <Todo label={t.body} block />
  </Section>
</Base>

<style>
  .legal__notice {
    max-width: var(--measure);
    margin-block-end: var(--space-md);
    color: var(--text-muted);
  }
</style>
