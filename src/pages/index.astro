---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/sections/Hero.astro';
import ValueStrip from '~/components/sections/ValueStrip.astro';
import StudiosSplit from '~/components/sections/StudiosSplit.astro';
import ClassesEditorial from '~/components/sections/ClassesEditorial.astro';
import Atmosphere from '~/components/sections/Atmosphere.astro';
import Reviews from '~/components/sections/Reviews.astro';
import Faq from '~/components/sections/Faq.astro';
import FinalCta from '~/components/sections/FinalCta.astro';
import { home } from '~/data/copy/home';

/**
 * Kolejność sekcji wg briefu §54. Strona główna jest skrótem marki,
 * nie katalogiem wszystkich treści (§12).
 *
 * Sekcje Zespół, Opinie i FAQ są w pełni zbudowane, ale renderują się dopiero,
 * gdy w kolekcjach treści pojawią się dane z potwierdzoną zgodą i akceptacją.
 * Na produkcji bez tych danych po prostu ich nie ma.
 */
---

<Base title={home.meta.title} description={home.meta.description}>
  <Hero />
  <ValueStrip />
  <StudiosSplit />
  <ClassesEditorial />
  {/* Sekcje „Nie wiesz, co wybrać?" i „Jak wygląda pierwsza wizyta" zdjęte
      21.08.2026. Pierwsza stała tu i na /zajecia z tej samej zmiennej, czyli
      dwa razy ten sam tekst. Druga była nagłówkiem i przyciskiem bez treści —
      jej odnośnik przeszedł do CTA na dole strony. */}
  <Atmosphere />
  <Reviews />
  <Faq />
  <FinalCta />
</Base>
