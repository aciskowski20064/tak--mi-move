---
import { getCollection } from 'astro:content';
import { typo } from '~/lib/typografia';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import ClassCard from '~/components/ui/ClassCard.astro';
import { pages } from '~/data/copy/pages';
import { home } from '~/data/copy/home';
import { copyOrNull } from '~/lib/copy';

/**
 * Przegląd zajęć (brief §13).
 *
 * Czego tu świadomie NIE ma, bo brief tego zabrania:
 *  - kilkunastu identycznych kart,
 *  - opisów długości jednego zdania,
 *  - fikcyjnych poziomów zaawansowania,
 *  - ikon niezwiązanych z treścią,
 *  - opisów wygenerowanych z nazw zajęć.
 */
const entries = await getCollection('classes', ({ data }) => import.meta.env.DEV || !data.draft);
const classes = entries.sort((a, b) => a.data.order - b.data.order);


const t = pages.classes;
const choose = home.choose;
---

<Base title={t.meta.title} description={t.meta.description}>
  <PageHeader
    eyebrow={t.eyebrow}
    title={t.title}
    titleLines={t.titleLines}
    lead={t.lead}
    crumbs={[{ label: 'Zajęcia', href: '/zajecia' }]}
  />

  <Section size="md" class="siatkaZajec">
    {
      classes.length === 0 && (
        <p class="classes__empty">
          Opisy poszczególnych zajęć przygotowujemy razem z zespołem. Aktualne terminy
          i nazwy zajęć znajdziesz już teraz w <a href="/grafik">grafiku</a>.
        </p>
      )
    }
    <ul class="classes">
      {classes.map((entry, index) => (
        <li>
          {/* Klientka: przy zajęciach zamiast lokalizacji ma stać wyjście
              do grafiku. Adres bez parametru — /grafik jest prerenderowany
              i filtrowania po formie ruchu jeszcze nie obsługuje. */}
          <ClassCard
            href={`/zajecia/${entry.id}`}
            name={entry.data.name}
            description={copyOrNull(entry.data.shortDescription)}
            index={index + 1}
            scheduleHref="/grafik"
          />
        </li>
      ))}
    </ul>
  </Section>

  <Section size="md" tone="alt" class="wybor">
    <header class="choose__head">
      <p class="eyebrow">{typo(choose.eyebrow)}</p>
      <h2>{typo(choose.title)}</h2>
    </header>

    <ul class="choose__list">
      {
        /* Podpowiedzi pod hasłami zdjęte (28.08.2026). Sekcja ma mocny
           nagłówek, a cała logika siedzi w samym haśle i w pigułkach obok
           — dwa dodatkowe wiersze pod każdym z trzech haseł rozciągały
           blok w pionie i robiły z niego opis zamiast wyboru.
           Pole `hint` zostaje w danych: nie renderujemy go, nie kasujemy. */
        choose.scenarios.map((scenario) => {
          return (
            <li class="scenariusz">
              <div class="scenariusz__tresc">
                <h3 class="scenariusz__label">{typo(scenario.label)}</h3>
              </div>

              <ul class="scenariusz__zajecia">
                {scenario.zajecia.map((z) => (
                  <li>
                    <a href={`/zajecia/${z.slug}`} data-event="class_detail_view">
                      {z.nazwa}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })
      }
    </ul>

    <p class="choose__contact">
      {choose.contactLead}{' '}
      <a href="/kontakt" data-event="email_click">{typo(choose.contactLabel)}</a>
    </p>
  </Section>

  {/* Sekcja „Pierwszy raz?" zdjęta 22.08.2026. Powtarzała wyjście, które
      i tak stoi w domykającym pasie strony głównej, a tutaj była trzecim
      z rzędu wezwaniem do rezerwacji — po przycisku w nagłówku i po
      kaflach zajęć, z których każdy prowadzi dalej. */}
</Base>

<style>
  /* Nagłówek ma własny padding od dołu, sekcja swój od góry — razem robiły
     154 px pustki, przez którą kafle wypadały poniżej pierwszego ekranu
     i nie było widać, że strona ma ciąg dalszy.

     :global, bo klasa trafia na korzeń komponentu Section, a ten nosi swój
     własny scope Astro, nie tej strony. */
  /* Dwie klasy w selektorze, bo pojedyncza przegrywała kolejnością
     z regułą .section--md z komponentu Section. */
  /* ————————————————— H1 w słupku —————————————————

     Ten sam rytm co w zatwierdzonym hero strony głównej: trzy słowa,
     każde w osobnym wierszu, wszystkie od lewej krawędzi.

     `min-content` zamiast trzech elementów blokowych albo twardych
     złamań: szerokość spada do najdłuższego słowa („RÓWNOWAGA"), więc
     każde kolejne musi zejść niżej. Treść nagłówka zostaje jednym
     ciągiem ze spacjami, czyli czytnik ekranu odczyta „SIŁA SPOKÓJ
     RÓWNOWAGA", a nie trzy osobne wyrazy. Globalne `max-width: 18ch`
     z base.css przestaje mieć znaczenie, bo min-content jest węższe.

     Stopień pisma i światło przepisane z hero: 1.08 na interlinii
     i 0.03em na rozstrzeleniu. Hero liczy stopień w `cqw`, czego tu
     powtórzyć nie można — nagłówek podstrony nie stoi w kontenerze
     zapytań. Clamp na `vw` jest dobrany tak, żeby trafić w te same
     wartości: ok. 54 px na 1280 i 32 px na 375, czyli dokładnie tyle,
     ile daje hero na tych szerokościach.

     :global, bo element nosi scope komponentu PageHeader. Arkusz tej
     strony linkuje wyłącznie /zajecia — sprawdzone pomiarem na
     pozostałych podstronach. */
  :global(.page-header__title) {
    /* Wiersze są blokowe, więc łamaniem nie steruje już szerokość
       pudełka — `min-content` i `text-wrap` nie mają tu nic do roboty.
       Zostaje samo wyrównanie do lewej krawędzi kolumny. */
    display: grid;
    justify-items: start;
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3.375rem);
    line-height: 1.08;
    letter-spacing: 0.03em;
  }

  :global(.section.siatkaZajec) {
    padding-block-start: 0;
  }

  .classes__empty {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .classes__empty a {
    color: var(--text-accent);
  }

  .classes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  /* ————————————————— rytm sekcji wyboru —————————————————

     Pomiar przed zmianą na 1280 px: sekcja 940 px wysokości, z czego
     153 px to jej własny padding, 278 px to padding trzech wierszy
     (46,4 px na każdą stronę), a treść zajmowała resztę. Struktura
     zostaje bez zmian — ścinamy wyłącznie odstępy.

     :global, bo klasa trafia na korzeń komponentu Section i nosi JEGO
     scope (ta sama pułapka co przy siatce kafli wyżej). */
  :global(.section.wybor) {
    padding-block: var(--space-lg) var(--space-md);
  }

  .choose__head {
    max-width: var(--container-text);
    margin-block-end: var(--space-md);
  }

  .choose__head h2 {
    margin-block-start: var(--space-2xs);
  }

  .choose__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }

  /* Wiersz na pełną szerokość zamiast trzech wąskich kolumn. Poprzedni układ
     dawał 28 znaków w wierszu, więc „Chcę poprawić mobilność i rozciągnięcie"
     łamało się na trzy linie. */
  .scenariusz {
    display: grid;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
  }

  .scenariusz + .scenariusz {
    border-block-start: var(--hairline) solid var(--line);
  }

  .scenariusz__label {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
  }


  /* Nazwy zajęć jako pigułki — ten sam element, co przy specjalizacjach
     na /o-nas. Wcześniej nazwy tkwiły w środku szarego zdania i tylko
     jedna z dwóch wymienionych miała dokąd prowadzić. */
  .scenariusz__zajecia {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    align-content: start;
  }

  .scenariusz__zajecia a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: var(--space-md);
    border: var(--hairline) solid var(--line-detail);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text-accent);
    font-size: var(--fs-small);
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .scenariusz__zajecia a:hover {
    background: var(--accent);
    color: var(--on-accent);
    border-color: transparent;
  }

  .choose__contact {
    margin-block-start: var(--space-md);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .choose__contact a {
    color: var(--text-accent);
  }



  @media (min-width: 48rem) {
    .classes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Pięć kolumn dopiero tam, gdzie kafel ma sensowną szerokość — ten sam
     próg co na stronie głównej. */
  @media (min-width: 64rem) {
    .classes {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-sm);
    }
  }

  @media (min-width: 52rem) {
    /* Stała szerokość toru tekstu zamiast `1fr`. Przy `1fr` kolumna
       zabierała całą wolną szerokość i pigułki lądowały dosunięte do
       prawej krawędzi kontenera — potrzeba stała po lewej, a jej
       rekomendacja 300 px dalej, bez wizualnego związku między nimi.

       `max-content` rozwiązywał odległość, ale psuł porządek: każde
       hasło ma inną długość, więc pigułki startowały w trzech różnych
       miejscach. 38 rem to szerokość, w której najdłuższe hasło
       („Chcę poprawić mobilność i rozciągnięcie", 597 px) nadal mieści
       się w jednym wierszu — pigułki stoją blisko treści I w równej
       kolumnie.

       `justify-content: start` jest konieczne, bo bez niego siatka
       rozepchnęłaby oba tory po całej szerokości. */
    .scenariusz {
      grid-template-columns: minmax(0, 38rem) auto;
      justify-content: start;
      gap: var(--space-lg);
      align-items: center;
    }
  }
</style>
