---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import Mark from '~/components/ui/Mark.astro';
import Todo from '~/components/ui/Todo.astro';
import { locations, booking } from '~/data/site';
import { pages } from '~/data/copy/pages';
import { home } from '~/data/copy/home';
import { copyOrNull } from '~/lib/copy';

/**
 * Przegląd zajęć (brief §13).
 *
 * Czego tu świadomie NIE ma, bo brief tego zabrania:
 *  - kilkunastu identycznych kart,
 *  - opisów długości jednego zdania,
 *  - fikcyjnych poziomów zaawansowania,
 *  - ikon niezwiązanych z treścią,
 *  - opisów wygenerowanych z nazw zajęć.
 */
const entries = await getCollection('classes', ({ data }) => import.meta.env.DEV || !data.draft);
const classes = entries.sort((a, b) => a.data.order - b.data.order);

const cityName = (slug: string) => locations.find((l) => l.slug === slug)?.city ?? slug;

const t = pages.classes;
const choose = home.choose;
---

<Base title={t.meta.title} description={t.meta.description}>
  <PageHeader
    eyebrow={t.eyebrow}
    title={t.title}
    lead={t.lead}
    crumbs={[{ label: 'Zajęcia', href: '/zajecia' }]}
  />

  <Section size="md">
    {
      classes.length === 0 && (
        <p class="classes__empty">
          Opisy poszczególnych zajęć przygotowujemy razem z zespołem. Aktualne terminy
          i nazwy zajęć znajdziesz już teraz w <a href="/grafik">grafiku</a>.
        </p>
      )
    }
    <ul class="classes">
      {
        classes.map((entry) => {
          const description = copyOrNull(entry.data.shortDescription);
          return (
            <li class="class-item">
              <a class="class-item__link" href={`/zajecia/${entry.id}`} data-event="class_detail_view">
                <span class="class-item__name">{entry.data.name}</span>
                <Mark size="0.85rem" class="class-item__mark" />
              </a>

              {description && <p class="class-item__desc">{description}</p>}
              {!description && <Todo label={entry.data.shortDescription} block />}

              <p class="class-item__where">
                {entry.data.locationSlugs.map((slug) => cityName(slug)).join(' · ')}
              </p>
            </li>
          );
        })
      }
    </ul>
  </Section>

  <Section size="md" tone="alt">
    <div class="choose">
      <div>
        <p class="eyebrow">{choose.eyebrow}</p>
        <h2>{choose.title}</h2>
      </div>
      <ul class="choose__list">
        {
          choose.scenarios.map((scenario) => {
            const hint = copyOrNull(scenario.hint);
            return (
              <li>
                <p class="choose__label">{scenario.label}</p>
                {hint ? <p class="choose__hint">{hint}</p> : <Todo label={scenario.hint} block />}
              </li>
            );
          })
        }
      </ul>
    </div>
  </Section>

  <Section size="md" tone="invert">
    <div class="first">
      <div>
        <p class="eyebrow">{t.firstTimeTitle}</p>
        <h2>{t.firstTimeLead}</h2>
      </div>
      <div class="first__actions">
        <Button
          href={booking.frontOfficeUrl}
          newTab={booking.newTab}
          source="class"
          event="booking_cta_click"
        >
          {booking.label}
        </Button>
        <a class="first__more" href="/pierwsza-wizyta">Jak wygląda pierwsza wizyta</a>
      </div>
    </div>
  </Section>
</Base>

<style>
  .classes__empty {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .classes__empty a {
    color: var(--text-accent);
  }

  .classes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }

  .class-item {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding-block-start: var(--space-sm);
    border-block-start: var(--hairline) solid var(--line-strong);
  }

  .class-item__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    color: inherit;
    text-decoration: none;
  }

  .class-item__name {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
  }

  .class-item__link :global(.class-item__mark) {
    color: var(--accent);
    transition: transform var(--dur) var(--ease);
  }

  .class-item__link:hover :global(.class-item__mark) {
    transform: translateX(0.25rem);
  }

  .class-item__link:hover .class-item__name {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .class-item__desc {
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .class-item__where {
    font-size: var(--fs-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .choose,
  .first {
    display: grid;
    gap: var(--space-lg);
  }

  .choose h2,
  .first h2 {
    margin-block-start: var(--space-2xs);
    max-width: 20ch;
  }

  .choose__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .choose__list li {
    padding-block-start: var(--space-sm);
    border-block-start: var(--hairline) solid var(--line-strong);
  }

  .choose__label {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
  }

  .choose__hint {
    margin-block-start: var(--space-2xs);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .first__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }

  .first__more {
    font-size: var(--fs-small);
    color: var(--accent);
    padding-block: 0.25rem;
  }

  @media (min-width: 48rem) {
    .classes {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl);
    }
  }

  @media (min-width: 60rem) {
    .choose,
    .first {
      grid-template-columns: minmax(16rem, 22rem) 1fr;
      gap: var(--space-2xl);
      align-items: start;
    }

    .choose__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
    }
  }
</style>
