---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import ClassCard from '~/components/ui/ClassCard.astro';
import Todo from '~/components/ui/Todo.astro';
import { booking } from '~/data/site';
import { pages } from '~/data/copy/pages';
import { home } from '~/data/copy/home';
import { copyOrNull } from '~/lib/copy';

/**
 * Przegląd zajęć (brief §13).
 *
 * Czego tu świadomie NIE ma, bo brief tego zabrania:
 *  - kilkunastu identycznych kart,
 *  - opisów długości jednego zdania,
 *  - fikcyjnych poziomów zaawansowania,
 *  - ikon niezwiązanych z treścią,
 *  - opisów wygenerowanych z nazw zajęć.
 */
const entries = await getCollection('classes', ({ data }) => import.meta.env.DEV || !data.draft);
const classes = entries.sort((a, b) => a.data.order - b.data.order);


const t = pages.classes;
const choose = home.choose;
---

<Base title={t.meta.title} description={t.meta.description}>
  <PageHeader
    eyebrow={t.eyebrow}
    title={t.title}
    lead={t.lead}
    crumbs={[{ label: 'Zajęcia', href: '/zajecia' }]}
  />

  <Section size="md">
    {
      classes.length === 0 && (
        <p class="classes__empty">
          Opisy poszczególnych zajęć przygotowujemy razem z zespołem. Aktualne terminy
          i nazwy zajęć znajdziesz już teraz w <a href="/grafik">grafiku</a>.
        </p>
      )
    }
    <ul class="classes">
      {classes.map((entry, index) => (
        <li>
          <ClassCard
            href={`/zajecia/${entry.id}`}
            name={entry.data.name}
            description={copyOrNull(entry.data.shortDescription)}
            locationSlugs={entry.data.locationSlugs}
            index={index + 1}
          />
        </li>
      ))}
    </ul>
  </Section>

  <Section size="md" tone="alt">
    <div class="choose">
      <div>
        <p class="eyebrow">{choose.eyebrow}</p>
        <h2>{choose.title}</h2>
      </div>
      <ul class="choose__list">
        {
          choose.scenarios.map((scenario) => {
            const hint = copyOrNull(scenario.hint);
            return (
              <li>
                <p class="choose__label">{scenario.label}</p>
                {hint ? <p class="choose__hint">{hint}</p> : <Todo label={scenario.hint} block />}
              </li>
            );
          })
        }
      </ul>
    </div>
  </Section>

  <Section size="md" tone="invert">
    <div class="first">
      <div>
        <p class="eyebrow">{t.firstTimeTitle}</p>
        <h2>{t.firstTimeLead}</h2>
      </div>
      <div class="first__actions">
        <Button
          href={booking.frontOfficeUrl}
          newTab={booking.newTab}
          source="class"
          event="booking_cta_click"
        >
          {booking.label}
        </Button>
        <a class="first__more" href="/pierwsza-wizyta">Jak wygląda pierwsza wizyta</a>
      </div>
    </div>
  </Section>
</Base>

<style>
  .classes__empty {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .classes__empty a {
    color: var(--text-accent);
  }

  .classes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .choose,
  .first {
    display: grid;
    gap: var(--space-lg);
  }

  .choose h2,
  .first h2 {
    margin-block-start: var(--space-2xs);
    max-width: 20ch;
  }

  .choose__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .choose__list li {
    padding-block-start: var(--space-sm);
    border-block-start: var(--hairline) solid var(--line-strong);
  }

  .choose__label {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
  }

  .choose__hint {
    margin-block-start: var(--space-2xs);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .first__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }

  .first__more {
    font-size: var(--fs-small);
    color: var(--accent);
    padding-block: 0.25rem;
  }

  @media (min-width: 48rem) {
    .classes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Pięć kolumn dopiero tam, gdzie kafel ma sensowną szerokość — ten sam
     próg co na stronie głównej. */
  @media (min-width: 64rem) {
    .classes {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-sm);
    }
  }

  @media (min-width: 60rem) {
    .choose,
    .first {
      grid-template-columns: minmax(16rem, 22rem) 1fr;
      gap: var(--space-2xl);
      align-items: start;
    }

    .choose__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
    }
  }
</style>
