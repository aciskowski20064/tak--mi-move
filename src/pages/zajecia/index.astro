---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import ClassCard from '~/components/ui/ClassCard.astro';
import Todo from '~/components/ui/Todo.astro';
import { pages } from '~/data/copy/pages';
import { home } from '~/data/copy/home';
import { copyOrNull } from '~/lib/copy';

/**
 * Przegląd zajęć (brief §13).
 *
 * Czego tu świadomie NIE ma, bo brief tego zabrania:
 *  - kilkunastu identycznych kart,
 *  - opisów długości jednego zdania,
 *  - fikcyjnych poziomów zaawansowania,
 *  - ikon niezwiązanych z treścią,
 *  - opisów wygenerowanych z nazw zajęć.
 */
const entries = await getCollection('classes', ({ data }) => import.meta.env.DEV || !data.draft);
const classes = entries.sort((a, b) => a.data.order - b.data.order);


const t = pages.classes;
const choose = home.choose;
---

<Base title={t.meta.title} description={t.meta.description}>
  <PageHeader
    eyebrow={t.eyebrow}
    title={t.title}
    lead={t.lead}
    crumbs={[{ label: 'Zajęcia', href: '/zajecia' }]}
  />

  <Section size="md" class="siatkaZajec">
    {
      classes.length === 0 && (
        <p class="classes__empty">
          Opisy poszczególnych zajęć przygotowujemy razem z zespołem. Aktualne terminy
          i nazwy zajęć znajdziesz już teraz w <a href="/grafik">grafiku</a>.
        </p>
      )
    }
    <ul class="classes">
      {classes.map((entry, index) => (
        <li>
          <ClassCard
            href={`/zajecia/${entry.id}`}
            name={entry.data.name}
            description={copyOrNull(entry.data.shortDescription)}
            locationSlugs={entry.data.locationSlugs}
            index={index + 1}
          />
        </li>
      ))}
    </ul>
  </Section>

  <Section size="md" tone="alt">
    <header class="choose__head">
      <p class="eyebrow">{choose.eyebrow}</p>
      <h2>{choose.title}</h2>
    </header>

    <ul class="choose__list">
      {
        choose.scenarios.map((scenario) => {
          const hint = copyOrNull(scenario.hint);
          return (
            <li class="scenariusz">
              <div class="scenariusz__tresc">
                <h3 class="scenariusz__label">{scenario.label}</h3>
                {hint ? (
                  <p class="scenariusz__hint">{hint}</p>
                ) : (
                  <Todo label={scenario.hint} block />
                )}
              </div>

              <ul class="scenariusz__zajecia">
                {scenario.zajecia.map((z) => (
                  <li>
                    <a href={`/zajecia/${z.slug}`} data-event="class_detail_view">
                      {z.nazwa}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })
      }
    </ul>

    <p class="choose__contact">
      {choose.contactLead}{' '}
      <a href="/kontakt" data-event="email_click">{choose.contactLabel}</a>
    </p>
  </Section>

  {/* Sekcja „Pierwszy raz?" zdjęta 22.08.2026. Powtarzała wyjście, które
      i tak stoi w domykającym pasie strony głównej, a tutaj była trzecim
      z rzędu wezwaniem do rezerwacji — po przycisku w nagłówku i po
      kaflach zajęć, z których każdy prowadzi dalej. */}
</Base>

<style>
  /* Nagłówek ma własny padding od dołu, sekcja swój od góry — razem robiły
     154 px pustki, przez którą kafle wypadały poniżej pierwszego ekranu
     i nie było widać, że strona ma ciąg dalszy.

     :global, bo klasa trafia na korzeń komponentu Section, a ten nosi swój
     własny scope Astro, nie tej strony. */
  /* Dwie klasy w selektorze, bo pojedyncza przegrywała kolejnością
     z regułą .section--md z komponentu Section. */
  :global(.section.siatkaZajec) {
    padding-block-start: 0;
  }

  .classes__empty {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .classes__empty a {
    color: var(--text-accent);
  }

  .classes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .choose__head {
    max-width: var(--container-text);
    margin-block-end: var(--space-lg);
  }

  .choose__head h2 {
    margin-block-start: var(--space-2xs);
  }

  .choose__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }

  /* Wiersz na pełną szerokość zamiast trzech wąskich kolumn. Poprzedni układ
     dawał 28 znaków w wierszu, więc „Chcę poprawić mobilność i rozciągnięcie"
     łamało się na trzy linie. */
  .scenariusz {
    display: grid;
    gap: var(--space-sm);
    padding-block: var(--space-lg);
  }

  .scenariusz + .scenariusz {
    border-block-start: var(--hairline) solid var(--line);
  }

  .scenariusz__label {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
  }

  .scenariusz__hint {
    margin-block-start: var(--space-2xs);
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  /* Nazwy zajęć jako pigułki — ten sam element, co przy specjalizacjach
     na /o-nas. Wcześniej nazwy tkwiły w środku szarego zdania i tylko
     jedna z dwóch wymienionych miała dokąd prowadzić. */
  .scenariusz__zajecia {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    align-content: start;
  }

  .scenariusz__zajecia a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: var(--space-md);
    border: var(--hairline) solid var(--line-detail);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text-accent);
    font-size: var(--fs-small);
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .scenariusz__zajecia a:hover {
    background: var(--accent);
    color: var(--on-accent);
    border-color: transparent;
  }

  .choose__contact {
    margin-block-start: var(--space-lg);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .choose__contact a {
    color: var(--text-accent);
  }



  @media (min-width: 48rem) {
    .classes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Pięć kolumn dopiero tam, gdzie kafel ma sensowną szerokość — ten sam
     próg co na stronie głównej. */
  @media (min-width: 64rem) {
    .classes {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-sm);
    }
  }

  @media (min-width: 52rem) {
    .scenariusz {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-xl);
      align-items: center;
    }
  }
</style>
