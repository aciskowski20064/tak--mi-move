---
import { getCollection, render } from 'astro:content';
import { typo } from '~/lib/typografia';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import Todo from '~/components/ui/Todo.astro';
import FactIcon from '~/components/ui/FactIcon.astro';
import { locations, booking } from '~/data/site';
import { copyOrNull, showPlaceholders } from '~/lib/copy';

/**
 * Szablon podstrony zajęć — dwanaście elementów z briefu §14.
 *
 * Teksty nie mogą obiecywać leczenia schorzeń ani gwarantowanych rezultatów,
 * dlatego nota o przeciwwskazaniach zawsze odsyła do specjalisty, a nie
 * do nas.
 */
export async function getStaticPaths() {
  const entries = await getCollection('classes', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const cityName = (slug: string) => locations.find((l) => l.slug === slug)?.city ?? slug;
const shortDescription = copyOrNull(d.shortDescription);
/* Tekst „Jak się przygotować". Dla aerial yogi stoi w kolekcji jako `TODO(`,
   więc `copyOrNull` zwraca null: w wersji poglądowej klientka zobaczy w tym
   miejscu znacznik brakującej treści, a w produkcji blok zniknie. */
const przygotowanie = copyOrNull(d.preparation);

const intensityLabel: Record<string, string> = {
  low: 'spokojne',
  medium: 'umiarkowane',
  high: 'intensywne',
  varied: 'zmienne',
};



/**
 * Miasta w tytule biorą się z `locationSlugs` konkretnych zajęć, nie ze
 * sztywnej listy — barre odbywa się tylko w Pruszczu, więc obiecywanie
 * Gdańska byłoby nieprawdą także w wynikach wyszukiwania.
 */
const cities = d.locationSlugs.map(cityName);
const citiesLabel = cities.length > 1 ? `${cities.slice(0, -1).join(', ')} i ${cities.at(-1)}` : cities[0];

/**
 * Karty faktów — układ z makiety z 22.08.2026. Każda karta bierze dane,
 * które już siedzą w kolekcji, więc nic nie trzeba dopisywać:
 * `audience`, `goals` oraz `intensity`/`duration`/`level`.
 *
 * Makieta miała tu jeszcze kadr obok nagłówka i zdjęcie przy cytacie.
 * Zdjęć poszczególnych zajęć nie mamy, więc nagłówek jest wyśrodkowany,
 * a karty niosą całą sekcję same.
 *
 * Typ jest wypisany jawnie, a filtr jest strażnikiem typu. Wcześniej brał
 * się z wnioskowania, bo w tablicy stała karta lokalizacji, której `punkty`
 * na pewno istniały. Po jej usunięciu każda pozycja może być pusta i sam
 * `filter` tego TypeScriptowi nie zawęża.
 */
type KartaFaktu = {
  ikona: 'users' | 'heart' | 'clock';
  label: string;
  punkty?: readonly string[];
};

const kartyWszystkie: KartaFaktu[] = [
  { ikona: 'users', label: 'Dla kogo', punkty: d.audience },
  // Etykieta „Efekty" w miejsce „Co daje" — wskazana przez klientkę (25.08.2026).
  { ikona: 'heart', label: 'Efekty', punkty: d.goals },
  {
    ikona: 'clock',
    label: 'Tempo',
    punkty: [
      d.duration,
      d.intensity ? `Tempo ${intensityLabel[d.intensity]}` : undefined,
      d.level,
    ].filter(Boolean) as string[],
  },
  // Karta „Lokalizacje" usunięta: klientka nie chce podawać lokalizacji przy
  // zajęciach ani tutaj, ani na stronie zbiorczej. `cities` zostaje, bo niesie
  // je jeszcze tytuł i opis dla wyszukiwarek.
];

const karty = kartyWszystkie.filter(
  (k): k is KartaFaktu & { punkty: readonly string[] } => Boolean(k.punkty?.length),
);

const title = d.seoTitle ?? `${d.name} — ${citiesLabel}`;
const description =
  d.seoDescription ??
  (shortDescription ??
    `${d.name} w studiach TAK MI MOVE — ${citiesLabel}. Kameralne grupy, zapisy online.`);
---

<Base title={title} description={description}>
  <PageHeader
    eyebrow="Zajęcia"
    title={d.name}
    lead={shortDescription ?? undefined}
    crumbs={[
      { label: 'Zajęcia', href: '/zajecia' },
      { label: d.name, href: `/zajecia/${entry.id}` },
    ]}
    size="md"
    rule
  />

  {!shortDescription && (
    <Section as="div" size="sm">
      <Todo label={d.shortDescription} block />
    </Section>
  )}

  <Section as="div" size="sm">
    <div class="klasa__akcje">
      <Button
        href={booking.frontOfficeUrl}
        newTab={booking.newTab}
        source="class"
        event="booking_cta_click"
      >
        {booking.label}
      </Button>
      <Button href="/grafik" variant="secondary" source="class">Zobacz grafik</Button>
    </div>
  </Section>

  <Section size="md" tone="alt">
    <ul class="fakty">
      {
        karty.map((k) => (
          <li class="fakt">
            <span class="fakt__znak" aria-hidden="true">
              <FactIcon name={k.ikona} size="1.2rem" />
            </span>
            <h2 class="fakt__label">{k.label}</h2>
            <ul class="fakt__punkty">
              {k.punkty.map((p) => (
                <li>{typo(p)}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section size="lg">
    <div class="klasa__tresc">
      <div class="prose">
        <Content />
      </div>

      <aside class="klasa__bok">
        {/* Blok „Co zabrać" zdjęty na prośbę klientki (25.08.2026), a na jego
            miejsce weszło „Jak się przygotować" z jej własnym tekstem.
            Pole `equipment` zostaje w kolekcji do rozstrzygnięcia w Etapie 6 —
            nie renderuje się nigdzie, ale kasowanie danych przed decyzją
            byłoby nieodwracalne. */}
        {/* Warunek obejmuje CAŁĄ sekcję razem z nagłówkiem, nie samą treść.
            Pierwsza wersja renderowała `<h2>` zawsze, gdy pole istniało,
            a w środku stawiała <Todo>. W wersji poglądowej wyglądało to
            dobrze, ale w produkcji <Todo> znika i na stronie aerial yogi
            zostawał nagłówek „Jak się przygotować" bez ani jednego zdania
            pod spodem. Wykryte próbnym buildem z DEMO_MODE = false. */}
        {przygotowanie ? (
          <section class="blok">
            <h2 class="blok__tytul">Jak się przygotować</h2>
            <p class="blok__tekst">{typo(przygotowanie)}</p>
          </section>
        ) : showPlaceholders && d.preparation ? (
          <section class="blok">
            <h2 class="blok__tytul">Jak się przygotować</h2>
            <Todo label={d.preparation} block />
          </section>
        ) : null}

        {
          d.contraindicationsNote && (
            <section class="blok blok--uwaga">
              <h2 class="blok__tytul">Zanim zaczniesz</h2>
              <p class="blok__tekst">{typo(d.contraindicationsNote)}</p>
            </section>
          )
        }
      </aside>
    </div>
  </Section>

  <Section size="md" tone="soft">
    <div class="domkniecie">
      <div>
        <h2 class="domkniecie__tytul">Sprawdź, kiedy odbywają się zajęcia</h2>
        <p class="domkniecie__lead">Wybierz termin w grafiku i dołącz do kameralnej grupy.</p>
      </div>
      <div class="domkniecie__akcje">
        <Button
          href={booking.frontOfficeUrl}
          newTab={booking.newTab}
          source="class"
          event="booking_cta_click"
        >
          {booking.label}
        </Button>
        <Button href="/grafik" variant="secondary" source="class">Zobacz grafik</Button>
      </div>
    </div>
  </Section>
</Base>

<style>
  .klasa__akcje {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  /* ————————————————— cztery karty faktów ————————————————— */

  .fakty {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .fakt {
    background: var(--surface);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-card);
    padding: var(--space-md);
  }

  .fakt__znak {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-pill);
    border: var(--hairline) solid var(--line-detail);
    color: var(--accent);
    margin-block-end: var(--space-sm);
  }

  .fakt__label {
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-accent);
    margin-block-end: var(--space-2xs);
  }

  /* Punkty bez kropek — to nie jest wyliczanka do przeczytania po kolei,
     tylko trzy fakty, z których każdy stoi sam. */
  .fakt__punkty {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ————————————————— treść i bok ————————————————— */

  .klasa__tresc {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .blok + .blok {
    margin-block-start: var(--space-lg);
  }

  .blok__tytul {
    font-size: var(--fs-h4);
    margin-block-end: var(--space-sm);
  }

  /* Nota o przeciwwskazaniach dostaje własne tło i pasek — to jedyny tekst
     na tej stronie, którego przeoczenie ma realne konsekwencje. */
  .blok--uwaga {
    background: var(--surface-alt);
    border-inline-start: 3px solid var(--accent);
    border-start-end-radius: var(--radius-md);
    border-end-end-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .blok__tekst {
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ————————————————— domknięcie ————————————————— */

  .domkniecie {
    display: grid;
    gap: var(--space-md);
  }

  .domkniecie__tytul {
    font-size: var(--fs-h3);
  }

  .domkniecie__lead {
    margin-block-start: var(--space-2xs);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .domkniecie__akcje {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  @media (min-width: 40rem) {
    .fakty {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 52rem) {
    .domkniecie {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--space-xl);
    }
  }

  @media (min-width: 64rem) {
    /* Trzy kolumny, nie cztery — karta „Lokalizacje" odpadła (25.08.2026)
       i przy czterech torach zostawał pusty tor po prawej. */
    .fakty {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-sm);
    }

    /* Bok trzyma stałą kolumnę: to krótkie listy, a treść główna jest
       tekstem ciągłym i potrzebuje pełnej miary czytelności. */
    .klasa__tresc {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
      gap: var(--space-2xl);
    }
  }
</style>
