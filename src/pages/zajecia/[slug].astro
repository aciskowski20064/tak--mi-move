---
import { getCollection, render } from 'astro:content';
import { typo } from '~/lib/typografia';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import Todo from '~/components/ui/Todo.astro';
import FactIcon from '~/components/ui/FactIcon.astro';
import { locations } from '~/data/site';
import { copyOrNull, isPlaceholder } from '~/lib/copy';

/**
 * Szablon podstrony zajęć.
 *
 * UKŁAD PO ETAPIE 6 (28.08.2026): nagłówek → cztery bloki → „Grafik" →
 * pas domykający. Lista bloków jest ZAMKNIĘTA i liczy dokładnie cztery
 * pozycje: Czego się spodziewać, Dla kogo, Efekty, Jak się przygotować.
 *
 * Co z tej strony zniknęło i dlaczego:
 *
 *   opis wprowadzający  klientka: po wejściu w konkretne zajęcia ma nie być
 *                       opisu przed właściwymi blokami. Zdjęty jest zarówno
 *                       lead w nagłówku, jak i akapit otwierający w treści.
 *   Tempo               poza listą czterech. Pola `duration`, `intensity`
 *                       i `level` zostają w modelu — nie renderujemy ich.
 *   Co zabrać           poza listą. `equipment` i tak nie było renderowane.
 *   lokalizacje         klientka: przy zajęciach lokalizacji nie podajemy.
 *   para przycisków     stała między nagłówkiem a treścią i była trzecim
 *                       wezwaniem na stronie. Wyjście do grafiku jest teraz
 *                       jedno, lekkie, pod blokami.
 *   Zanim zaczniesz     poza listą czterech. TO JEST TREŚĆ ZDROWOTNA —
 *                       przeciwwskazania, przy aerial yodze konkretne
 *                       (jaskra, nadciśnienie, kardiologia, ciąża, błędnik).
 *                       Dane zostają w kolekcji, rolę tej sekcji przejmuje
 *                       „Urazy i szczególne potrzeby" na /pierwsza-wizyta.
 *                       Zgłoszone do decyzji w raporcie Etapu 6.
 *
 * Teksty nie mogą obiecywać leczenia schorzeń ani gwarantowanych rezultatów.
 */
export async function getStaticPaths() {
  const entries = await getCollection('classes', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

/**
 * Miasta idą już WYŁĄCZNIE do tytułu i opisu dla wyszukiwarek. W widocznej
 * treści strony lokalizacji nie ma nigdzie — ani w nagłówku, ani w blokach.
 */
const cityName = (slug: string) => locations.find((l) => l.slug === slug)?.city ?? slug;
const cities = d.locationSlugs.map(cityName);
const citiesLabel =
  cities.length > 1 ? `${cities.slice(0, -1).join(', ')} i ${cities.at(-1)}` : cities[0];

const shortDescription = copyOrNull(d.shortDescription);

/**
 * „Jak się przygotować". Cztery formy ruchu mają tekst wprost od klientki
 * (25.08.2026). Aerial yoga ma dostać własny, którego w żadnym materiale
 * nie ma — jej pole stoi jako `TODO(`.
 *
 * Warunek stoi na `import.meta.env.DEV`, nie na `showPlaceholders`.
 * Różnica jest istotna: `showPlaceholders` obejmuje też DEMO_MODE, czyli
 * wersję poglądową, którą ogląda klientka — a ona nie ma oglądać przerywanej
 * ramki „Do uzupełnienia". Znacznik widzimy my przy `npm run dev`, w każdym
 * buildzie blok znika W CAŁOŚCI, razem z nagłówkiem i piktogramem.
 *
 * Osierocony nagłówek bez treści był już raz wykryty próbnym buildem
 * z DEMO_MODE = false — zabezpieczenie zostaje.
 */
const przygotowanieBrakuje = isPlaceholder(d.preparation);

type Blok = {
  ikona: 'sun' | 'users' | 'heart' | 'check';
  label: string;
  /** Lista punktów albo pojedynczy akapit — bloki mają różny kształt treści. */
  punkty?: readonly string[];
  tekst?: string;
  /** Treść bierze się z ciała pliku Markdown, nie z pola. */
  zTresci?: boolean;
  brakuje?: boolean;
};

const blokiWszystkie: Blok[] = [
  { ikona: 'sun', label: 'Czego się spodziewać', zTresci: true },
  { ikona: 'users', label: 'Dla kogo', punkty: d.audience },
  // Etykieta „Efekty" w miejsce „Co daje" — wskazana przez klientkę (25.08.2026).
  { ikona: 'heart', label: 'Efekty', punkty: d.goals },
  {
    ikona: 'check',
    label: 'Jak się przygotować',
    tekst: d.preparation,
    brakuje: przygotowanieBrakuje,
  },
];

const bloki = blokiWszystkie.filter((b) => {
  if (b.brakuje) return import.meta.env.DEV;
  return b.zTresci || b.punkty?.length || b.tekst;
});

const title = d.seoTitle ?? `${d.name} — ${citiesLabel}`;
const description =
  d.seoDescription ??
  (shortDescription ??
    `${d.name} w studiach TAK MI MOVE — ${citiesLabel}. Kameralne grupy, zapisy online.`);
---

<Base title={title} description={description}>
  {/* Bez leadu: opis wprowadzający zdjęty na prośbę klientki. Po nagłówku
      strona przechodzi od razu do uporządkowanej informacji. */}
  <PageHeader
    size="sm"
    eyebrow="Zajęcia"
    title={d.name}
    crumbs={[
      { label: 'Zajęcia', href: '/zajecia' },
      { label: d.name, href: `/zajecia/${entry.id}` },
    ]}
  />

  <Section as="div" size="sm" class="bloki-sekcja">
    <ul class="bloki">
      {
        bloki.map((b) => (
          <li class="blok">
            <span class="znak blok__ikona" aria-hidden="true">
              <FactIcon name={b.ikona} />
            </span>
            <div class="blok__tresc">
              <h2 class="blok__label">{typo(b.label)}</h2>

              {b.zTresci && (
                <div class="blok__proza">
                  <Content />
                </div>
              )}

              {b.punkty && (
                <ul class="blok__punkty">
                  {b.punkty.map((p) => (
                    <li>{typo(p)}</li>
                  ))}
                </ul>
              )}

              {b.tekst && !b.brakuje && <p class="blok__tekst">{typo(b.tekst)}</p>}
              {b.brakuje && <Todo label={b.tekst!} block />}
            </div>
          </li>
        ))
      }
    </ul>

    {/* Przejście bloki → grafik → rezerwacja. Trzeci poziom wezwania
        (`.link-cta` z base.css), ten sam, który zamyka pas faktów na
        podstronach studiów. Lokalizacji w tym miejscu nie ma. */}
    <p class="grafik">
      <a
        class="link-cta"
        href="/grafik"
        aria-label={`Grafik — ${d.name}`}
        data-event="schedule_page_view"
        data-source="class"
      >
        <FactIcon name="calendar" size="1.1rem" />
        Grafik
      </a>
    </p>
  </Section>

  {/* Pas domykający „Sprawdź, kiedy odbywają się zajęcia" USUNIĘTY
      (28.08.2026). Dublował funkcję wyjścia „Grafik", które stoi tuż nad
      nim — na jednym ekranie były dwa wezwania do tej samej rzeczy.
      Rezerwacja ma własny, stały przycisk w nagłówku serwisu. */}
</Base>

<style>
  /* Nagłówek bez leadu zostawiał pod kreską pas pustki — ta sama sytuacja
     i to samo rozwiązanie co na podstronach studiów.

     :global, bo klasa trafia na korzeń komponentu Section i nosi JEGO scope. */
  /* Nagłówek bez leadu zostawiał pod kreską pas pustki. `PageHeader` ma
     własny `padding-block-end` i nie przyjmuje klasy, więc górę tej sekcji
     zerujemy i dokładamy ujemny margines. Bezpieczne wyłącznie dlatego,
     że obie sekcje stoją na tonie `default`, czyli na tym samym
     `--surface` — nie ma szwu do odsłonięcia. */
  :global(.section.bloki-sekcja) {
    padding-block-start: 0;
    margin-block-start: calc(var(--space-sm) * -1.5);
  }

  /* ————————————————— cztery karty ——————————————————

     LEKKO, NIE KARTAMI — ten sam wzorzec, który został zatwierdzony na
     podstronach studiów w Etapie 5: znak w kółku, nagłówek, tekst, odstęp
     i jedna włoskowata kreska między kolumnami. Żadnej obwódki wokół
     informacji, żadnego wypełnienia, zero efektu panelu administracyjnego.

     Wzorzec jest tu powtórzony, a nie wyciągnięty do wspólnego komponentu:
     Etap 5 jest zatwierdzony commitem 739e965, a wspólny komponent oznaczałby
     ruch w jego stylach. Ryzyko regresji przewyższa zysk z odchudzenia kodu.

     UKŁAD 2 × 2 dobrany pod REALNE długości: „Czego się spodziewać" to
     245–348 znaków, „Dla kogo" ok. 150, „Efekty" ok. 120, „Jak się
     przygotować" 170. Najdłuższy blok jest ok. dwa razy dłuższy od
     najkrótszego — przy dwóch szerokich torach różnica jest do zniesienia,
     przy czterech wąskich zrobiłaby z jednego bloku pionową wstążkę. */
  .bloki {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  /* Karta lekka: włoskowata obwódka, promień większy niż w kaflach zajęć
     (14 px wobec 10), spokojny wewnętrzny margines. Bez cienia, bez
     wypełnienia, bez stanu najechania — to nie jest element klikalny,
     tylko pudełko na informację. Promień i padding stoją tu wartościami,
     nie tokenami: `--radius-card` to 10 px, a między `--space-md` (27 px)
     a `--space-lg` (46 px) nie ma stopnia, który trafiłby w zamówione 28–32. */
  .blok {
    display: block;
    border: var(--hairline) solid var(--line);
    border-radius: 14px;
    padding: clamp(1.5rem, 1.1rem + 1vw, 2rem);
  }

  /* Znak NAD tytułem, nie obok. W karcie z własnym marginesem układ
     poziomy zabierałby tekstowi 3,5 rem szerokości na każdym torze. */
  .blok__ikona {
    --znak-size: 2.5rem;
    margin-block-end: var(--space-sm);
  }

  .blok__label {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: 400;
    margin-block-end: var(--space-2xs);
  }

  .blok__tekst,
  .blok__proza {
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: 1.55;
  }

  .blok__proza :global(p + p) {
    margin-block-start: var(--space-2xs);
  }

  /* Punkty bez kropek — to nie jest wyliczanka do przeczytania po kolei,
     tylko trzy fakty, z których każdy stoi sam. */
  .blok__punkty {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: 1.55;
  }
  /* ————————————————— wyjście do grafiku ————————————————— */

  .grafik {
    margin-block-start: var(--space-lg);
  }

  /* ————————————————— pas domykający ————————————————— */

  .domkniecie {
    display: grid;
    gap: var(--space-md);
  }

  .domkniecie__tytul {
    font-size: var(--fs-h3);
  }

  .domkniecie__lead {
    margin-block-start: var(--space-2xs);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .domkniecie__akcje {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  @media (min-width: 52rem) {
    .domkniecie {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-xl);
    }
  }

  @media (min-width: 64rem) {
    .bloki {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* Odstęp jednakowy w obu osiach: karty mają własne krawędzie,
         więc rynna nie musi już zastępować wydzielenia. */
      gap: var(--space-md);
    }

    /* Nieparzysta liczba bloków — dziś aerial yoga, dopóki klientka nie
       przyśle opisu przygotowania. Ostatni blok bierze wtedy oba tory,
       zamiast zostawiać w drugim rzędzie dziurę na pół szerokości. */
    .blok:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
</style>
