---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import Mark from '~/components/ui/Mark.astro';
import Todo from '~/components/ui/Todo.astro';
import Team from '~/components/sections/Team.astro';
import { booking, locations, formatAddress } from '~/data/site';
import { pages } from '~/data/copy/pages';
import { copyOrNull, realOnly } from '~/lib/copy';
import zespolPrzyLogo from '~/assets/photos/zespol-przy-logo.jpg';
import zalozycielka from '~/assets/photos/zalozycielka-portret.jpg';

/**
 * Układ wg makiety zaakceptowanej 19.08.2026, przełożony na nasz system:
 * nagłówek trzyma wspólny wzorzec podstron (okruszki, nadtytuł, tytuł, kreska),
 * kadr stoi obok tekstu, a rolę ikon pełni symbol-kropla — makieta miała sześć
 * różnych piktogramów i botaniczne ornamenty, czyli drugi język dekoracyjny
 * obok tego, który brief §8 wybrał zamiast biblioteki ikon.
 *
 * Blok o historii marki NIE jest cytatem. Materiał od klientki (odpowiedź 54)
 * to streszczenie maila, nie jej zdania — w makiecie stał w cudzysłowie
 * z podpisem, czyli jako słowa, których nigdy nie wypowiedziała.
 */
const t = pages.about;
const lead = copyOrNull(t.lead);
const values = realOnly(t.values.items, (item) => item.body);
const cards = [t.spaces, t.community];
---

<Base title={t.meta.title} description={t.meta.description}>
  <Section as="div" size="md" class="intro">
    <div class="intro__grid">
      <div class="intro__text">
        <Breadcrumbs items={[{ label: 'O nas', href: '/o-nas' }]} />
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="page-header__title">{t.title}</h1>
        <span class="page-header__rule" aria-hidden="true"></span>
        {lead ? <p class="lead page-header__lead">{lead}</p> : <Todo label={t.lead} block />}
      </div>

      <figure class="intro__figure">
        <Image
          src={zespolPrzyLogo}
          alt="Cztery kobiety z zespołu TAK MI MOVE z uniesionymi rękami przy podświetlanym logo studia"
          widths={[520, 780, 1100]}
          sizes="(min-width: 60rem) 46vw, 100vw"
          loading="eager"
          class="intro__image"
        />
        <figcaption class="intro__card">
          <span class="intro__cardLabel">{t.heroCard.label}</span>
          <span class="intro__cardLine">{t.heroCard.line}</span>
        </figcaption>
      </figure>
    </div>
  </Section>

  <Section size="lg" tone="alt">
    <article class="founder">
      <figure class="founder__figure">
        <Image
          src={zalozycielka}
          alt="Katarzyna Zawadzka, założycielka TAK MI MOVE, siedzi na blacie recepcji pod logo studia"
          widths={[320, 480, 640]}
          sizes="(min-width: 60rem) 24vw, 70vw"
          class="founder__portrait"
        />
        <figcaption class="founder__caption">
          <span class="founder__name">{t.founder.name}</span>
          <span class="founder__role">{t.founder.caption}</span>
        </figcaption>
      </figure>

      <div class="founder__text">
        <p class="founder__eyebrow eyebrow">{t.founder.eyebrow}</p>
        <h2 class="founder__title">{t.founder.title}</h2>

        {t.founder.intro.map((akapit) => (
          <p class="founder__body">{akapit}</p>
        ))}

        {/* Cudzysłów jest tu uprawniony: to zdania napisane przez klientkę
            w pierwszej osobie, nie streszczenie cudzego opracowania. */}
        <blockquote class="founder__quote">
          <p>{t.founder.quote}</p>
        </blockquote>

        <p class="founder__body">{t.founder.afterQuote}</p>

        <ul class="founder__tags">
          {t.founder.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </div>
    </article>
  </Section>

  <Section size="lg">
    <div class="values">
      <p class="values__motto">{t.values.motto}</p>
      <h2 class="values__title">{t.values.title}</h2>
      <ul class="values__list">
        {
          values.map((value) => (
            <li class="value">
              <span class="value__badge" aria-hidden="true">
                <Mark size="1.35rem" />
              </span>
              <div>
                <h3 class="value__title">{value.title}</h3>
                <p class="value__body">{value.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section size="md">
    <div class="cards">
      {
        cards.map((card) => {
          const body = copyOrNull(card.body);
          return (
            <article class="card">
              <span class="card__badge" aria-hidden="true">
                <Mark size="1.35rem" />
              </span>
              <div>
                <h2 class="card__title">{card.title}</h2>
                {body ? <p class="card__body">{body}</p> : <Todo label={card.body} block />}
              </div>
            </article>
          );
        })
      }
    </div>
  </Section>

  <Section size="md" tone="alt">
    <div class="places">
      <h2 class="places__title">{t.locationsTitle}</h2>
      <ul class="places__list">
        {
          locations.map((location) => (
            <li class="place">
              <a href={`/studia/${location.slug}`} data-event="studio_location_select">
                <strong>{location.city}</strong>
                <span>{formatAddress(location)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Team />

  <Section size="md" tone="soft">
    <div class="cta">
      <h2>{t.ctaTitle}</h2>
      <Button
        href={booking.frontOfficeUrl}
        newTab={booking.newTab}
        size="lg"
        source="final"
        event="booking_cta_click"
      >
        {booking.label}
      </Button>
    </div>
  </Section>
</Base>

<style>
  /* ————————————————————————— nagłówek ————————————————————————— */

  .intro__grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .intro__figure {
    margin: 0;
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .intro__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    aspect-ratio: 3 / 2;
    /* Kobiety siedzą w dolnych dwóch trzecich kadru. */
    object-position: 50% 62%;
  }

  /* Podpis leży na zdjęciu, więc tło musi być kryjące — półprzezroczysta
     płytka nad fotografią daje kontrast zależny od tego, co pod nią wypadnie. */
  .intro__card {
    position: absolute;
    inset-inline-start: var(--space-md);
    /* `inset-inline` na obu krawędziach rozciągało płytkę przez cały kadr;
       `max-inline-size` trzyma ją w rogu, ale nie pozwala wyjść poza zdjęcie. */
    max-inline-size: calc(100% - 2 * var(--space-md));
    bottom: var(--space-md);
    background: var(--surface);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    display: inline-grid;
    gap: 0.15em;
  }

  .intro__cardLabel {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
  }

  .intro__cardLine {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* ————————————————————————— założycielka —————————————————————————

     Blok dostał własną sekcję na pełnej szerokości, a nie wąską kartę obok
     wartości. Powód jest w treści: klientka przysłała trzy akapity, a kolumna
     w poprzednim układzie dawała 30 znaków w wierszu — dwa razy mniej,
     niż potrzeba, żeby dało się to czytać. */

  .founder {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
  }

  .founder__figure {
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  /* Naturalna proporcja pliku (2:3) — bez przycinania i bez rozciągania
     na wysokość sąsiedniej kolumny, przez które portret zamieniał się
     w pionowy pasek. */
  .founder__portrait {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  /* Podpis pod zdjęciem, wyśrodkowany, zamknięty krótką kreską — jedyne
     miejsce na stronie, gdzie tekst jest centrowany, bo domyka kadr. */
  .founder__caption {
    display: grid;
    justify-items: center;
    gap: 0.15em;
    text-align: center;
  }

  .founder__name {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .founder__role {
    font-size: var(--fs-small);
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .founder__caption::after {
    content: '';
    inline-size: 2.5rem;
    block-size: 1px;
    background: var(--line-detail);
    margin-block-start: var(--space-sm);
  }

  /* Nadtytuł ciągnie za sobą kreskę aż do końca swojej linii. */
  .founder__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    max-inline-size: 24rem;
  }

  .founder__eyebrow::after {
    content: '';
    flex: 1;
    block-size: 1px;
    background: var(--line-detail);
  }

  .founder__title {
    font-size: var(--fs-h2);
    margin-block: var(--space-sm) var(--space-md);
    max-width: 16ch;
  }

  .founder__body {
    max-width: var(--measure);
    margin-block-end: var(--space-md);
  }

  /* Cytat wyjęty z toku tekstu: własne tło, pasek akcentu i prawdziwa
     kursywa (font wczytany osobno — syntetyczna psuje polskie znaki). */
  .founder__quote {
    margin: 0 0 var(--space-md);
    max-width: var(--measure);
    background: var(--surface-soft);
    border-inline-start: 3px solid var(--accent);
    border-start-end-radius: var(--radius-md);
    border-end-end-radius: var(--radius-md);
    padding: var(--space-md) var(--space-md) var(--space-md) var(--space-lg);
    position: relative;
  }

  .founder__quote::before {
    content: '„';
    position: absolute;
    inset-block-start: 0.05em;
    inset-inline-start: 0.28em;
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    color: var(--accent);
  }

  .founder__quote p {
    font-style: italic;
    font-size: var(--fs-lead);
    line-height: var(--lh-loose);
  }

  .founder__tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .founder__tags li {
    border: var(--hairline) solid var(--line-detail);
    border-radius: var(--radius-pill);
    padding: 0.5em 1.1em;
    font-size: var(--fs-small);
    color: var(--text-accent);
  }

  /* ————————————————————————— wartości ————————————————————————— */

  .values__motto {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    color: var(--text-accent);
    letter-spacing: 0.08em;
    margin-block-end: var(--space-3xs);
  }

  .values__title {
    font-size: var(--fs-h3);
    margin-block-end: var(--space-lg);
  }

  .values__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .value,
  .card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm);
    align-items: start;
    background: var(--surface-alt);
    border-radius: var(--radius-card);
    padding: var(--space-md);
  }

  .value__badge,
  .card__badge {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-pill);
    background: var(--surface-soft);
    color: var(--accent-strong);
  }

  .value__title {
    font-size: var(--fs-h4);
    margin-block-end: var(--space-3xs);
  }

  .value__body,
  .card__body {
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: var(--measure);
  }

  /* ————————————————— dwie karty pod spodem ————————————————— */

  .cards {
    display: grid;
    gap: var(--space-md);
  }

  .card__title {
    font-size: var(--fs-h4);
    margin-block-end: var(--space-3xs);
  }

  /* ————————————————————————— lokalizacje ————————————————————————— */

  .places {
    display: grid;
    gap: var(--space-md);
    align-items: center;
  }

  .places__title {
    font-size: var(--fs-h3);
  }

  .places__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .place a {
    display: grid;
    gap: 0.2em;
    padding-block: var(--space-2xs);
    color: inherit;
    text-decoration: none;
  }

  .place strong {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: 400;
  }

  .place span {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .place a:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .cta {
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  @media (min-width: 40rem) {
    /* Portret dostaje kolumnę o stałej szerokości, żeby proporcja zdjęcia
       decydowała o jego wysokości, a nie długość tekstu obok. */
    .founder {
      grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr);
      gap: var(--space-2xl);
    }

    .cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .places {
      grid-template-columns: auto 1fr;
      gap: var(--space-xl);
    }

    .places__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (min-width: 60rem) {
    .intro__grid {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-2xl);
    }

    /* Cztery kafle w rzędzie — wartości to krótkie bloki, a sekcja ma teraz
       pełną szerokość, więc układ 2×2 zostawiałby połowę wiersza pustą. */
    .values__list {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-md);
    }

    .value {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
  }
</style>
