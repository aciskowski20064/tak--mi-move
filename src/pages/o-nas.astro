---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import Mark from '~/components/ui/Mark.astro';
import Todo from '~/components/ui/Todo.astro';
import Team from '~/components/sections/Team.astro';
import { booking, locations, formatAddress } from '~/data/site';
import { pages } from '~/data/copy/pages';
import { copyOrNull, realOnly } from '~/lib/copy';
import zespolPrzyLogo from '~/assets/photos/zespol-przy-logo.jpg';
import zalozycielka from '~/assets/photos/zalozycielka-portret.jpg';

/**
 * Układ wg makiety zaakceptowanej 19.08.2026, przełożony na nasz system:
 * nagłówek trzyma wspólny wzorzec podstron (okruszki, nadtytuł, tytuł, kreska),
 * kadr stoi obok tekstu, a rolę ikon pełni symbol-kropla — makieta miała sześć
 * różnych piktogramów i botaniczne ornamenty, czyli drugi język dekoracyjny
 * obok tego, który brief §8 wybrał zamiast biblioteki ikon.
 *
 * Blok o historii marki NIE jest cytatem. Materiał od klientki (odpowiedź 54)
 * to streszczenie maila, nie jej zdania — w makiecie stał w cudzysłowie
 * z podpisem, czyli jako słowa, których nigdy nie wypowiedziała.
 */
const t = pages.about;
const lead = copyOrNull(t.lead);
const story = copyOrNull(t.manifesto.body);
const values = realOnly(t.values.items, (item) => item.body);
const cards = [t.spaces, t.community];
---

<Base title={t.meta.title} description={t.meta.description}>
  <Section as="div" size="md" class="intro">
    <div class="intro__grid">
      <div class="intro__text">
        <Breadcrumbs items={[{ label: 'O nas', href: '/o-nas' }]} />
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="page-header__title">{t.title}</h1>
        <span class="page-header__rule" aria-hidden="true"></span>
        {lead ? <p class="lead page-header__lead">{lead}</p> : <Todo label={t.lead} block />}
      </div>

      <figure class="intro__figure">
        <Image
          src={zespolPrzyLogo}
          alt="Cztery kobiety z zespołu TAK MI MOVE z uniesionymi rękami przy podświetlanym logo studia"
          widths={[520, 780, 1100]}
          sizes="(min-width: 60rem) 46vw, 100vw"
          loading="eager"
          class="intro__image"
        />
        <figcaption class="intro__card">
          <span class="intro__cardLabel">{t.heroCard.label}</span>
          <span class="intro__cardLine">{t.heroCard.line}</span>
        </figcaption>
      </figure>
    </div>
  </Section>

  <Section size="lg">
    <div class="mid">
      <article class="story">
        <figure class="story__figure">
          <Image
            src={zalozycielka}
            alt="Założycielka TAK MI MOVE siedzi na blacie recepcji pod logo studia"
            widths={[280, 420, 560]}
            sizes="(min-width: 60rem) 18vw, 40vw"
            class="story__portrait"
          />
          <figcaption class="story__caption">{t.manifesto.caption}</figcaption>
        </figure>

        <div class="story__text">
          <h2 class="story__title">{t.manifesto.title}</h2>
          {story ? <p class="story__body">{story}</p> : <Todo label={t.manifesto.body} block />}
          <Todo label={t.manifesto.ownWords} block />
        </div>
      </article>

      <section class="values">
        <p class="values__motto">{t.values.motto}</p>
        <h2 class="values__title">{t.values.title}</h2>
        <ul class="values__list">
          {
            values.map((value) => (
              <li class="value">
                <span class="value__badge" aria-hidden="true">
                  <Mark size="1.35rem" />
                </span>
                <div>
                  <h3 class="value__title">{value.title}</h3>
                  <p class="value__body">{value.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </Section>

  <Section size="md">
    <div class="cards">
      {
        cards.map((card) => {
          const body = copyOrNull(card.body);
          return (
            <article class="card">
              <span class="card__badge" aria-hidden="true">
                <Mark size="1.35rem" />
              </span>
              <div>
                <h2 class="card__title">{card.title}</h2>
                {body ? <p class="card__body">{body}</p> : <Todo label={card.body} block />}
              </div>
            </article>
          );
        })
      }
    </div>
  </Section>

  <Section size="md" tone="alt">
    <div class="places">
      <h2 class="places__title">{t.locationsTitle}</h2>
      <ul class="places__list">
        {
          locations.map((location) => (
            <li class="place">
              <a href={`/studia/${location.slug}`} data-event="studio_location_select">
                <strong>{location.city}</strong>
                <span>{formatAddress(location)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Team />

  <Section size="md" tone="soft">
    <div class="cta">
      <h2>{t.ctaTitle}</h2>
      <Button
        href={booking.frontOfficeUrl}
        newTab={booking.newTab}
        size="lg"
        source="final"
        event="booking_cta_click"
      >
        {booking.label}
      </Button>
    </div>
  </Section>
</Base>

<style>
  /* ————————————————————————— nagłówek ————————————————————————— */

  .intro__grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .intro__figure {
    margin: 0;
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .intro__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    aspect-ratio: 3 / 2;
    /* Kobiety siedzą w dolnych dwóch trzecich kadru. */
    object-position: 50% 62%;
  }

  /* Podpis leży na zdjęciu, więc tło musi być kryjące — półprzezroczysta
     płytka nad fotografią daje kontrast zależny od tego, co pod nią wypadnie. */
  .intro__card {
    position: absolute;
    inset-inline: var(--space-md);
    bottom: var(--space-md);
    background: var(--surface);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    display: grid;
    gap: 0.15em;
  }

  .intro__cardLabel {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
  }

  .intro__cardLine {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* ——————————————————— historia + wartości ——————————————————— */

  .mid {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
  }

  .story {
    background: var(--surface-alt);
    border-radius: var(--radius-card);
    padding: var(--space-md);
    display: grid;
    gap: var(--space-md);
    align-items: start;
  }

  .story__figure {
    margin: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .story__portrait {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    /* Twarz siedzi w górnej trzeciej kadru — przy przycinaniu pionu
       trzymamy górę, żeby nie uciąć głowy. */
    object-position: 50% 22%;
    border-radius: var(--radius-md);
  }

  /* Podpis opisuje portret, a nie akapit obok — stąd stoi pod zdjęciem,
     a nie pod tekstem, gdzie czytałby się jak podpis pod cytatem. */
  .story__caption {
    font-size: var(--fs-caption);
    color: var(--text-muted);
    line-height: 1.4;
  }

  .story__text {
    display: grid;
    gap: var(--space-sm);
  }

  .story__title {
    font-size: var(--fs-h3);
  }

  .story__body {
    max-width: var(--measure);
  }

  .values__motto {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    color: var(--text-accent);
    letter-spacing: 0.08em;
    margin-block-end: var(--space-3xs);
  }

  .values__title {
    font-size: var(--fs-h3);
    margin-block-end: var(--space-lg);
  }

  .values__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .value,
  .card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm);
    align-items: start;
    background: var(--surface-alt);
    border-radius: var(--radius-card);
    padding: var(--space-md);
  }

  .value__badge,
  .card__badge {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-pill);
    background: var(--surface-soft);
    color: var(--accent-strong);
  }

  .value__title {
    font-size: var(--fs-h4);
    margin-block-end: var(--space-3xs);
  }

  .value__body,
  .card__body {
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: var(--measure);
  }

  /* ————————————————— dwie karty pod spodem ————————————————— */

  .cards {
    display: grid;
    gap: var(--space-md);
  }

  .card__title {
    font-size: var(--fs-h4);
    margin-block-end: var(--space-3xs);
  }

  /* ————————————————————————— lokalizacje ————————————————————————— */

  .places {
    display: grid;
    gap: var(--space-md);
    align-items: center;
  }

  .places__title {
    font-size: var(--fs-h3);
  }

  .places__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .place a {
    display: grid;
    gap: 0.2em;
    padding-block: var(--space-2xs);
    color: inherit;
    text-decoration: none;
  }

  .place strong {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: 400;
  }

  .place span {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .place a:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .cta {
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  @media (min-width: 40rem) {
    /* Portret dostaje stałą kolumnę, nie ułamek — przy proporcji `fr`
       karta historii (najwęższa kolumna układu) ściskała go do ~90 px. */
    .story {
      grid-template-columns: minmax(6.5rem, 8.5rem) minmax(0, 1fr);
      gap: var(--space-md);
      /* Zdjęcie ciągnie się na całą wysokość karty, tak jak na makiecie —
         przy `start` pod portretem zostawała pusta jedna trzecia kolumny. */
      align-items: stretch;
    }

    .story__figure {
      grid-template-rows: minmax(0, 1fr) auto;
    }

    /* Wysokość bierze się z sąsiedniej kolumny, więc proporcja musi ustąpić —
       `aspect-ratio` przy `block-size: 100%` jest po cichu ignorowane. */
    .story__portrait {
      block-size: 100%;
      aspect-ratio: auto;
      min-block-size: 0;
    }

    .cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .places {
      grid-template-columns: auto 1fr;
      gap: var(--space-xl);
    }

    .places__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (min-width: 60rem) {
    .intro__grid {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-2xl);
    }

    .mid {
      grid-template-columns: 1fr 1.35fr;
      gap: var(--space-lg);
    }

    .values__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
