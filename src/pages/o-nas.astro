---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import Todo from '~/components/ui/Todo.astro';
import Team from '~/components/sections/Team.astro';
import { booking, locations, formatAddress } from '~/data/site';
import { pages } from '~/data/copy/pages';
import { copyOrNull, realOnly } from '~/lib/copy';
import zespolGrupa from '~/assets/photos/zespol-grupa.jpg';

/**
 * Brief §17: „Nie należy tworzyć historii marki bez materiału od właścicielki”.
 * Materiał przyszedł 19.08.2026 (odpowiedzi 53–56), więc opis marki, historia,
 * wartości i wydarzenia są już treścią, a nie samą strukturą. Mechanizm
 * `TODO(` zostaje na miejscu — gdyby któryś blok wrócił do stanu bez danych,
 * w produkcji ma zniknąć, a nie pokazać pusty nagłówek.
 */
const t = pages.about;
const lead = copyOrNull(t.lead);

const story = copyOrNull(t.manifesto.body);
/** Wartości renderujemy tylko wtedy, gdy mamy czym je wypełnić. */
const values = realOnly(t.values.items, (item) => item.body);
const blocks = [t.spaces, t.community];
---

<Base title={t.meta.title} description={t.meta.description}>
  <PageHeader
    eyebrow={t.eyebrow}
    title={t.title}
    lead={lead ?? undefined}
    crumbs={[{ label: 'O nas', href: '/o-nas' }]}
  />

  {!lead && <Section as="div" size="sm"><Todo label={t.lead} block /></Section>}

  <Section as="div" size="sm" bleed>
    <div class="container">
      <figure class="about__figure">
        <Image
          src={zespolGrupa}
          alt="Zespół instruktorek TAK MI MOVE w jasnym wnętrzu studia"
          widths={[640, 1000, 1440]}
          sizes="100vw"
          class="about__image"
        />
      </figure>
    </div>
  </Section>

  <Section size="lg">
    <section class="about__story">
      <h2>{t.manifesto.title}</h2>
      {story ? <p>{story}</p> : <Todo label={t.manifesto.body} block />}
    </section>
  </Section>

  {
    values.length > 0 && (
      <Section size="md" tone="alt">
        <div class="about__values">
          <header class="about__values-head">
            <p class="about__motto">{t.values.motto}</p>
            <h2>{t.values.title}</h2>
          </header>
          <ul class="about__value-list">
            {values.map((value) => (
              <li>
                <h3>{value.title}</h3>
                <p>{value.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )
  }

  <Section size="lg">
    <div class="about__blocks">
      {
        blocks.map((block) => {
          const body = copyOrNull(block.body);
          return (
            <section class="about__block">
              <h2>{block.title}</h2>
              {body ? <p>{body}</p> : <Todo label={block.body} block />}
            </section>
          );
        })
      }
    </div>
  </Section>

  <Section size="md" tone="alt">
    <h2 class="about__heading">Gdzie nas znajdziesz</h2>
    <ul class="about__studios">
      {
        locations.map((location) => (
          <li>
            <a href={`/studia/${location.slug}`} data-event="studio_location_select">
              <strong>{location.city}</strong>
              <span>{formatAddress(location)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Team />

  <Section size="md" tone="soft">
    <div class="about__cta">
      <h2>Przyjdź na pierwsze zajęcia</h2>
      <Button
        href={booking.frontOfficeUrl}
        newTab={booking.newTab}
        size="lg"
        source="final"
        event="booking_cta_click"
      >
        {booking.label}
      </Button>
    </div>
  </Section>
</Base>

<style>
  .about__figure {
    margin: 0;
  }

  .about__image {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center 35%;
    border-radius: var(--radius-md);
  }

  /* Historia marki dostaje najszerszy oddech na stronie — to jedyny
     fragment, w którym studio mówi o sobie w pierwszej osobie. */
  .about__story {
    max-width: var(--measure);
  }

  .about__story h2 {
    font-size: var(--fs-h2);
    margin-block-end: var(--space-md);
  }

  .about__story p {
    font-size: var(--fs-lead);
    line-height: var(--lh-loose);
  }

  .about__values-head {
    margin-block-end: var(--space-lg);
  }

  /* Hasło marki, nie ozdobnik — dlatego font display i kolor akcentowy,
     a nie szara etykieta jak zwykły eyebrow. */
  .about__motto {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    color: var(--text-accent);
    letter-spacing: 0.08em;
    margin-block-end: var(--space-2xs);
  }

  .about__values-head h2 {
    font-size: var(--fs-h3);
  }

  .about__value-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }

  .about__value-list li {
    padding-block-start: var(--space-sm);
    border-block-start: var(--hairline) solid var(--line-detail);
  }

  .about__value-list h3 {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: 400;
    margin-block-end: var(--space-2xs);
  }

  .about__value-list p {
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: var(--measure-narrow);
  }

  .about__blocks {
    display: grid;
    gap: var(--space-lg);
  }

  .about__block {
    padding-block-start: var(--space-md);
    border-block-start: var(--hairline) solid var(--line-strong);
  }

  .about__block h2 {
    font-size: var(--fs-h3);
    margin-block-end: var(--space-sm);
  }

  .about__block p {
    max-width: var(--measure);
  }

  .about__heading {
    font-size: var(--fs-h3);
    margin-block-end: var(--space-md);
  }

  .about__studios {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-sm);
  }

  .about__studios a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2em var(--space-sm);
    padding-block: var(--space-2xs);
    color: inherit;
    text-decoration: none;
  }

  .about__studios strong {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: 400;
  }

  .about__studios span {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .about__studios a:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .about__cta {
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  @media (min-width: 40rem) {
    .about__value-list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg) var(--space-xl);
    }
  }

  @media (min-width: 60rem) {
    .about__blocks {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl) var(--space-2xl);
    }

    .about__values {
      display: grid;
      grid-template-columns: minmax(14rem, 1fr) 2fr;
      gap: var(--space-2xl);
      align-items: start;
    }

    .about__values-head {
      margin-block-end: 0;
      position: sticky;
      /* Nagłówek strony jest `sticky`, więc hasło musi zatrzymać się pod nim. */
      top: calc(var(--header-h) + var(--space-lg));
    }
  }
</style>
