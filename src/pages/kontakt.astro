---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import Mark from '~/components/ui/Mark.astro';
import MapEmbed from '~/components/ui/MapEmbed.astro';
import SocialIcon from '~/components/ui/SocialIcon.astro';
import { locations, formatAddress, site, booking } from '~/data/site';
import { pages } from '~/data/copy/pages';

/**
 * Brief §19. Najważniejsze zadanie tej strony: rozdzielić sprawy, które
 * obsługuje Fitssey, od tych, które trafiają bezpośrednio do studia.
 * Formularz nie zastępuje rezerwacji.
 */
const t = pages.contact;
---

<Base title={t.meta.title} description={t.meta.description}>
  <PageHeader
    eyebrow={t.eyebrow}
    title={t.title}
    lead={t.lead}
    crumbs={[{ label: 'Kontakt', href: '/kontakt' }]}
  />

  <Section size="md">
    <div class="routes">
      <section class="route">
        <div class="route__head">
          <Mark size="1.1rem" class="route__mark" />
          <h2>{t.whenFitssey.title}</h2>
        </div>
        <ul class="route__list">
          {t.whenFitssey.items.map((item) => <li>{item}</li>)}
        </ul>
        <div class="route__foot">
          <Button
            href={booking.frontOfficeUrl}
            newTab={booking.newTab}
            variant="secondary"
            source="footer"
            event="booking_cta_click"
          >
            Otwórz system rezerwacji
          </Button>
        </div>
      </section>

      <section class="route">
        <div class="route__head">
          <Mark size="1.1rem" class="route__mark" />
          <h2>{t.whenDirect.title}</h2>
        </div>
        <ul class="route__list">
          {t.whenDirect.items.map((item) => <li>{item}</li>)}
        </ul>
        <div class="route__foot route__direct">
          <a href={`tel:${site.phone}`} data-event="phone_click">{site.phoneDisplay}</a>
          <a href={`mailto:${site.email}`} data-event="email_click">{site.email}</a>
        </div>
      </section>
    </div>
  </Section>

  <Section size="lg" tone="alt">
    <h2 class="contact__heading">Studia</h2>
    <div class="contact__studios">
      {
        locations.map((location) => (
          <article class="contact-studio">
            <div class="contact-studio__head">
              <Mark size="0.85rem" class="contact-studio__mark" />
              <h3>{location.city}</h3>
            </div>

            <address class="contact-studio__address">
              {formatAddress(location)}
              <br />
              <a href={`tel:${site.phone}`} data-event="phone_click">{site.phoneDisplay}</a>
              <br />
              <a href={`mailto:${location.email}`} data-event="email_click">{location.email}</a>
            </address>

            {/* Sam znak platformy zamiast nazwy profilu. Nazwa zostaje
                w `aria-label`, żeby czytnik ekranu ogłosił, dokąd prowadzi
                odsyłacz — bez tego mówiłby tylko „link". */}
            <ul class="contact-studio__social">
              {location.social.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener me"
                    aria-label={`${s.platform === 'instagram' ? 'Instagram' : 'Facebook'}: ${s.label}`}
                    title={s.label}
                  >
                    <SocialIcon platform={s.platform} />
                  </a>
                </li>
              ))}
            </ul>

            <MapEmbed address={formatAddress(location)} label={`TAK MI MOVE ${location.city}`} />

            <p class="contact-studio__more">
              <a href={`/studia/${location.slug}`}>Dojazd, wejście i parking</a>
            </p>
          </article>
        ))
      }
    </div>
  </Section>

  {/* Formularza tu nie ma i nie będzie — decyzja z 20.08.2026. Kontakt idzie
      telefonem i mailem, oba wprost na stronie i klikalne. Formularz stał
      zbudowany, ale wyłączony brakiem endpointu; czekanie na usługę wysyłkową
      i osobę, która miałaby go obsługiwać, przestało mieć sens. */}
</Base>

<style>
  .routes {
    display: grid;
    gap: var(--space-lg);
  }

  /* Kafle zamiast dwóch kolumn oddzielonych kreską u góry. `align-content`
     rozpycha zawartość tak, żeby stopka kafla — przycisk i dane kontaktowe —
     siadała u dołu niezależnie od tego, że jedna lista ma cztery pozycje,
     a druga pięć. Bez tego przycisk wisiał wyżej niż telefon obok. */
  .route {
    display: grid;
    align-content: start;
    background: var(--surface);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-card);
    padding: var(--space-lg);
  }

  .route__head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-sm);
  }

  .route__head :global(.route__mark) {
    color: var(--accent);
  }

  .route h2 {
    font-size: var(--fs-h3);
  }

  /* Kropla jako punktor — ten sam znak co przy nagłówku kafla, tylko mniejszy.
     `list-style` zdjęty, bo domyślna kropka rysowałaby się obok. */
  .route__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .route__list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .route__list li::before {
    content: '';
    inline-size: 0.3rem;
    block-size: 0.3rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    flex: none;
    translate: 0 -0.15em;
  }

  .route__foot {
    margin-block-start: var(--space-lg);
  }

  .route__direct {
    display: grid;
    gap: var(--space-3xs);
  }

  /* Telefon i mail są od 20.08.2026 jedynym kanałem kontaktu — formularza
     nie ma. Dlatego dostają pełne pole dotyku 44 px, tak jak w stopce.
     Wcześniej miały 34 i 29 px, czyli poniżej progu wygodnego kliknięcia
     na telefonie, a stamtąd idzie większość ruchu. */
  .route__direct a {
    color: var(--text-accent);
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    width: fit-content;
  }

  .contact__heading {
    font-size: var(--fs-h2);
    margin-block-end: var(--space-lg);
  }

  .contact__studios {
    display: grid;
    gap: var(--space-xl);
  }

  .contact-studio__head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-sm);
  }

  .contact-studio__head :global(.contact-studio__mark) {
    color: var(--accent);
  }

  .contact-studio__head h3 {
    font-size: var(--fs-h3);
  }

  .contact-studio__address {
    font-style: normal;
    font-size: var(--fs-small);
    line-height: var(--lh-loose);
  }

  .contact-studio__address a {
    color: var(--text-accent);
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
  }

  .contact-studio__social {
    list-style: none;
    padding: 0;
    margin-block: var(--space-sm) var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  /* Okrągły przycisk 44 px — sam znak platformy, nazwa profilu siedzi
     w `aria-label` i w dymku. */
  .contact-studio__social a {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: var(--radius-pill);
    border: var(--hairline) solid var(--line-strong);
    color: var(--text-accent);
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .contact-studio__social a:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  .contact-studio__more {
    margin-block-start: var(--space-sm);
    font-size: var(--fs-small);
  }

  .contact-studio__more a {
    color: var(--text-accent);
    padding-block: 0.25rem;
  }

  @media (min-width: 48rem) {
    .routes,
    .contact__studios {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
