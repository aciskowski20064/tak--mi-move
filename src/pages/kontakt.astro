---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import Mark from '~/components/ui/Mark.astro';
import MapEmbed from '~/components/ui/MapEmbed.astro';
import { locations, formatAddress, site, booking } from '~/data/site';
import { pages } from '~/data/copy/pages';
import { home } from '~/data/copy/home';
import { typo } from '~/lib/typografia';

/**
 * Brief §19. Najważniejsze zadanie tej strony: rozdzielić sprawy, które
 * obsługuje Fitssey, od tych, które trafiają bezpośrednio do studia.
 * Formularz nie zastępuje rezerwacji.
 */
const t = pages.contact;

/**
 * Etykiety wyjść do studiów bierzemy z tego samego miejsca, co strona główna
 * i `/studia`. Klientka poprosiła 25.08.2026 o „Poznaj przestrzeń" w miejsce
 * „Poznaj studio" i „Dojazd i szczegóły"; `/kontakt` trzymał trzecią wersję
 * nazwy tego samego przejścia („Dojazd, wejście i parking") i to ona znika.
 *
 * Import danych, nie komponentu — strona główna nie wie o tym użyciu.
 * Ta sama ścieżka co w `studia/index.astro`.
 */
const wyjscia = home.studios;
---

<Base title={t.meta.title} description={t.meta.description}>
  {/* `size="sm"` zamiast domyślnego `md` — ten sam prop, którym skrócone są
      nagłówki podstron studiów. Przy tytule z jednego słowa domyślny rytm
      dawał 475 px wysokości samego wejścia w treść. */}
  <PageHeader
    size="sm"
    title={t.title}
    leadLines={t.leadLines}
    crumbs={[{ label: 'Kontakt', href: '/kontakt' }]}
  />

  <Section size="md" class="drogi-sekcja">
    <div class="routes">
      <section class="route">
        <div class="route__head">
          <Mark size="1.1rem" class="route__mark" />
          <h2>{typo(t.whenFitssey.title)}</h2>
        </div>
        <ul class="route__list">
          {t.whenFitssey.items.map((item) => <li>{typo(item)}</li>)}
        </ul>
        <div class="route__foot">
          <Button
            href={booking.frontOfficeUrl}
            newTab={booking.newTab}
            variant="secondary"
            source="footer"
            event="booking_cta_click"
          >
            {typo(t.whenFitssey.cta)}
          </Button>
        </div>
      </section>

      <section class="route">
        <div class="route__head">
          <Mark size="1.1rem" class="route__mark" />
          <h2>{typo(t.whenDirect.title)}</h2>
        </div>
        <ul class="route__list">
          {t.whenDirect.items.map((item) => <li>{typo(item)}</li>)}
        </ul>
        <div class="route__foot route__direct">
          <a href={`tel:${site.phone}`} data-event="phone_click">{site.phoneDisplay}</a>
          <a href={`mailto:${site.email}`} data-event="email_click">{site.email}</a>
        </div>
      </section>
    </div>
  </Section>

  {/* ————————————————— lokalizacje —————————————————

      Karta lokalizacji pokazuje wyłącznie to, czego potrzeba, żeby wybrać
      studio i do niego trafić: nazwę, adres, mapę i dwa wyjścia.

      Telefon, e-mail, Instagram i Facebook stąd znikają. Nie dlatego, że są
      niepotrzebne — dlatego, że komplet tych samych danych dla obu studiów
      stoi w stopce, która na tej podstronie zaczynała się 128 px niżej.
      Ta sama informacja dwa razy na jednym ekranie nie jest ułatwieniem,
      tylko szumem. Telefon i mail zostają wyżej, w kafelku „Kiedy
      bezpośrednio do nas", czyli tam, gdzie strona sama je poleca. */}
  <Section size="md" tone="alt">
    <h2 class="contact__heading">{typo(t.studiosTitle)}</h2>
    <div class="contact__studios">
      {
        locations.map((location) => (
          <article class="studio">
            <div class="studio__head">
              <Mark size="0.85rem" class="studio__mark" />
              <h3>{location.city}</h3>
            </div>

            <p class="studio__adres">{typo(formatAddress(location))}</p>

            {/* Adres idzie do mapy SUROWY: `typo()` wstawiłoby twardą spację
                do zapytania Google i do dostępnej nazwy ramki. */}
            <MapEmbed address={formatAddress(location)} label={`TAK MI MOVE ${location.city}`} />

            {/* Osobne nazwy dostępne, bo „Poznaj przestrzeń" powtórzone dwa
                razy na jednej stronie nic nie mówi w liście odsyłaczy.
                Bez `typo()` — to nazwa dla czytnika ekranu, nie skład. */}
            <p class="studio__wyjscia">
              <a
                class="link-cta"
                href={`/studia/${location.slug}`}
                aria-label={`${wyjscia.linkLabel} — ${location.city}`}
                data-event="studio_location_select"
              >
                {typo(wyjscia.linkLabel)}
              </a>
              <a
                class="link-cta"
                href={`/grafik?studio=${location.slug}`}
                aria-label={`${wyjscia.scheduleLabel} — ${location.city}`}
                data-event="schedule_page_view"
              >
                {typo(wyjscia.scheduleLabel)}
              </a>
            </p>
          </article>
        ))
      }
    </div>
  </Section>

  {/* Formularza tu nie ma i nie będzie — decyzja z 20.08.2026. Kontakt idzie
      telefonem i mailem, oba wprost na stronie i klikalne. Formularz stał
      zbudowany, ale wyłączony brakiem endpointu; czekanie na usługę wysyłkową
      i osobę, która miałaby go obsługiwać, przestało mieć sens. */}
</Base>

<style>
  /* Lead jako dwa akapity: miara węższa i wiersz ciaśniejszy niż globalne
     46ch przy 1.85. Przy takim rozstrzale dwa krótkie zdania czytały się
     jak cztery luźne wiersze bez związku; 40ch i 1.55 wiąże każde zdanie
     w blok, a odstęp między nimi robi za interpunkcję.

     Reguły są globalne, bo element nosi scope komponentu PageHeader — ale
     arkusz tej strony linkuje wyłącznie /kontakt, więc leady pozostałych
     podstron zostają na wartościach z base.css. Ta sama ścieżka co na
     /studia, gdzie lead dostał 40ch. */
  :global(.page-header__lead) {
    max-width: 40ch;
    line-height: 1.55;
  }

  /* Odstęp między zdaniami — mniejszy niż wysokość wiersza, żeby akapity
     czytały się jako jedno wejście w treść, a nie dwa osobne bloki. */
  :global(.page-header__lead + .page-header__lead) {
    margin-block-start: var(--space-xs);
  }

  /* Nagłówek ma własny `padding-block-end` i nie przyjmuje klasy, więc górę
     tej sekcji zerujemy i dokładamy ujemny margines — ten sam zabieg co na
     podstronach studiów i zajęć. Bezpieczny wyłącznie dlatego, że nagłówek
     i ta sekcja stoją na tonie `default`, czyli na tym samym `--surface`:
     nie ma szwu do odsłonięcia. Przy tonie `alt` zostałby pasek.

     :global, bo klasa przekazana propem trafia na korzeń komponentu Section
     i nosi JEGO scope. */
  :global(.section.drogi-sekcja) {
    padding-block-start: 0;
    margin-block-start: calc(var(--space-sm) * -1.5);
  }

  .routes {
    display: grid;
    gap: var(--space-lg);
  }

  /* TRZY WIERSZE: nagłówek, lista, stopka. `1fr` na środkowym oddaje mu całą
     nadwyżkę wysokości, więc stopka — przycisk w jednym kafelku, telefon
     i mail w drugim — siada przy dolnej krawędzi obu kart.

     Bez tego oba kafle i tak miały równą wysokość (siatka rozciąga je do
     najwyższego), ale treść stała u góry i pod przyciskiem „Otwórz system
     rezerwacji" zostawało 83 px pustki. Poprzedni komentarz w tym miejscu
     przypisywał dosunięcie stopki regule `align-content: start`, która robi
     dokładnie odwrotnie — dlatego reguła znika, a nie tylko jej opis. */
  .route {
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: var(--surface);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-card);
    padding: var(--space-lg);
  }

  .route__head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-sm);
  }

  .route__head :global(.route__mark) {
    color: var(--accent);
  }

  .route h2 {
    font-size: var(--fs-h3);
  }

  /* Kropla jako punktor — ten sam znak co przy nagłówku kafla, tylko mniejszy.
     `list-style` zdjęty, bo domyślna kropka rysowałaby się obok.

     `align-self: start` trzyma pozycje przy nagłówku: bez tego rozciągnięty
     wiersz rozsunąłby odstępy między nimi. */
  .route__list {
    align-self: start;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .route__list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .route__list li::before {
    content: '';
    inline-size: 0.3rem;
    block-size: 0.3rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    flex: none;
    translate: 0 -0.15em;
  }

  /* Minimalny odstęp od listy. Nadwyżkę rozdziela wiersz `1fr` wyżej. */
  .route__foot {
    margin-block-start: var(--space-lg);
  }

  .route__direct {
    display: grid;
    gap: var(--space-3xs);
  }

  /* Telefon i mail są od 20.08.2026 jedynym kanałem kontaktu — formularza
     nie ma. Dlatego dostają pełne pole dotyku 44 px, tak jak w stopce.
     Wcześniej miały 34 i 29 px, czyli poniżej progu wygodnego kliknięcia
     na telefonie, a stamtąd idzie większość ruchu. */
  .route__direct a {
    color: var(--text-accent);
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    width: fit-content;
  }

  .contact__heading {
    font-size: var(--fs-h2);
    margin-block-end: var(--space-lg);
  }

  .contact__studios {
    display: grid;
    gap: var(--space-xl);
  }

  /* Bez obwódki i bez wypełnienia. Lokalizacji nie trzeba przed niczym
     zamykać — rozdziela je mapa, największy element wizualny w tej sekcji,
     i odstęp między kolumnami. Ten sam kierunek co panele studiów z Etapu 5:
     kadr prowadzi, treść przy nim jest lekka. */
  .studio__head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .studio__head h3 {
    font-size: var(--fs-h3);
  }

  .studio__adres {
    margin-block: var(--space-3xs) var(--space-sm);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .studio__wyjscia {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin-block-start: var(--space-sm);
    font-size: var(--fs-small);
  }

  @media (min-width: 48rem) {
    .routes,
    .contact__studios {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
