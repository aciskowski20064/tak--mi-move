---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import Mark from '~/components/ui/Mark.astro';
import MapEmbed from '~/components/ui/MapEmbed.astro';
import Faq from '~/components/sections/Faq.astro';
import { locations, formatAddress, booking, site } from '~/data/site';
import { home } from '~/data/copy/home';
import { copyOrNull } from '~/lib/copy';
import FactIcon from '~/components/ui/FactIcon.astro';
import SocialIcon from '~/components/ui/SocialIcon.astro';

import pruszczPoczekalnia from '~/assets/photos/pruszcz-poczekalnia.jpg';
import pruszczSala from '~/assets/photos/pruszcz-sala-hamaki.jpg';
import pruszczAerial from '~/assets/photos/pruszcz-aerial.jpg';
import pruszczSprzet from '~/assets/photos/pruszcz-sprzet.jpg';
import pruszczSzatnia from '~/assets/photos/pruszcz-szatnia.jpg';

/**
 * Kadry sesji przypisane do lokalizacji. Gdańska tu jeszcze nie ma — hero
 * i galeria po prostu się nie renderują, a strona zostaje kompletna bez nich.
 *
 * Galeria nie jest ozdobą: cztery kadry odpowiadają na cztery różne pytania
 * osoby, która nigdy tu nie była — jak wygląda sala, jak wyglądają zajęcia,
 * czy trzeba coś przynosić, gdzie się przebrać.
 */
const kadryStudiow: Record<string, { hero: ImageMetadata; galeria: { plik: ImageMetadata; opis: string }[] }> = {
  'pruszcz-gdanski': {
    hero: pruszczPoczekalnia,
    galeria: [
      { plik: pruszczSala, opis: 'Sala z hamakami do aerial yogi i łukiem w kolorze terakoty' },
      { plik: pruszczAerial, opis: 'Zajęcia aerial yogi — ćwiczące w hamakach' },
      { plik: pruszczSprzet, opis: 'Regał ze sprzętem: klocki, piłki, wałki, koce i bolstery' },
      { plik: pruszczSzatnia, opis: 'Szatnia z ławkami i przejściem do prysznica' },
    ],
  },
};

/**
 * Podstrona pojedynczego studia (brief §16).
 *
 * §16.4 zabrania stron typu doorway — czyli kopii z podmienioną nazwą miasta.
 * Dlatego cała treść lokalna (wejście, parking, dojazd, dostępność, opis)
 * pochodzi z danych konkretnej lokalizacji i dopóki jej nie ma, po prostu
 * się nie renderuje. Żadna z tych sekcji nie ma treści domyślnej.
 */
export function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;

const classes = await getCollection('classes', ({ data }) => import.meta.env.DEV || !data.draft);
const available = classes
  .filter((entry) => entry.data.locationSlugs.includes(location.slug))
  .sort((a, b) => a.data.order - b.data.order);

const description = copyOrNull(home.studios.descriptions[location.slug]);
const address = formatAddress(location);
const kadry = kadryStudiow[location.slug];

/**
 * Praktyczne informacje lokalne — każda osobno, bo każdej może brakować.
 *
 * Dojazdu komunikacją i dostępności tu nie ma i nie będzie: na oba pytania
 * klientka odpowiedziała „nie opisujemy" (odpowiedzi 35 i 36). To decyzja,
 * nie brak danych, więc wiersze zniknęły, zamiast wisieć jako prośba o coś,
 * co już odrzuciła.
 */
const fakty = [
  { ikona: 'pin' as const, label: 'Lokalizacja', value: address },
  { ikona: 'door' as const, label: 'Wejście', value: location.entranceInfo },
  { ikona: 'locker' as const, label: 'Parking', value: location.parkingInfo },
  {
    ikona: 'locker' as const,
    label: 'Szatnia',
    // FAKT: odpowiedzi 10 i 50 — to samo wyposażenie w obu studiach.
    value: 'Prysznic, ręczniki i kosmetyki na miejscu',
  },
  {
    ikona: 'move' as const,
    label: 'Zajęcia',
    // FAKT: przypisanie zajęć do lokalizacji z `classSlugs`.
    value: available.map((entry) => entry.data.name).join(', '),
  },
]
  /* Fakt bez wartości znika w całości, razem z etykietą i piktogramem.
     Parkingu w Pruszczu po prostu nie znamy (odpowiedź 34 go nie rozstrzyga),
     więc ta karta tam się nie pojawia. */
  .filter((f) => f.value);

const title = `${location.city} — studio jogi, pilatesu i aerial yogi`;
const metaDescription = `TAK MI MOVE ${location.city}, ${address}. Joga, pilates, stretching i aerial yoga w kameralnych grupach. Zapisy online.`;
---

<Base title={title} description={metaDescription}>
  <PageHeader
    eyebrow="Studio"
    title={location.city}
    crumbs={[
      { label: 'Studia', href: '/studia' },
      { label: location.city, href: `/studia/${location.slug}` },
    ]}
  />

  <Section as="div" size="sm">
    <div class="studio__top">
      <ul class="fakty">
        {
          fakty.map((f) => (
            <li class="fakt">
              <span class="fakt__ikona" aria-hidden="true">
                <FactIcon name={f.ikona} />
              </span>
              <h2 class="fakt__label">{f.label}</h2>
              <p class="fakt__tekst">{f.value}</p>
            </li>
          ))
        }
      </ul>

      {
        kadry && (
          <figure class="studio__hero">
            <Image
              src={kadry.hero}
              alt={`Poczekalnia studia TAK MI MOVE w ${location.city}`}
              widths={[600, 900, 1400]}
              sizes="(min-width: 60rem) 46vw, 100vw"
              loading="eager"
              class="studio__heroFoto"
            />
          </figure>
        )
      }
    </div>
  </Section>

  {
    kadry && (
      <Section as="div" size="sm">
        <ul class="galeria">
          {kadry.galeria.map((k) => (
            <li>
              <Image
                src={k.plik}
                alt={k.opis}
                widths={[320, 480, 700]}
                sizes="(min-width: 48rem) 23vw, 45vw"
                loading="lazy"
                class="galeria__foto"
              />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section size="lg">
    <div class="studio__dol">
      {
        description && (
          <article class="karta karta--opis">
            <h2 class="karta__tytul">Ta przestrzeń</h2>
            <p class="karta__tekst">{description}</p>
          </article>
        )
      }

      <article class="karta karta--kontakt">
        <h2 class="karta__tytul">Dane kontaktowe</h2>
        <dl class="studio__contact">
          <dt>Telefon</dt>
          <dd><a href={`tel:${site.phone}`} data-event="phone_click">{site.phoneDisplay}</a></dd>
          <dt>E-mail</dt>
          <dd>
            <a href={`mailto:${location.email}`} data-event="email_click">{location.email}</a>
          </dd>
          <dt>Profile</dt>
          <dd class="studio__social">
            {location.social.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener me"
                aria-label={`${s.platform === 'instagram' ? 'Instagram' : 'Facebook'}: ${s.label}`}
                title={s.label}
              >
                <SocialIcon platform={s.platform} />
              </a>
            ))}
          </dd>
        </dl>

        <div class="karta__akcje">
          <Button
            href={`/grafik?studio=${location.slug}`}
            source="location"
            event="schedule_page_view"
          >
            Zobacz grafik i zapisz się
          </Button>
        </div>

        <MapEmbed address={address} label={`TAK MI MOVE ${location.city}`} />
      </article>
    </div>
  </Section>

  {
    available.length > 0 && (
      <Section size="lg">
        <h2 class="studio__heading">Zajęcia w tym studiu</h2>
        <ul class="studio__classes">
          {available.map((entry) => (
            <li>
              <a href={`/zajecia/${entry.id}`} data-event="class_detail_view">
                <Mark size="0.7rem" />
                {entry.data.name}
              </a>
            </li>
          ))}
        </ul>
        <p class="studio__note">
          Dostępność poszczególnych zajęć w tej lokalizacji wymaga potwierdzenia — sprawdź
          aktualny <a href={`/grafik?studio=${location.slug}`}>grafik</a>.
        </p>
      </Section>
    )
  }

  <Faq scope={location.slug} />
</Base>

<style>
  /* ————————————————— fakty praktyczne + kadr ————————————————— */

  .studio__top {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .fakty {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    /* 15 rem, nie 9 — przy niższym progu kolumna mieściła trzy fakty w rzędzie
       i czwarty zostawał sam w drugim wierszu. Teraz układ jest równy 2×2,
       a najdłuższy fakt („Joga, pilates, stretching, aerial yoga i barre")
       ma gdzie się zmieścić. */
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-lg) var(--space-md);
  }

  .fakt__ikona {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-pill);
    border: var(--hairline) solid var(--line-detail);
    color: var(--accent);
    margin-block-end: var(--space-sm);
  }

  .fakt__label {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: 400;
    margin-block-end: var(--space-3xs);
  }

  .fakt__tekst {
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: 1.55;
  }

  .studio__hero {
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .studio__heroFoto {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* ————————————————————— galeria ————————————————————— */

  /* Równy rząd, nie schodki i nie przewijany pas. Kadry są różnych proporcji
     (pion i poziom), więc wspólne `aspect-ratio` przycina je do jednej linii. */
  .galeria {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
  }

  .galeria__foto {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  /* ————————————————————— dwie karty ————————————————————— */

  .studio__dol {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
  }

  .karta {
    border-radius: var(--radius-card);
    padding: var(--space-lg);
  }

  .karta--opis {
    background: var(--surface-alt);
  }

  .karta--kontakt {
    background: var(--surface);
    border: var(--hairline) solid var(--line);
  }

  .karta__tytul {
    font-size: var(--fs-h3);
    margin-block-end: var(--space-sm);
  }

  .karta__tekst {
    max-width: var(--measure);
    line-height: var(--lh-loose);
  }

  .karta__akcje {
    margin-block: var(--space-lg);
  }

  .studio__contact {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2xs) var(--space-md);
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-md);
    border-block-start: var(--hairline) solid var(--line);
    font-size: var(--fs-small);
  }

  .studio__contact dt {
    color: var(--text-muted);
  }

  .studio__contact dd {
    margin: 0;
  }

  .studio__contact a {
    color: var(--text-accent);
    padding-block: 0.2rem;
  }

  .studio__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
  }

  .studio__heading {
    font-size: var(--fs-h2);
    margin-block-end: var(--space-md);
  }

  .studio__classes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
  }

  .studio__classes a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: 0.5em 1em;
    border: var(--hairline) solid var(--line-strong);
    border-radius: var(--radius-pill);
    color: var(--text);
    text-decoration: none;
    font-size: var(--fs-small);
    transition: background-color var(--dur) var(--ease);
  }

  .studio__classes a:hover {
    background: var(--surface-alt);
  }

  .studio__note {
    margin-block-start: var(--space-md);
    max-width: var(--measure);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .studio__note a {
    color: var(--text-accent);
  }

  @media (min-width: 48rem) {
    /* Cztery kadry w jednym rzędzie — układ z makiety. */
    .galeria {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 60rem) {
    .studio__top {
      grid-template-columns: 1fr minmax(20rem, 30rem);
      gap: var(--space-2xl);
    }

    /* Karta z opisem szersza od kontaktowej: opis to tekst ciągły, dane
       kontaktowe to krótkie wiersze i przycisk. */
    .studio__dol {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-lg);
    }
  }
</style>
