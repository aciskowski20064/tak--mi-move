---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import { locations, formatAddress, booking, site } from '~/data/site';
import { home } from '~/data/copy/home';
import { copyOrNull } from '~/lib/copy';
import FactIcon from '~/components/ui/FactIcon.astro';
import SocialIcon from '~/components/ui/SocialIcon.astro';

import pruszczPoczekalnia from '~/assets/photos/pruszcz-poczekalnia.jpg';
import pruszczSala from '~/assets/photos/pruszcz-sala-hamaki.jpg';
import pruszczAerial from '~/assets/photos/pruszcz-aerial.jpg';
import pruszczSprzet from '~/assets/photos/pruszcz-sprzet.jpg';
import pruszczSzatnia from '~/assets/photos/pruszcz-szatnia.jpg';

import gdanskPoczekalnia from '~/assets/photos/gdansk-poczekalnia.jpg';
import gdanskSala from '~/assets/photos/gdansk-sala.jpg';
import gdanskSprzet from '~/assets/photos/gdansk-sprzet.jpg';
import gdanskSzatnia from '~/assets/photos/gdansk-szatnia.jpg';
import gdanskRecepcja from '~/assets/photos/gdansk-recepcja.jpg';

/**
 * Kadry sesji przypisane do lokalizacji.
 *
 * Galeria nie jest ozdobą: każdy kadr odpowiada na inne pytanie osoby, która
 * nigdy tu nie była — jak wygląda sala, czy trzeba coś przynosić, gdzie się
 * przebrać. Oba studia trzymają ten sam schemat, żeby żadne nie wypadło
 * gorzej od drugiego przy tej samej liczbie zdjęć.
 *
 * Różnica jest jedna i wynika z materiału: w Pruszczu mamy kadr z zajęć
 * w hamakach, w Gdańsku takiego nie ma — jego miejsce zajmuje lada recepcji.
 */
const kadryStudiow: Record<string, { hero: ImageMetadata; galeria: { plik: ImageMetadata; opis: string }[] }> = {
  'pruszcz-gdanski': {
    hero: pruszczPoczekalnia,
    galeria: [
      { plik: pruszczSala, opis: 'Sala z hamakami do aerial yogi i łukiem w kolorze terakoty' },
      { plik: pruszczAerial, opis: 'Zajęcia aerial yogi — ćwiczące w hamakach' },
      { plik: pruszczSprzet, opis: 'Regał ze sprzętem: klocki, piłki, wałki, koce i bolstery' },
      { plik: pruszczSzatnia, opis: 'Szatnia z ławkami i przejściem do prysznica' },
    ],
  },
  gdansk: {
    hero: gdanskPoczekalnia,
    galeria: [
      { plik: gdanskSala, opis: 'Sala z betonową ścianą, złoconymi lustrami i podłogą w jodełkę' },
      { plik: gdanskSprzet, opis: 'Regał ze sprzętem: klocki, piłki, wałki i odważnik' },
      { plik: gdanskSzatnia, opis: 'Szatnia z ławką, mosiężnymi wieszakami i szafkami' },
      { plik: gdanskRecepcja, opis: 'Lada recepcji z dębu, z łukowym panelem na ścianie' },
    ],
  },
};

/**
 * Podstrona pojedynczego studia (brief §16).
 *
 * §16.4 zabrania stron typu doorway — czyli kopii z podmienioną nazwą miasta.
 * Dlatego cała treść lokalna (wejście, parking, dojazd, dostępność, opis)
 * pochodzi z danych konkretnej lokalizacji i dopóki jej nie ma, po prostu
 * się nie renderuje. Żadna z tych sekcji nie ma treści domyślnej.
 */
export function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;

const classes = await getCollection('classes', ({ data }) => import.meta.env.DEV || !data.draft);
const available = classes
  .filter((entry) => entry.data.locationSlugs.includes(location.slug))
  .sort((a, b) => a.data.order - b.data.order);

/**
 * Polszczyzna odmienia rzeczownik za liczebnikiem: dwa, trzy i cztery
 * „rodzaje", ale pięć i więcej „rodzajów". Pruszcz ma pięć zajęć, Gdańsk
 * cztery, więc obie formy realnie występują — sklejenie liczby z jednym
 * napisem dałoby błąd na jednej z podstron.
 */
function rodzajeRuchu(ile: number): string | undefined {
  if (ile === 0) return undefined;
  const slowa = ['', 'Jeden', 'Dwa', 'Trzy', 'Cztery', 'Pięć', 'Sześć'];
  const liczba = slowa[ile] ?? String(ile);
  if (ile === 1) return 'Jeden rodzaj ruchu';
  return `${liczba} ${ile < 5 ? 'rodzaje' : 'rodzajów'} ruchu`;
}

const description = copyOrNull(home.studios.descriptions[location.slug]);
const descriptionTitle = home.studios.descriptionTitles[location.slug];
const address = formatAddress(location);
const kadry = kadryStudiow[location.slug];

/**
 * Praktyczne informacje lokalne — każda osobno, bo każdej może brakować.
 *
 * Dojazdu komunikacją i dostępności tu nie ma i nie będzie: na oba pytania
 * klientka odpowiedziała „nie opisujemy" (odpowiedzi 35 i 36). To decyzja,
 * nie brak danych, więc wiersze zniknęły, zamiast wisieć jako prośba o coś,
 * co już odrzuciła.
 */
const fakty = [
  /* Adres łamany po ulicy, tak jak na makiecie — jednym ciągiem zawijał się
     na trzy wiersze i rozpychał rząd faktów. */
  {
    ikona: 'pin' as const,
    label: 'Lokalizacja',
    value: location.street,
    drugaLinia: `${location.postalCode} ${location.city}`,
  },
  { ikona: 'door' as const, label: 'Wejście', value: location.entranceInfo },
  { ikona: 'locker' as const, label: 'Parking', value: location.parkingInfo },
  {
    ikona: 'locker' as const,
    label: 'Szatnia',
    // FAKT: odpowiedzi 10 i 50 — to samo wyposażenie w obu studiach.
    value: 'Prysznic, ręczniki i kosmetyki na miejscu',
  },
  {
    ikona: 'move' as const,
    label: 'Zajęcia',
    /* Liczba, nie wyliczanka: nazwy pięciu zajęć łamałyby tor faktu na
       cztery wiersze. Pełna lista z opisami stoi na /zajecia. */
    value: rodzajeRuchu(available.length),
  },
]
  /* Fakt bez wartości znika w całości, razem z etykietą i piktogramem.
     Parkingu w Pruszczu po prostu nie znamy (odpowiedź 34 go nie rozstrzyga),
     więc ta karta tam się nie pojawia. */
  .filter((f) => f.value);

const title = `${location.city} — studio jogi, pilatesu i aerial yogi`;
const metaDescription = `TAK MI MOVE ${location.city}, ${address}. Joga, pilates, stretching i aerial yoga w kameralnych grupach. Zapisy online.`;
---

<Base title={title} description={metaDescription}>
  {/* Bez nadtytułu: „Studio" wchodzi do samego tytułu, tak jak na makiecie.
      Osobny nadtytuł powtarzałby słowo, które i tak stoi wiersz niżej. */}
  <PageHeader
    title={`Studio ${location.city}`}
    crumbs={[
      { label: 'Studia', href: '/studia' },
      { label: location.city, href: `/studia/${location.slug}` },
    ]}
  />

  <Section as="div" size="sm">
    <div class="studio__top">
      <ul class="fakty">
        {
          fakty.map((f) => (
            <li class="fakt">
              <span class="fakt__ikona" aria-hidden="true">
                <FactIcon name={f.ikona} />
              </span>
              <h2 class="fakt__label">{f.label}</h2>
              <p class="fakt__tekst">
                {f.value}
                {'drugaLinia' in f && f.drugaLinia && (
                  <>
                    <br />
                    {f.drugaLinia}
                  </>
                )}
              </p>
            </li>
          ))
        }
      </ul>

      {
        kadry && (
          <figure class="studio__hero">
            <Image
              src={kadry.hero}
              alt={`Poczekalnia studia TAK MI MOVE w ${location.cityLocative}`}
              widths={[600, 900, 1400]}
              sizes="(min-width: 60rem) 46vw, 100vw"
              loading="eager"
              class="studio__heroFoto"
            />
          </figure>
        )
      }
    </div>
  </Section>

  {
    kadry && (
      <Section as="div" size="sm">
        <ul class="galeria">
          {kadry.galeria.map((k) => (
            <li>
              <Image
                src={k.plik}
                alt={k.opis}
                widths={[320, 480, 700]}
                sizes="(min-width: 48rem) 23vw, 45vw"
                loading="lazy"
                class="galeria__foto"
              />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section size="lg">
    <div class="studio__dol">
      {
        description && (
          <article class="karta karta--opis">
            <span class="karta__ikona" aria-hidden="true">
              <FactIcon name="sun" size="1.6rem" />
            </span>
            <div>
              <h2 class="karta__tytul">{descriptionTitle}</h2>
              <p class="karta__tekst">{description}</p>
            </div>
          </article>
        )
      }

      <article class="karta karta--kontakt">
        <h2 class="karta__tytul">Dane kontaktowe</h2>

        <ul class="kontakt">
          <li>
            <span class="kontakt__ikona" aria-hidden="true">
              <FactIcon name="phone" size="1.1rem" />
            </span>
            <a href={`tel:${site.phone}`} data-event="phone_click">{site.phoneDisplay}</a>
          </li>
          <li>
            <span class="kontakt__ikona" aria-hidden="true">
              <FactIcon name="mail" size="1.1rem" />
            </span>
            <a href={`mailto:${location.email}`} data-event="email_click">{location.email}</a>
          </li>
          <li>
            <span class="kontakt__ikona" aria-hidden="true">
              <SocialIcon platform="instagram" size="1.1rem" />
            </span>
            <span class="kontakt__profile">
              {location.social.map((s) => (
                <a href={s.url} target="_blank" rel="noopener me">
                  {s.label}
                </a>
              ))}
            </span>
          </li>
        </ul>

        <Button
          href={`/grafik?studio=${location.slug}`}
          source="location"
          event="schedule_page_view"
          class="kontakt__cta"
        >
          Zobacz grafik i zapisz się
        </Button>
      </article>
    </div>
  </Section>

  {/* FAQ zdjęte 20.08.2026. Żadne z pięciu pytań nie dotyczy konkretnej
      lokalizacji, więc obie podstrony studiów pokazywały ten sam blok co
      strona główna. Jedyne, które mogłoby być lokalne — „czy wszystkie
      zajęcia odbywają się w obu studiach" — opiera się na moim wniosku,
      bo pytanie 25 klientka przekreśliła bez odpowiedzi. */}
</Base>

<style>
  /* ————————————————— fakty praktyczne + kadr ————————————————— */

  .studio__top {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .fakty {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    /* minmax(0, …), nie minmax(8rem, …): najdłuższe słowo w adresie
       („Grunwaldzka") ma większą szerokość min-content niż 8 rem, więc
       auto-fit liczył węższe tory i fakty łamały się na dwa wiersze. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-md);
  }

  .fakt__ikona {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-pill);
    border: var(--hairline) solid var(--line-detail);
    color: var(--accent);
    margin-block-end: var(--space-sm);
  }

  .fakt__label {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: 400;
    margin-block-end: var(--space-3xs);
  }

  /* Stopień pisma jak na makiecie. Przy --fs-small „ul. Grunwaldzka 55/7"
     nie mieściło się w torze i adres rozpadał się na pięć wierszy. */
  .fakt__tekst {
    font-size: var(--fs-caption);
    color: var(--text-muted);
    line-height: 1.55;
  }

  .studio__hero {
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .studio__heroFoto {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* ————————————————————— galeria ————————————————————— */

  /* Równy rząd, nie schodki i nie przewijany pas. Kadry są różnych proporcji
     (pion i poziom), więc wspólne `aspect-ratio` przycina je do jednej linii. */
  .galeria {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
  }

  .galeria__foto {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  /* ————————————————————— dwie karty ————————————————————— */

  .studio__dol {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
  }

  .karta {
    border-radius: var(--radius-card);
    padding: var(--space-lg);
  }

  .karta--opis {
    background: var(--surface-alt);
  }

  .karta--kontakt {
    background: var(--surface);
    border: var(--hairline) solid var(--line);
  }

  /* Piktogram stoi obok tekstu, nie nad nim — inaczej niż w faktach, bo tu
     jest jeden na całą kartę i pełni rolę znacznika, a nie etykiety. */
  .karta--opis {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    align-items: start;
  }

  .karta__ikona {
    color: var(--accent);
    display: grid;
    place-items: center;
    margin-block-start: 0.15em;
  }

  .karta__tytul {
    font-size: var(--fs-h3);
    margin-block-end: var(--space-sm);
  }

  .karta__tekst {
    max-width: var(--measure);
    line-height: var(--lh-loose);
  }

  /* ————————————————— dane kontaktowe ————————————————— */

  .kontakt {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-lg);
    display: grid;
    gap: var(--space-sm);
  }

  .kontakt li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: center;
    gap: var(--space-2xs);
  }

  .kontakt__ikona {
    color: var(--accent);
    display: grid;
    place-items: center;
  }

  .kontakt a {
    color: var(--text-accent);
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
  }

  .kontakt__profile {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-size: var(--fs-small);
  }

  /* Przycisk na całą szerokość karty, tak jak na makiecie.
     :global, bo klasa podana propem ląduje na korzeniu komponentu Button,
     a ten nosi swój własny scope Astro — reguła bez :global po prostu
     nigdy by nie trafiła. */
  .karta--kontakt :global(.kontakt__cta) {
    display: flex;
    inline-size: 100%;
    justify-content: center;
  }

  @media (min-width: 48rem) {
    /* Cztery kadry w jednym rzędzie — układ z makiety. */
    .galeria {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 60rem) {
    .studio__top {
      /* Kadr zwężony, żeby tor faktu zmieścił „83-000 Pruszcz Gdański"
         w jednym wierszu — przy szerszym kadrze brakowało kilkunastu pikseli
         i kod pocztowy zjeżdżał do trzeciej linii. */
      grid-template-columns: 1fr minmax(16rem, 24rem);
      gap: var(--space-2xl);
    }

    /* Wszystkie fakty w jednym rzędzie, niezależnie od tego, ile ich jest:
       Pruszcz ma cztery, Gdańsk pięć (dochodzi parking). `grid-auto-flow`
       radzi sobie z obiema liczbami bez wpisywania ich do arkusza. */
    .fakty {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: var(--space-md);
    }

    /* Karta z opisem szersza od kontaktowej: opis to tekst ciągły, dane
       kontaktowe to krótkie wiersze i przycisk. */
    .studio__dol {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-lg);
    }
  }
</style>
