---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import StudioPanel from '~/components/ui/StudioPanel.astro';
import { locations } from '~/data/site';
import { pages } from '~/data/copy/pages';
import { home } from '~/data/copy/home';

/* Kadr Pruszcza wymieniony 04.09.2026 na polecenie: zamiast sali
   z hamakami idzie ujęcie z matami i bolsterami z nowej sesji
   (Takmimove_Interior_5). Poprzedni plik `studio-pruszcz-sala.jpg`
   zostaje w katalogu, nieużywany. */
import zdjecieP from '~/assets/photos/studio-pruszcz-sala-maty.jpg';
import zdjecieG from '~/assets/photos/studio-gdansk-sala.jpg';

/** Kadr sali dla każdej lokalizacji — po jednym, dobrane z sesji. */
const zdjecia: Record<string, ImageMetadata> = {
  'pruszcz-gdanski': zdjecieP,
  gdansk: zdjecieG,
};

/**
 * Rozdroże obu lokalizacji.
 *
 * Brief (dok. projektowy §5) ostrzega przed dublowaniem treści między
 * podstronami lokalizacji a stroną główną — dlatego to jest zwięzły spis
 * praktyczny (adres, kontakt, wyjścia), a nie powtórzenie sekcji z „Start”.
 *
 * Etap 5: karta z obwódką, paddingiem 46 px i włoskową kreską nad nazwą
 * ustąpiła panelowi ze strony głównej. Ten sam komponent, te same etykiety
 * wyjść — rozdroże przestało być osobnym wzorcem wizualnym.
 */
const t = pages.studios;
---

<Base title={t.meta.title} description={t.meta.description}>
  <PageHeader
    size="sm"
    eyebrow={t.eyebrow}
    title={t.title}
    lead={t.lead}
    crumbs={[{ label: 'Studia', href: '/studia' }]}
  />

  <Section size="md" tone="alt" class="karty-sekcja">
    <ul class="studios">
      {
        locations.map((location) => (
          <StudioPanel
            location={location}
            photo={zdjecia[location.slug]!}
            eager
            compact
            headingLevel={2}
            linkLabel={home.studios.linkLabel}
            scheduleLabel={home.studios.scheduleLabel}
          />
        ))
      }
    </ul>
  </Section>
</Base>

<style>
  /* ————————————————— rytm i podział —————————————————

     ODDZIELENIE SEKCJI. Do tej pory sekcja kart stała na tonie
     `default`, czyli na tym samym `--bone` co panele w środku —
     pomiar potwierdzał, że tło sekcji i tło panelu miały identyczną
     wartość rgb(247, 244, 235). Panele nie miały się więc na czym
     odciąć i cała sekcja czytała się jak dalszy ciąg nagłówka.

     Ton `alt` to dokładnie ten sam mechanizm, którym oddzielona jest
     sekcja studiów na stronie głównej: różnica jasności powierzchni,
     bez kreski, bez obwódki i bez cienia. Żadnego nowego ozdobnika
     ani podniesienia kontrastu — to ta sama para tonów, która na
     stronie głównej jest już zatwierdzona.

     ODSTĘP DO KART. Przed zmianą od spodu leadu do górnej krawędzi
     karty było 153 px, dziś 93 — o 39% mniej. Składają się na to dwie
     rzeczy: `size="sm"` na nagłówku (77 → 46 px pod leadem) i krótsza
     góra tej sekcji (77 → 46 px). Sam podział tonem robi teraz robotę,
     którą wcześniej musiała robić pustka, więc 47 px oddechu przed
     krawędzią pasa w zupełności wystarcza.

     Bez ujemnych marginesów: przy zmianie tonu ciągnęłyby pas `alt`
     w górę pod nagłówek, a dobrane na oko dały 23 px między leadem
     a krawędzią koloru — wizualnie zlepek.

     :global, bo klasa trafia na korzeń komponentu Section i nosi JEGO
     scope (ta sama pułapka co w Atmosphere i na podstronach studiów). */
  /* Lead łamany na równe wiersze, nie na "ile się zmieści".
     Globalne `pretty` dla akapitów pilnuje tylko sierot i przy tym
     tekście dawało 48 / 49 / 33 znaki — trzeci wiersz o jedną trzecią
     krótszy od dwóch pierwszych, co pod wyśrodkowaną kreską nagłówka
     widać od razu. `balance` wyrównuje długości wierszy.

     Reguła jest globalna, bo element nosi scope komponentu PageHeader,
     ale arkusz tej strony linkuje wyłącznie /studia — pozostałe leady
     w serwisie zostają na `pretty`. */
  :global(.page-header__lead) {
    text-wrap: balance;
    /* 40ch zamiast globalnych 46ch. Przy 46ch balans dawał trzy wiersze
       451 / 395 / 382 px, czyli schodek. Przy 40ch łamanie trafia
       w kropkę po pierwszym zdaniu, a trzy kolejne wiersze mają
       318 / 328 / 310 px — rozrzut 18 px, czyli 5%. Blok jest o wiersz
       wyższy i o to samo spokojniejszy. */
    max-width: 40ch;
  }

  :global(.section.karty-sekcja) {
    padding-block-start: var(--space-lg);
  }

  .studios {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 48rem) {
    .studios {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }
</style>
