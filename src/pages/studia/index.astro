---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Section from '~/components/ui/Section.astro';
import Mark from '~/components/ui/Mark.astro';
import { locations, formatAddress, site } from '~/data/site';
import { pages } from '~/data/copy/pages';

import zdjecieP from '~/assets/photos/studio-pruszcz-sala.jpg';
import zdjecieG from '~/assets/photos/studio-gdansk-sala.jpg';

/** Kadr sali dla każdej lokalizacji — po jednym, dobrane z sesji. */
const zdjecia: Record<string, ImageMetadata> = {
  'pruszcz-gdanski': zdjecieP,
  gdansk: zdjecieG,
};

/**
 * Rozdroże obu lokalizacji.
 *
 * Brief (dok. projektowy §5) ostrzega przed dublowaniem treści między
 * podstronami lokalizacji a stroną główną — dlatego to jest zwięzły spis
 * praktyczny (adres, kontakt, dojazd), a nie powtórzenie sekcji z „Start”.
 */
const t = pages.studios;
---

<Base title={t.meta.title} description={t.meta.description}>
  <PageHeader
    eyebrow={t.eyebrow}
    title={t.title}
    lead={t.lead}
    crumbs={[{ label: 'Studia', href: '/studia' }]}
  />

  <Section size="md">
    <ul class="studios">
      {
        locations.map((location) => {
          return (
            <li class="studio-card">
              <div class="studio-card__head">
                <Mark size="0.9rem" class="studio-card__mark" />
                <h2 class="studio-card__name">{location.city}</h2>
              </div>

              <p class="studio-card__address">{formatAddress(location)}</p>

              {/* Kadr zamiast opisu — decyzja z 20.08.2026. Opis sali został
                  na podstronie studia; tutaj tę samą robotę wykonuje zdjęcie.
                  Różnicę między jasną salą z jodełką w Pruszczu a betonem
                  i złoconymi lustrami w Gdańsku widać szybciej, niż da się
                  ją przeczytać. */}
              <figure class="studio-card__figure">
                <Image
                  src={zdjecia[location.slug]}
                  alt={`Sala studia TAK MI MOVE w ${location.cityLocative}`}
                  widths={[480, 720, 1000]}
                  sizes="(min-width: 48rem) 42vw, 100vw"
                  loading="eager"
                  class="studio-card__photo"
                />
              </figure>

              <dl class="studio-card__contact">
                <dt>Telefon</dt>
                <dd>
                  <a href={`tel:${site.phone}`} data-event="phone_click">{site.phoneDisplay}</a>
                </dd>
                <dt>E-mail</dt>
                <dd>
                  <a href={`mailto:${location.email}`} data-event="email_click">{location.email}</a>
                </dd>
              </dl>

              <p class="studio-card__links">
                <a href={`/studia/${location.slug}`} data-event="studio_location_select">
                  Dojazd i szczegóły
                </a>
                <a href={`/grafik?studio=${location.slug}`} data-event="schedule_page_view">
                  Grafik
                </a>
              </p>
            </li>
          );
        })
      }
    </ul>
  </Section>
</Base>

<style>
  .studios {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }

  /* Kafel zamiast kolumny z kreską u góry. Cienka linia została, ale
     teraz siedzi w środku karty, nad nazwą — tak jak na makiecie. */
  .studio-card {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    background: var(--surface);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-card);
    padding: var(--space-lg);
  }

  .studio-card::before {
    content: '';
    block-size: 1px;
    background: var(--line-detail);
    margin-block-end: var(--space-sm);
  }

  .studio-card__figure {
    margin: 0;
    margin-block-start: var(--space-md);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .studio-card__photo {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .studio-card__head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .studio-card__head :global(.studio-card__mark) {
    color: var(--accent);
  }

  .studio-card__name {
    font-size: var(--fs-h2);
  }

  .studio-card__address {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .studio-card__contact {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3xs) var(--space-sm);
    margin-block-start: var(--space-sm);
    font-size: var(--fs-small);
  }

  .studio-card__contact dt {
    color: var(--text-muted);
  }

  .studio-card__contact dd {
    margin: 0;
  }

  .studio-card__contact a {
    color: var(--text-accent);
  }

  .studio-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin-block-start: var(--space-md);
    font-size: var(--fs-small);
  }

  .studio-card__links a {
    color: var(--text-accent);
    padding-block: 0.25rem;
  }

  @media (min-width: 48rem) {
    .studios {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }
</style>
