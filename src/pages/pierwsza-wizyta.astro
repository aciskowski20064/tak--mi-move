---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import Section from '~/components/ui/Section.astro';
import Mark from '~/components/ui/Mark.astro';
import Todo from '~/components/ui/Todo.astro';
import Faq from '~/components/sections/Faq.astro';
import { booking, site } from '~/data/site';
import { pages } from '~/data/copy/pages';
import { home } from '~/data/copy/home';
import { copyOrNull, isPlaceholder, showPlaceholders } from '~/lib/copy';

import photoKawa from '~/assets/photos/studio-kawa.jpg';
import photoSprzet from '~/assets/photos/studio-sprzet.jpg';
import photoSzatnia from '~/assets/photos/studio-szatnia.jpg';

/**
 * Brief §18 — osobna podstrona, bo odpowiada na wysokokonwersyjne pytania
 * osób, które nigdy nie ćwiczyły. To najczęstszy powód rezygnacji przed
 * pierwszą rezerwacją.
 *
 * Układ prowadzi przez trzy pytania w kolejności, w jakiej padają w głowie:
 * „co mnie czeka” (nagłówek), „co mam zrobić” (oś czasu), „na co uważać”
 * (bloki). Zdjęcia nie są dekoracją — każde stoi przy zdaniu, które
 * potwierdza: sprzęt przy „nie musisz nic przynosić”, szatnia przy „na miejscu”.
 */
const t = pages.firstVisit;
const steps = home.firstVisit.steps.filter((step) => !isPlaceholder(step.text));
const missingSteps = showPlaceholders
  ? home.firstVisit.steps.filter((step) => isPlaceholder(step.text))
  : [];
const lead = copyOrNull(t.lead);

/** Bloki ze zdjęciem stoją w pierwszym rzędzie — dowód czyta się przed regułą. */
const blocks = [
  { ...t.sections.bring, photo: photoSprzet, alt: t.photos.gear, amenities: false },
  { ...t.sections.arrival, photo: photoSzatnia, alt: t.photos.changing, amenities: true },
  { ...t.sections.health, photo: null, alt: null, amenities: false },
  { ...t.sections.cancel, photo: null, alt: null, amenities: false },
];
---

<Base title={t.meta.title} description={t.meta.description}>
  <Section as="div" size="md" class="intro">
    <div class="intro__grid">
      <div class="intro__text">
        <Breadcrumbs items={[{ label: 'Pierwsza wizyta', href: '/pierwsza-wizyta' }]} />
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="intro__title">{t.title}</h1>
        <span class="intro__rule" aria-hidden="true"></span>
        {lead ? <p class="lead intro__lead">{lead}</p> : <Todo label={t.lead} block />}
      </div>

      <div class="intro__media">
        <figure class="intro__figure">
          <Image
            src={photoKawa}
            alt={t.photos.hero}
            widths={[420, 660, 900]}
            sizes="(min-width: 60rem) 38vw, 100vw"
            loading="eager"
            class="intro__image"
          />
        </figure>

        <aside class="booking">
          <h2 class="booking__title">{home.firstVisit.ctaLabel}</h2>

          <p class="booking__help">
            Wolisz zapisać się przez telefon?
            <a href={`tel:${site.phone}`} data-event="phone_click">{site.phoneDisplay}</a>
          </p>

          {/* Na szerokim ekranie zostaje sama strzałka, dlatego etykieta musi
              przetrwać jako aria-label — inaczej czytnik ogłosiłby „link”. */}
          <a
            class="booking__go"
            href={booking.frontOfficeUrl}
            target={booking.newTab ? '_blank' : undefined}
            rel={booking.newTab ? 'noopener' : undefined}
            aria-label={home.firstVisit.ctaLabel}
            data-cta-source="first-visit"
            data-event="first_visit_cta_click"
          >
            <span class="booking__goLabel">{home.firstVisit.ctaLabel}</span>
            <svg class="booking__goIcon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M4 12h15m0 0-6-6m6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </aside>
      </div>
    </div>
  </Section>

  <Section size="lg" tone="alt">
    <p class="eyebrow">{t.stepsEyebrow}</p>
    <h2 class="steps__title">{t.stepsTitle}</h2>

    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step">
            <span class="step__marker" aria-hidden="true">
              <Mark size="2.2rem" />
              <span class="step__num">{String(index + 1).padStart(2, '0')}</span>
            </span>
            <div class="step__body">
              <h3 class="step__title">{step.title}</h3>
              <p class="step__text">{step.text}</p>
            </div>
          </li>
        ))
      }
      {
        missingSteps.map((step) => (
          <li class="step step--todo">
            <Todo label={step.text} block />
          </li>
        ))
      }
    </ol>
  </Section>

  <Section size="lg">
    <header class="blocks__header">
      <p class="eyebrow">{t.blocksEyebrow}</p>
      <h2 class="blocks__title">{t.blocksTitle}</h2>
    </header>

    <div class="blocks">
      {
        blocks.map((block) => {
          const body = copyOrNull(block.body);
          return (
            <article class="card">
              {block.photo && (
                <Image
                  src={block.photo}
                  alt={block.alt!}
                  widths={[420, 660, 900]}
                  sizes="(min-width: 60rem) 44vw, 100vw"
                  loading="lazy"
                  class="card__image"
                />
              )}
              <div class="card__body">
                <h3 class="card__title">{block.title}</h3>
                {body ? <p class="card__text">{body}</p> : <Todo label={block.body} block />}
                {block.amenities && (
                  <ul class="amenities">
                    {t.amenities.map((item) => (
                      <li class="amenities__item">
                        <Mark size="0.7rem" />
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </Section>

  <Faq />
</Base>

<style>
  /* ————————————————————————— nagłówek ————————————————————————— */

  .intro__grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .intro__title {
    margin-block-start: var(--space-2xs);
    max-width: 18ch;
  }

  /* Krótka kreska oddziela nagłówek od akapitu. Robi to, czego nie zrobi
     sam odstęp: zamyka tytuł, zamiast pozwolić mu przejść płynnie w tekst. */
  .intro__rule {
    display: block;
    inline-size: 3.5rem;
    block-size: 2px;
    margin-block: var(--space-md);
    background: var(--accent);
  }

  .intro__lead {
    line-height: 1.85;
    max-width: 46ch;
  }

  .intro__media {
    position: relative;
  }

  /* Łuk cytuje ten namalowany na ścianie studia — patrz --radius-arch.
     Zaokrąglony jest tylko górny lewy narożnik; pozostałe zostają ostre,
     żeby kadr miał kierunek i nie zamienił się w medalion. */
  .intro__figure {
    margin: 0;
    border-start-start-radius: var(--radius-arch);
    overflow: hidden;
  }

  .intro__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
    /* Kubek siedzi w dolnej połowie kadru — przy przycinaniu pionowego
       zdjęcia trzymamy się dołu, żeby go nie uciąć. */
    object-position: 50% 68%;
  }

  /* ————————————————————————— oś czasu ————————————————————————— */

  .steps__title {
    margin-block: var(--space-2xs) var(--space-lg);
    max-width: 18ch;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    align-items: start;
    position: relative;
  }

  /* Linia łącząca kolejne kroki. Rysowana od znacznika w dół, ostatni krok
     jej nie dostaje, żeby oś nie wisiała w powietrzu pod listą. */
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    inset-block: 2.6rem calc(-1 * var(--space-md));
    inset-inline-start: calc(1.3rem - var(--hairline) / 2);
    inline-size: var(--hairline);
    background: var(--line);
  }

  .step--todo {
    grid-template-columns: 1fr;
  }

  /* Tło kropki zasłania linię łączącą, żeby nie przechodziła przez znacznik. */
  .step__marker {
    display: grid;
    place-items: center;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    border-radius: var(--radius-pill);
    background: var(--surface-alt);
    color: var(--text-accent);
    position: relative;
  }

  .step__num {
    position: absolute;
    font-size: var(--fs-caption);
    letter-spacing: 0.02em;
    color: var(--text-accent);
  }

  .step__title {
    font-size: var(--fs-h4);
    margin-block-end: var(--space-3xs);
  }

  .step__text {
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: var(--measure);
  }

  /* ————————————————————————— karta rezerwacji ————————————————————————— */

  /* Na wąskim ekranie karta stoi po prostu pod zdjęciem i wygląda jak
     zwykły blok z pełnym przyciskiem. Poziomy pasek ze strzałką włącza się
     dopiero tam, gdzie jest na niego miejsce (patrz 60rem). */
  .booking {
    display: grid;
    gap: var(--space-sm);
    margin-block-start: var(--space-md);
    padding: var(--space-md);
    background: var(--surface-soft);
    border-radius: var(--radius-card);
  }

  .booking__title {
    font-size: var(--fs-h3);
  }

  .booking__help {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .booking__help a {
    color: var(--text-accent);
    margin-inline-start: 0.35em;
  }

  .booking__go {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-block-size: 44px;
    padding-inline: var(--space-md);
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent);
    text-decoration: none;
    font-size: var(--fs-small);
    text-align: center;
  }

  .booking__goIcon {
    display: none;
    inline-size: 1.35rem;
    block-size: 1.35rem;
  }

  /* ————————————————————————— bloki informacyjne ————————————————————————— */

  .blocks__header {
    margin-block-end: var(--space-lg);
  }

  .blocks__title {
    margin-block-start: var(--space-2xs);
    max-width: 22ch;
  }

  .blocks {
    display: grid;
    gap: var(--space-md);
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface-alt);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .card__image {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .card__body {
    padding: var(--space-md);
  }

  .card__title {
    font-size: var(--fs-h3);
    margin-block-end: var(--space-xs);
  }

  .card__text {
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: var(--measure);
  }

  .amenities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-md);
    padding-block-start: var(--space-sm);
    border-block-start: var(--hairline) solid var(--line);
  }

  .amenities__item {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-accent);
  }

  @media (min-width: 48rem) {
    .blocks {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (min-width: 60rem) {
    /* :global, bo klasa "intro" trafia na korzeń komponentu Section, a ten
       nosi scope Astro tamtego komponentu, nie tej strony — bez tego reguła
       po cichu nie działa.

       overflow-x: clip jest obowiązkowe przy kadrze wychodzącym poza okno:
       100vw liczy szerokość RAZEM z paskiem przewijania, więc bez tego strona
       dostaje poziomy pasek. clip, w odróżnieniu od hidden, nie tworzy
       kontenera przewijania. */
    :global(.intro) {
      padding-block-end: var(--space-2xl);
      overflow-x: clip;
    }

    .intro__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: var(--space-2xl);
      align-items: center;
    }

    /* Kadr ucieka poza prawą krawędź okna. */
    .intro__media {
      margin-inline-end: calc(-1 * (var(--gutter) + max(0px, (100vw - var(--container)) / 2)));
    }

    /* Poziomy pasek zamiast pionowej karty: tytuł, kreska, telefon, strzałka.
       Proporcje z makiety — 58% szerokości kadru przy 22% jego wysokości,
       czyli element LEŻĄCY, a nie stojący. Poprzednia wersja miała te same
       treści ułożone w słupek i przez to była dwa razy za wysoka. */
    .booking {
      position: absolute;
      inset-block-end: calc(-1 * (var(--space-lg) + var(--space-sm)));
      inset-inline-end: var(--space-lg);
      inline-size: min(26rem, 58%);
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: var(--space-sm);
      padding: var(--space-sm);
      margin-block-start: 0;
      box-shadow: 0 2px 28px color-mix(in srgb, var(--espresso) 14%, transparent);
    }

    .booking__title {
      font-size: var(--fs-h4);
      line-height: var(--lh-heading);
      max-width: 10ch;
    }

    /* Kreska oddzielająca to obramowanie akapitu z telefonem — jeden element
       mniej w drzewie niż osobny separator. */
    .booking__help {
      font-size: var(--fs-caption);
      line-height: var(--lh-body);
      max-width: 17ch;
      padding-inline-start: var(--space-sm);
      border-inline-start: var(--hairline) solid
        color-mix(in srgb, var(--clay-deep) 45%, transparent);
    }

    .booking__help a {
      display: block;
      margin-inline-start: 0;
    }

    /* Etykieta zostaje w drzewie dostępności przez aria-label na linku,
       więc można ją tu schować bez straty dla czytników. */
    .booking__goLabel {
      display: none;
    }

    .booking__go {
      inline-size: 2.9rem;
      block-size: 2.9rem;
      min-block-size: 0;
      padding-inline: 0;
      background: transparent;
      color: var(--text-accent);
      border: var(--hairline) solid color-mix(in srgb, var(--clay-deep) 78%, transparent);
      transition: background var(--dur-fast), color var(--dur-fast);
    }

    .booking__go:hover {
      background: var(--accent);
      color: var(--on-accent);
    }

    .booking__goIcon {
      display: block;
    }
  }
</style>
