---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Section from '~/components/ui/Section.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Mark from '~/components/ui/Mark.astro';
import Button from '~/components/ui/Button.astro';
import Todo from '~/components/ui/Todo.astro';
import Faq from '~/components/sections/Faq.astro';
import { booking, site } from '~/data/site';
import { pages } from '~/data/copy/pages';
import { home } from '~/data/copy/home';
import { copyOrNull, isPlaceholder, showPlaceholders } from '~/lib/copy';
import { typo } from '~/lib/typografia';

import photoSprzet from '~/assets/photos/studio-sprzet.jpg';
import photoSzatnia from '~/assets/photos/studio-szatnia.jpg';

/**
 * Brief §18 — osobna podstrona, bo odpowiada na wysokokonwersyjne pytania
 * osób, które nigdy nie ćwiczyły. To najczęstszy powód rezygnacji przed
 * pierwszą rezerwacją.
 *
 * Układ prowadzi przez trzy pytania w kolejności, w jakiej padają w głowie:
 * „co mnie czeka” (nagłówek), „co mam zrobić” (oś czasu), „na co uważać”
 * (bloki). Zdjęcia nie są dekoracją — każde stoi przy zdaniu, które
 * potwierdza: sprzęt przy „nie musisz nic przynosić”, szatnia przy „na miejscu”.
 */
const t = pages.firstVisit;
const steps = home.firstVisit.steps.filter((step) => !isPlaceholder(step.text));
const missingSteps = showPlaceholders
  ? home.firstVisit.steps.filter((step) => isPlaceholder(step.text))
  : [];

/** Bloki ze zdjęciem stoją w pierwszym rzędzie — dowód czyta się przed regułą. */
const blocks = [
  { ...t.sections.bring, photo: photoSprzet, alt: t.photos.gear, amenities: false },
  { ...t.sections.arrival, photo: photoSzatnia, alt: t.photos.changing, amenities: true },
  { ...t.sections.health, photo: null, alt: null, amenities: false },
  { ...t.sections.cancel, photo: null, alt: null, amenities: false },
];
---

<Base title={t.meta.title} description={t.meta.description}>
  {/* Nagłówek na pełnej szerokości. Poza krokami stoi tu jeden tytuł
      i kreska — bez leadu, bez nadtytułu, bez nagłówka sekcji.
      `titleLines` wymusza dwa wiersze; przy łamaniu szerokością pudełka
      tytuł rozpadał się na cztery. */}
  <PageHeader
    size="sm"
    title={t.title}
    titleLines={t.titleLines}
    crumbs={[{ label: 'Pierwsza wizyta', href: '/pierwsza-wizyta' }]}
  />

  {/* Kroki w siatce 2 × 3, nie w pionowej osi po prawej. Split-screen
      odpadł: przy dwóch kolumnach lewa zostawała pusta na całą wysokość
      listy, a prawa robiła się gęsta. Tło `alt` wydziela sekcję samą
      różnicą jasności — bez różu i bez organicznego panelu. */}
  <Section size="md" tone="alt" class="stepsSection">
    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step">
            {/* Znak marki z numerem w środku — ten sam komponent Mark
                (wariant pierścieniowy), którego używa reszta serwisu.
                Całość dekoracyjna: kolejność niesie znacznik `ol`, więc
                czytnik ekranu dostaje ją z HTML-a, a nie z liczby. */}
            <span class="step__marker" aria-hidden="true">
              <Mark size="2.6rem" />
              <span class="step__num">{String(index + 1).padStart(2, '0')}</span>
            </span>
            <div class="step__body">
              <h2 class="step__title">{typo(step.title)}</h2>
              <p class="step__text">{typo(step.text)}</p>
            </div>
          </li>
        ))
      }
      {
        missingSteps.map((step) => (
          <li class="step step--todo">
            <Todo label={step.text} block />
          </li>
        ))
      }
    </ol>
  </Section>
  <Section size="lg">
    {/* Nadtytuł „Ważne informacje" i nagłówek „Wszystko, co warto wiedzieć
        wcześniej" zdjęte na prośbę klientki (25.08.2026) — cztery bloki
        niosą własne tytuły. */}
    <div class="blocks">
      {
        blocks.map((block) => {
          const body = copyOrNull(block.body);
          return (
            <article class="card">
              {block.photo && (
                <Image
                  src={block.photo}
                  alt={block.alt!}
                  widths={[420, 660, 900]}
                  sizes="(min-width: 60rem) 44vw, 100vw"
                  loading="lazy"
                  class="card__image"
                />
              )}
              <div class="card__body">
                <h2 class="card__title">{typo(block.title)}</h2>
                {body ? <p class="card__text">{typo(body)}</p> : <Todo label={block.body} block />}
                {block.amenities && (
                  <ul class="amenities">
                    {t.amenities.map((item) => (
                      <li class="amenities__item">
                        <Mark size="0.7rem" />
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </Section>

  <Faq />

  {/* PAS DOMYKAJĄCY, NIE BANNER (28.08.2026).

      Zdjęte: różowe tło (ton `soft`, czyli --clay-wash — terakota
      rozcieńczona w kremie, którego finalnej wartości nie znamy, więc
      pochodna placeholdera jest placeholderem podwójnie), nadmiarowy
      padding oraz powtórzenie „Zarezerwuj pierwsze zajęcia" naraz jako
      nagłówka i jako etykiety przycisku.

      Konstrukcja jest teraz bliźniacza wobec zatwierdzonego pasa na
      stronie głównej (FinalCta): to samo jasne --surface, ten sam
      wspólny komponent Button, ten sam próg dwóch kolumn. Strzałka
      odpadła razem z własnym przyciskiem — przycisk z systemu jej
      nie ma, a rysowanie jej ręcznie było jedynym powodem, dla którego
      ten CTA istniał poza wspólnym komponentem. */}
  <Section size="md" class="booking-strip">
    <div class="booking">
      <div class="booking__text">
        <h2 class="booking__title">{typo(home.firstVisit.ctaLabel)}</h2>
        <p class="booking__help">
          Wolisz zapisać się przez telefon?
          <a href={`tel:${site.phone}`} data-event="phone_click">{site.phoneDisplay}</a>
        </p>
      </div>

      <div class="booking__actions">
        <Button
          href={booking.frontOfficeUrl}
          newTab={booking.newTab}
          size="lg"
          source="first-visit"
          event="first_visit_cta_click"
        >
          {booking.label}
        </Button>
      </div>
    </div>
  </Section>
</Base>

<style>
  /* ————————————————————————— nagłówek —————————————————————————

     Stopień pisma niżej niż globalne --fs-h1 (60 px na 1280). Tytuł ma
     tu dwa wiersze wersalikami i przy pełnej skali zajmował jedną trzecią
     pierwszego ekranu. 44 px daje te same dwa wiersze w proporcji, która
     nie konkuruje z treścią pod spodem.

     :global, bo element nosi scope komponentu PageHeader. Arkusz tej
     strony linkuje wyłącznie /pierwsza-wizyta — sprawdzone pomiarem
     na pozostałych podstronach. */
  :global(.page-header__title) {
    font-size: clamp(1.75rem, 1.35rem + 2vw, 2.75rem);
    line-height: 1.14;
    /* base.css tnie każdy tytuł podstrony do 18ch, żeby długie zdania
       łamały się na wiersze zamiast rozciągać w jeden. Tutaj wiersze są
       już podane wprost, więc ta miara tylko psuje: przy 44 px daje
       ok. 380 px, a „Twoja pierwsza wizyta" potrzebuje 420 — pierwszy
       wiersz łamał się na dwa i z dwóch robiły się trzy. */
    max-width: none;
  }

  /* ————————————————————————— sekcja kroków ————————————————————————— */

  :global(.section.stepsSection) {
    padding-block: var(--space-lg);
  }
  /* ————————————————— sekwencja 01–06 —————————————————

     Jedna lista na pełnej szerokości, krok pod krokiem. Kolejność niosą
     duży numer po lewej i rytm wierszy — nie diagram. Poprzednie wersje
     próbowały pokazać proces siatką 2 × 3 z connectorami i pionową osią;
     obie czytały się jak schemat, a nie jak lista do przeczytania.

     Czego tu celowo NIE ma: kart, obwódek, kółek wokół numerów, kropli
     marki przy każdym kroku, strzałek i linii łączących. */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }

  .step {
    display: grid;
    /* Wąska kolumna numeru trzyma stałą szerokość na każdej pozycji —
       przy `auto` tory rozjeżdżałyby się o subpiksele między wierszami
       i tytuły traciłyby wspólną linię. */
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: start;
    padding-block: var(--space-md);
  }

  /* Separator włoskowaty, w `--line-detail`: `--line` jest dobrana do
     jasnego --surface i na piaskowym tle sekcji praktycznie znika. */
  .step + .step {
    border-block-start: var(--hairline) solid var(--line-detail);
  }

  .step--todo {
    grid-template-columns: 1fr;
  }

  /* Znak marki obejmujący numer. To ten sam komponent i te same wymiary,
     które stały tu przed przebudową na listę — nic nie jest odrysowane
     od nowa. Pudełko 3.05 rem mieści kroplę 2.6 rem z zapasem, w którym
     numer nie dotyka konturu.

     Bez tła i bez własnego zaokrąglenia: kształt rysuje sam SVG, więc
     kółko pod spodem byłoby drugą obwódką pod pierwszą.

     Kanoniczna terakota (#DA9787) dziedziczona przez `currentColor`
     do wnętrza SVG. Całość jest dekoracyjna i siedzi w `aria-hidden`,
     a kolejność niesie znacznik `ol` — więc obowiązuje ją wymóg
     rozpoznawalności kształtu, nie kontrastu tekstowego. */
  .step__marker {
    display: grid;
    place-items: center;
    inline-size: 3.05rem;
    block-size: 3.05rem;
    color: var(--accent);
    position: relative;
    /* Wyrównanie do PIERWSZEGO WIERSZA tytułu, nie do góry pudełka.
       Środek znaku ma trafić w środek wersaliki tytułu; bez tego znak
       zaczyna się równo z tytułem i optycznie wisi nad nim.
       Wartość dobrana pomiarem — patrz raport. */
    margin-block-start: -0.7rem;
  }

  /* `tabular-nums` wyrównuje cyfry — bez tego „01" i „06" mają różną
     szerokość i numer skacze w środku znaku. */
  .step__num {
    position: absolute;
    font-size: var(--fs-small);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .step__title {
    font-size: var(--fs-h4);
    margin-block-end: var(--space-3xs);
  }

  .step__text {
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: var(--measure);
  }

  /* ————————————————————————— karta rezerwacji ————————————————————————— */

  /* Na wąskim ekranie treść i przycisk stoją w słupku, od 40 rem rozchodzą
     się na boki jednego paska. Karta nie leży już na zdjęciu, więc nie
     potrzebuje ani pozycjonowania, ani chowania etykiety pod strzałkę. */
  /* Pas, nie sekcja. Domyślny rytm `md` dawał 76,8 px góra i dół —
     te same proporcje, które na stronie głównej zeszły do wartości
     poniżej. Klamra jest wspólna z FinalCta i ma nią pozostać.

     :global, bo klasa trafia na korzeń komponentu Section. */
  :global(.section.booking-strip) {
    padding-block: clamp(1rem, 0.8rem + 1vw, 1.5rem);
  }

  .booking {
    display: grid;
    gap: var(--space-sm);
    align-items: center;
  }

  .booking__text {
    display: grid;
    gap: var(--space-3xs);
  }

  .booking__title {
    font-size: var(--fs-h3);
  }

  .booking__help {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .booking__help a {
    color: var(--text-accent);
    margin-inline-start: 0.35em;
  }

  .booking__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }
  /* ————————————————————————— bloki informacyjne ————————————————————————— */

  .blocks {
    display: grid;
    gap: var(--space-md);
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface-alt);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .card__image {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .card__body {
    padding: var(--space-md);
  }

  .card__title {
    font-size: var(--fs-h3);
    margin-block-end: var(--space-xs);
  }

  .card__text {
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: var(--measure);
  }

  .amenities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-md);
    padding-block-start: var(--space-sm);
    border-block-start: var(--hairline) solid var(--line);
  }

  .amenities__item {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-accent);
  }

  /* Sam symbol w kanonicznej terakocie, etykieta obok zostaje
     w ciemniejszej — inaczej wersaliki 12 px przestałyby być czytelne.
     :global, bo Mark wstawia surowy SVG spoza scope tej strony. */
  .amenities__item :global(svg) {
    color: var(--accent);
  }

  /* Na szerokim ekranie treść kroku dostaje sufit, a nadmiar kolumny
     zostaje pustką po prawej — to jest ten kontrolowany oddech, nie
     niedokończony układ. Bez sufitu opis rozciągałby się na 1000 px,
     czyli ok. 150 znaków w wierszu. */
  @media (min-width: 60rem) {
    .step__body {
      max-width: 46rem;
    }

    /* `--space-md`, nie `lg`: przy sześciu krokach każde 20 px na wiersz
       to 240 px wysokości sekcji. Oddech ma być kontrolowany, nie
       przypadkowy. */
    .step {
      grid-template-columns: 5rem minmax(0, 1fr);
      padding-block: var(--space-md);
    }
  }
  @media (min-width: 48rem) {
    .blocks {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (min-width: 40rem) {
    /* Pasek: treść po lewej, przycisk po prawej. */
    .booking {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

</style>
