---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Section from '~/components/ui/Section.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import Mark from '~/components/ui/Mark.astro';
import Todo from '~/components/ui/Todo.astro';
import Faq from '~/components/sections/Faq.astro';
import { booking, site } from '~/data/site';
import { pages } from '~/data/copy/pages';
import { home } from '~/data/copy/home';
import { copyOrNull, isPlaceholder, showPlaceholders } from '~/lib/copy';

import photoSprzet from '~/assets/photos/studio-sprzet.jpg';
import photoSzatnia from '~/assets/photos/studio-szatnia.jpg';

/**
 * Brief §18 — osobna podstrona, bo odpowiada na wysokokonwersyjne pytania
 * osób, które nigdy nie ćwiczyły. To najczęstszy powód rezygnacji przed
 * pierwszą rezerwacją.
 *
 * Układ prowadzi przez trzy pytania w kolejności, w jakiej padają w głowie:
 * „co mnie czeka” (nagłówek), „co mam zrobić” (oś czasu), „na co uważać”
 * (bloki). Zdjęcia nie są dekoracją — każde stoi przy zdaniu, które
 * potwierdza: sprzęt przy „nie musisz nic przynosić”, szatnia przy „na miejscu”.
 */
const t = pages.firstVisit;
const steps = home.firstVisit.steps.filter((step) => !isPlaceholder(step.text));
const missingSteps = showPlaceholders
  ? home.firstVisit.steps.filter((step) => isPlaceholder(step.text))
  : [];
const lead = copyOrNull(t.lead);

/** Bloki ze zdjęciem stoją w pierwszym rzędzie — dowód czyta się przed regułą. */
const blocks = [
  { ...t.sections.bring, photo: photoSprzet, alt: t.photos.gear, amenities: false },
  { ...t.sections.arrival, photo: photoSzatnia, alt: t.photos.changing, amenities: true },
  { ...t.sections.health, photo: null, alt: null, amenities: false },
  { ...t.sections.cancel, photo: null, alt: null, amenities: false },
];
---

<Base title={t.meta.title} description={t.meta.description}>
  {/* Bez zdjęcia nagłówek nie ma czego stawiać w drugiej kolumnie, więc
      wraca do wspólnego komponentu podstron. Zostawienie pustej prawej
      połowy czytałoby się jak niezaładowany obrazek, a nie jak decyzja. */}
  <PageHeader
    eyebrow={t.eyebrow}
    title={t.title}
    lead={lead ?? undefined}
    crumbs={[{ label: 'Pierwsza wizyta', href: '/pierwsza-wizyta' }]}
    size="md"
    rule
  />

  <Section size="lg" tone="alt" class="stepsSection">
    {/* Nagłówek trzyma lewą kolumnę, oś czasu bierze resztę. Wcześniej oba
        stały jeden pod drugim na pełnej szerokości, a że tekst kroku jest
        ograniczony miarą czytelności, prawa połowa sekcji zostawała pusta.
        Ten sam podział co w bloku o założycielce na /o-nas. */}
    <div class="stepsLayout">
      <header class="stepsLayout__head">
        <p class="eyebrow">{t.stepsEyebrow}</p>
        <h2 class="steps__title">{t.stepsTitle}</h2>
      </header>

      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="step">
              <span class="step__marker" aria-hidden="true">
                <Mark size="2.2rem" />
                <span class="step__num">{String(index + 1).padStart(2, '0')}</span>
              </span>
              <div class="step__body">
                <h3 class="step__title">{step.title}</h3>
                <p class="step__text">{step.text}</p>
              </div>
            </li>
          ))
        }
        {
          missingSteps.map((step) => (
            <li class="step step--todo">
              <Todo label={step.text} block />
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <Section size="lg">
    <header class="blocks__header">
      <p class="eyebrow">{t.blocksEyebrow}</p>
      <h2 class="blocks__title">{t.blocksTitle}</h2>
    </header>

    <div class="blocks">
      {
        blocks.map((block) => {
          const body = copyOrNull(block.body);
          return (
            <article class="card">
              {block.photo && (
                <Image
                  src={block.photo}
                  alt={block.alt!}
                  widths={[420, 660, 900]}
                  sizes="(min-width: 60rem) 44vw, 100vw"
                  loading="lazy"
                  class="card__image"
                />
              )}
              <div class="card__body">
                <h3 class="card__title">{block.title}</h3>
                {body ? <p class="card__text">{body}</p> : <Todo label={block.body} block />}
                {block.amenities && (
                  <ul class="amenities">
                    {t.amenities.map((item) => (
                      <li class="amenities__item">
                        <Mark size="0.7rem" />
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </Section>

  <Faq />

  {/* Karta rezerwacji stała wcześniej na zdjęciu w nagłówku i tam się dusiła.
      Tu domyka stronę, której wcześniej brakowało wyjścia: najpierw sześć
      kroków i odpowiedzi na obawy, dopiero potem prośba o rezerwację. */}
  <Section size="md" tone="soft">
    <aside class="booking">
      <div class="booking__text">
        <h2 class="booking__title">{home.firstVisit.ctaLabel}</h2>
        <p class="booking__help">
          Wolisz zapisać się przez telefon?
          <a href={`tel:${site.phone}`} data-event="phone_click">{site.phoneDisplay}</a>
        </p>
      </div>

      <a
        class="booking__go"
        href={booking.frontOfficeUrl}
        target={booking.newTab ? '_blank' : undefined}
        rel={booking.newTab ? 'noopener' : undefined}
        data-cta-source="first-visit"
        data-event="first_visit_cta_click"
      >
        <span>{home.firstVisit.ctaLabel}</span>
        <svg class="booking__goIcon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M4 12h15m0 0-6-6m6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </aside>
  </Section>
</Base>

<style>
  /* ————————————————————————— oś czasu ————————————————————————— */

  .stepsLayout {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
  }

  .steps__title {
    margin-block-start: var(--space-2xs);
    max-width: 18ch;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    align-items: start;
    position: relative;
  }

  /* Linia łącząca kolejne kroki. Rysowana od znacznika w dół, ostatni krok
     jej nie dostaje, żeby oś nie wisiała w powietrzu pod listą. */
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    inset-block: 2.6rem calc(-1 * var(--space-md));
    inset-inline-start: calc(1.3rem - var(--hairline) / 2);
    inline-size: var(--hairline);
    background: var(--line);
  }

  .step--todo {
    grid-template-columns: 1fr;
  }

  /* Tło kropki zasłania linię łączącą, żeby nie przechodziła przez znacznik. */
  .step__marker {
    display: grid;
    place-items: center;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    border-radius: var(--radius-pill);
    background: var(--surface-alt);
    color: var(--text-accent);
    position: relative;
  }

  .step__num {
    position: absolute;
    font-size: var(--fs-caption);
    letter-spacing: 0.02em;
    color: var(--text-accent);
  }

  .step__title {
    font-size: var(--fs-h4);
    margin-block-end: var(--space-3xs);
  }

  .step__text {
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: var(--measure);
  }

  /* ————————————————————————— karta rezerwacji ————————————————————————— */

  /* Na wąskim ekranie treść i przycisk stoją w słupku, od 40 rem rozchodzą
     się na boki jednego paska. Karta nie leży już na zdjęciu, więc nie
     potrzebuje ani pozycjonowania, ani chowania etykiety pod strzałkę. */
  .booking {
    display: grid;
    gap: var(--space-md);
    align-items: center;
  }

  .booking__text {
    display: grid;
    gap: var(--space-2xs);
  }

  .booking__title {
    font-size: var(--fs-h3);
  }

  .booking__help {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .booking__help a {
    color: var(--text-accent);
    margin-inline-start: 0.35em;
  }

  .booking__go {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-block-size: 44px;
    padding-inline: var(--space-md);
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent);
    text-decoration: none;
    font-size: var(--fs-small);
    text-align: center;
  }

  .booking__goIcon {
    inline-size: 1.15rem;
    block-size: 1.15rem;
  }

  /* ————————————————————————— bloki informacyjne ————————————————————————— */

  .blocks__header {
    margin-block-end: var(--space-lg);
  }

  .blocks__title {
    margin-block-start: var(--space-2xs);
    max-width: 22ch;
  }

  .blocks {
    display: grid;
    gap: var(--space-md);
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface-alt);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .card__image {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .card__body {
    padding: var(--space-md);
  }

  .card__title {
    font-size: var(--fs-h3);
    margin-block-end: var(--space-xs);
  }

  .card__text {
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: var(--measure);
  }

  .amenities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-md);
    padding-block-start: var(--space-sm);
    border-block-start: var(--hairline) solid var(--line);
  }

  .amenities__item {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-accent);
  }

  @media (min-width: 48rem) {
    .blocks {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (min-width: 40rem) {
    /* Pasek: treść po lewej, przycisk po prawej. */
    .booking {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (min-width: 60rem) {
    /* Nagłówek sekcji trzyma stałą kolumnę, oś czasu bierze resztę. Bez tego
       kroki kończyły się w połowie ekranu, bo tekst kroku jest ograniczony
       miarą czytelności, a nie szerokością sekcji. */
    .stepsLayout {
      grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr);
      gap: var(--space-2xl);
    }

  }

  /* ————————————————— spięcie nagłówka z osią czasu —————————————————

     Piaskowe tło sekcji podnosi się prawą stroną w pas nagłówka, a oś czasu
     zaczyna się już w nim. Zamiast dwóch bloków jeden pod drugim robi się
     jeden ciągły kształt.

     Podniesiona część to prostokąt doklejony nad sekcją, zaokrąglony tylko
     w górnym lewym narożniku, promieniem równym własnej wysokości — wtedy
     krawędź jest ćwiartką koła i wchodzi w dolny pas bez załamania.

     UWAGA przy zmianach: krawędź piasku na wysokości `h` nad sekcją leży na
     `lewa + wejscie - sqrt(wejscie² - h²)`. Muszą być spełnione dwa warunki
     naraz, bo panel przechodzi między dwoma tekstami:

       • na wysokości dolnej krawędzi leadu piasek musi być NA PRAWO od niego,
       • na wysokości pierwszego kroku musi być NA LEWO od jego znacznika.

     Stąd dwie rzeczy w tym bloku. Po pierwsze próg 75 rem: niżej lead i oś
     czasu są zbyt blisko siebie i żadna krawędź nie spełnia obu warunków.
     Po drugie szersza lewa kolumna, która odsuwa oś czasu na tyle w prawo,
     żeby przedział na krawędź panelu w ogóle istniał.

     :global, bo klasa trafia na korzeń komponentu Section, a ten nosi swój
     własny scope Astro, nie tej strony. */
  @media (min-width: 75rem) {
    :global(.stepsSection) {
      --wejscie: 12rem;
      position: relative;
    }

    :global(.stepsSection)::before {
      content: '';
      position: absolute;
      /* Krawędź liczona od kontenera treści, nie od okna. Procent okna działa
         tylko dopóki kontener rośnie razem z nim — po przekroczeniu --container
         kontener zaczyna się centrować, tekst odjeżdża w prawo szybciej niż
         krawędź i przy ~1680 px panel wchodzi na lead. */
      inset-inline-start: calc(
        max(var(--gutter), (100% - var(--container)) / 2) + 0.44 *
          min(100% - 2 * var(--gutter), var(--container))
      );
      inset-inline-end: 0;
      inset-block-start: calc(-1 * var(--wejscie));
      block-size: var(--wejscie);
      background: var(--surface-alt);
      border-start-start-radius: var(--wejscie);
    }

    .stepsLayout {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    }

    /* Oś czasu wjeżdża w podniesiony pas, nagłówek sekcji zostaje na swoim
       miejscu. Ujemny margines musi znieść własny padding sekcji, inaczej
       kroki wchodzą w pas ledwie kilkadziesiąt pikseli i spięcia nie widać.
       2,5 rem zostaje jako oddech nad pierwszym krokiem.

       Oś dosunięta do prawej krawędzi kolumny. Tekst kroku ma sufit na
       --measure, więc przy wyrównaniu do lewej lista wisiała przy lewej
       krawędzi, a nadmiar kolumny zostawał pustką po prawej. Teraz jej
       prawa krawędź trafia w prawą krawędź kontenera, czyli w tę samą
       linię co tekst nagłówka wyżej.

       `justify-self` zamiast szerokości liczonej z tokenów: --measure jest
       podane w `ch`, a `ch` liczy się od stopnia pisma elementu, na którym
       stoi. Na liście jest większy niż na tekście kroku, więc wyliczona
       szerokość wychodziła szersza od kolumny i cała reguła była po cichu
       obcinana do 100%.

       Przesunięcie w prawo tylko powiększa zapas w spięciu z nagłówkiem —
       warunek „krawędź piasku na lewo od znacznika" robi się łatwiejszy. */
    .steps {
      margin-block-start: calc(2.5rem - var(--space-2xl) - var(--wejscie));
      justify-self: end;
    }
  }
</style>
