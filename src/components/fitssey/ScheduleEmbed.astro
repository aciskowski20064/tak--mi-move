---
import { booking, site, locations } from '~/data/site';
import type { Studio } from '~/types';
import { typo } from '~/lib/typografia';

/**
 * Osadzenie systemu Fitssey.
 *
 * Wariant docelowy (natywny widżet JS z panelu Studio → Integracje) nie jest
 * dostępny — nie mamy dostępu do konta klientki. Do tego czasu działa wariant
 * awaryjny z briefu §6.2: iframe do FrontOffice w oprawie marki.
 *
 * Konstrukcja jest tak przygotowana, żeby podmiana na natywny widżet
 * nie wymagała zmian w żadnej podstronie — wystarczy ustawić
 * `booking.widgetScript` i `fitsseyLocationId` w src/data/site.ts.
 *
 * Twarde wymagania z briefu §21, których pilnuje ten komponent:
 *  - czytelny stan ładowania,
 *  - minimalna wysokość (brak skoku layoutu),
 *  - brak poziomego scrolla całej strony,
 *  - fallback do pełnej strony Fitssey, gdy ramka nie wstanie,
 *  - `loading="lazy"`, żeby nie blokować renderu reszty treści.
 */
interface Props {
  /** Kontekst lokalizacji — filtrowanie zadziała dopiero z ID z panelu Fitssey. */
  studio?: Studio;
  title?: string;
}

const { studio, title = 'Grafik zajęć i zapisy — system rezerwacji Fitssey' } = Astro.props;

/**
 * Od 21.08.2026 grafik stoi na natywnym widżecie Fitssey, nie na ramce
 * FrontOffice. Ramka była wariantem awaryjnym z briefu §6.2 na czas
 * oczekiwania na kody.
 *
 * Biblioteka Fitssey nie rejestruje `lb-schedule-widget` jako prawdziwego
 * custom elementu — skanuje dokument raz i podmienia znaleziony znacznik na
 * własną ramkę. Wynikają z tego dwie rzeczy:
 *
 * 1. Widżet renderujemy JEDEN, a lokalizację dopisujemy atrybutem zanim
 *    biblioteka zdąży go zobaczyć. Trzy znaczniki (oba studia + dwa
 *    filtrowane) dawały trzy ramki, z czego dwie ukryte i nieprzetworzone.
 * 2. Skanowanie jest jednorazowe, więc podmiana lokalizacji bez przeładowania
 *    strony i tak by nie zadziałała — przełącznik zostaje odsyłaczem.
 */
const idLokalizacji = Object.fromEntries(
  locations.filter((l) => l.fitsseyLocationId).map((l) => [l.slug, l.fitsseyLocationId]),
);

/** Filtrowanie działa, dopóki obie lokalizacje mają identyfikator. */
const canFilter = locations.every((l) => Boolean(l.fitsseyLocationId));
---

<div class="embed" data-embed data-studio={studio}>
  <div class="embed__status" data-embed-status role="status">
    <span class="embed__spinner" aria-hidden="true"></span>
    <span>Wczytuję grafik…</span>
  </div>

  <div class="embed__widget" data-embed-widget>
    <lb-schedule-widget data-schedule-widget></lb-schedule-widget>
  </div>

  <noscript>
    <p class="embed__fallback-text">
      {typo('Grafik wymaga JavaScriptu.')}
      <a href={booking.frontOfficeUrl} target="_blank" rel="noopener">
        Otwórz system rezerwacji Fitssey
      </a>.
    </p>
  </noscript>

  {/* Brief §15.4 — komunikat pojawia się dopiero, gdy ramka faktycznie zawiedzie. */}
  <div class="embed__fallback" data-embed-fallback hidden>
    <p class="embed__fallback-title">{typo('Grafik nie załadował się poprawnie.')}</p>
    <p class="embed__fallback-text">
      {typo('System rezerwacji działa niezależnie od strony — otwórz go bezpośrednio.')}
    </p>
    <p class="embed__fallback-actions">
      <a
        class="embed__fallback-link"
        href={booking.frontOfficeUrl}
        target="_blank"
        rel="noopener"
        data-event="fitssey_fallback_click"
      >
        Otwórz system rezerwacji Fitssey
      </a>
      <a href={`tel:${site.phone}`} data-event="phone_click">
        albo zadzwoń: {site.phoneDisplay}
      </a>
    </p>
  </div>
</div>

{
  !canFilter && (
    <p class="embed__note">
      Grafik pokazuje zajęcia w obu studiach — lokalizację widać przy każdym terminie.
    </p>
  )
}

<script is:inline define:vars={{ mapa: idLokalizacji }}>
  /* Lokalizacja z adresu trafia na znacznik ZANIM wystartuje biblioteka —
     ona czyta atrybut w momencie skanowania i drugiej szansy nie daje. */
  (function () {
    var wybor = new URLSearchParams(location.search).get('studio');
    var id = wybor && mapa[wybor];
    var el = document.querySelector('[data-schedule-widget]');
    if (id && el) el.setAttribute('location', id);
  })();
</script>

<script is:inline define:vars={{ src: booking.widgetSrc, konto: booking.widgetAccount }}>
  /* Kod bazowy Fitssey. Stoi tutaj, a nie w Base.astro, żeby skrypt zewnętrzny
     wchodził tylko na tę podstronę — patrz komentarz przy widgetSrc w site.ts. */
  (function (w, d) {
    w.FitsseyWidget = 'lb';
    w.lb =
      w.lb ||
      function () {
        (w.lb.q = w.lb.q || []).push(arguments);
      };
    w.lb.l = 1 * new Date();
    var a = d.createElement('script');
    var m = d.getElementsByTagName('script')[0];
    a.async = 1;
    a.src = src;
    m.parentNode.insertBefore(a, m);
  })(window, document);
  lb('init', konto);
</script>

<script>
  /* Widżet ładuje się asynchronicznie — komunikat „wczytuję" znika, gdy
     biblioteka podmieni znacznik na własną ramkę. Limit czasu na wypadek,
     gdyby Fitssey nie odpowiedział; wtedy zostaje komunikat awaryjny. */
  const status = document.querySelector('[data-embed-status]');
  const kontener = document.querySelector('[data-embed-widget]');
  if (status && kontener) {
    const obs = new MutationObserver(() => {
      if (kontener.querySelector('iframe')) {
        status.hidden = true;
        obs.disconnect();
      }
    });
    obs.observe(kontener, { childList: true, subtree: true });
    setTimeout(() => {
      status.hidden = true;
      obs.disconnect();
    }, 8000);
  }
</script>

<style>
  .embed__widget[hidden] {
    display: none;
  }

  .embed {
    position: relative;
    /* Minimalna wysokość liczona z viewportu, ale nie mniejsza niż użyteczna —
       dzięki temu ramka nie przesuwa treści pod sobą po załadowaniu. */
    min-block-size: clamp(34rem, 78svh, 56rem);
    background: var(--surface-alt);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .embed__frame {
    display: block;
    inline-size: 100%;
    block-size: clamp(34rem, 78svh, 56rem);
    border: 0;
    background: transparent;
  }

  .embed__status,
  .embed__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2xs);
    padding: var(--space-lg);
    text-align: center;
    background: var(--surface-alt);
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .embed__status[hidden],
  .embed__fallback[hidden] {
    display: none;
  }

  .embed__spinner {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    border: 2px solid var(--line-strong);
    border-block-start-color: var(--accent-strong);
    border-radius: 50%;
    animation: embed-spin 900ms linear infinite;
  }

  @keyframes embed-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .embed__spinner {
      animation: none;
      border-block-start-color: var(--line-strong);
    }
  }

  .embed__fallback-title {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    color: var(--text);
  }

  .embed__fallback-actions {
    display: grid;
    gap: var(--space-2xs);
    margin-block-start: var(--space-sm);
  }

  .embed__fallback-link {
    display: inline-block;
    padding: 0.72em 1.5em;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .embed__note {
    margin-block-start: var(--space-sm);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-embed]');
  const frame = document.querySelector<HTMLIFrameElement>('[data-embed-frame]');
  const status = document.querySelector<HTMLElement>('[data-embed-status]');
  const fallback = document.querySelector<HTMLElement>('[data-embed-fallback]');

  if (root && frame && status && fallback) {
    let settled = false;

    const showFallback = () => {
      if (settled) return;
      settled = true;
      status.hidden = true;
      frame.hidden = true;
      fallback.hidden = false;
    };

    const showFrame = () => {
      if (settled) return;
      settled = true;
      status.hidden = true;
    };

    frame.addEventListener('load', () => {
      // Ramka blokowana przez X-Frame-Options / CSP też emituje `load`,
      // ale zostaje pusta. Cross-origin nie pozwala zajrzeć do środka,
      // więc jedynym pewnym sygnałem jest to, czy zdarzenie w ogóle przyszło.
      showFrame();
    });

    frame.addEventListener('error', showFallback);

    // Zabezpieczenie na wolne łącze i na ciche zablokowanie ramki.
    setTimeout(() => {
      if (!settled) showFallback();
    }, 12000);
  }
</script>
