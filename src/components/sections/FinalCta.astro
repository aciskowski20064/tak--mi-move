---
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import Mark from '~/components/ui/Mark.astro';
import { booking } from '~/data/site';
import { home } from '~/data/copy/home';

/**
 * Brief §12.14: końcowa sekcja ma być spokojna i konkretna.
 * Konstrukcja pochodzi wprost z briefu.
 */
const t = home.finalCta;
---

{/* Wąski pas domykający, nie kolejna pełnowymiarowa sekcja. Wcześniej miała
    658 px wysokości przy 402 px samej treści — sam padding `lg` zjadał 256 px,
    a wszystko stało w słupku: znak, tytuł, lead, przyciski i dopisek. */}
<Section size="sm" tone="soft">
  <div class="final">
    <div class="final__text">
      <h2 class="final__title">
        <Mark size="0.85rem" class="final__mark" />
        {t.title}
      </h2>
      <p class="final__lead">{t.lead}</p>
    </div>

    <div class="final__actions">
      <Button
        href={booking.frontOfficeUrl}
        newTab={booking.newTab}
        size="lg"
        source="final"
        event="booking_cta_click"
      >
        {booking.label}
      </Button>

      {/* Odnośnik przejęty po sekcji „Jak wygląda pierwsza wizyta", zdjętej ze
          strony głównej 21.08.2026. Sama sekcja była nagłówkiem i przyciskiem
          bez treści między nimi, ale wyjście do /pierwsza-wizyta musi zostać:
          to podstrona dla osób, które nigdy wcześniej nie ćwiczyły. */}
      <Button href="/pierwsza-wizyta" variant="secondary" source="final">
        {t.firstVisitLabel}
      </Button>

      <p class="final__secondary">
        {t.secondaryLead}{' '}
        <a href="/kontakt" data-event="email_click">{t.secondaryLabel}</a>
      </p>
    </div>
  </div>
</Section>

<style>
  /* Na wąskim ekranie słupek, od 52 rem pas: treść z lewej, przyciski z prawej.
     Dopisek o pytaniu wszedł pod przyciski zamiast tworzyć osobny wiersz. */
  .final {
    display: grid;
    gap: var(--space-md);
  }

  .final__text {
    display: grid;
    gap: var(--space-2xs);
  }

  .final__title {
    font-size: var(--fs-h3);
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .final :global(.final__mark) {
    color: var(--accent);
    flex: none;
  }

  .final__lead {
    max-width: 46ch;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .final__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .final__secondary {
    font-size: var(--fs-small);
    color: var(--text-muted);
    flex-basis: 100%;
  }

  .final__secondary a {
    color: var(--text-accent);
  }

  @media (min-width: 52rem) {
    .final {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--space-xl);
    }

    .final__actions {
      justify-content: end;
    }

    .final__secondary {
      text-align: end;
    }
  }
</style>
