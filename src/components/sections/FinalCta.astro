---
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import Mark from '~/components/ui/Mark.astro';
import { booking } from '~/data/site';
import { home } from '~/data/copy/home';

/**
 * Brief §12.14: końcowa sekcja ma być spokojna i konkretna.
 * Konstrukcja pochodzi wprost z briefu.
 */
const t = home.finalCta;
---

<Section size="lg" tone="soft">
  <div class="final">
    <Mark variant="solid" size="clamp(2.5rem, 7vw, 4rem)" class="final__mark" />
    <h2 class="final__title">{t.title}</h2>
    <p class="final__lead">{t.lead}</p>

    <div class="final__actions">
      <Button
        href={booking.frontOfficeUrl}
        newTab={booking.newTab}
        size="lg"
        source="final"
        event="booking_cta_click"
      >
        {booking.label}
      </Button>
    </div>

    <p class="final__secondary">
      {t.secondaryLead}{' '}
      <a href="/kontakt" data-event="email_click">{t.secondaryLabel}</a>
    </p>
  </div>
</Section>

<style>
  .final {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    text-align: center;
  }

  .final :global(.final__mark) {
    color: color-mix(in srgb, var(--clay) 55%, transparent);
    margin-block-end: var(--space-2xs);
  }

  .final__title {
    max-width: 16ch;
  }

  .final__lead {
    max-width: 40ch;
    color: var(--text-muted);
  }

  .final__actions {
    margin-block-start: var(--space-md);
  }

  .final__secondary {
    margin-block-start: var(--space-sm);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .final__secondary a {
    color: var(--text-accent);
  }
</style>
