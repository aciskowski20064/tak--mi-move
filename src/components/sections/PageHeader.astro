---
import Section from '~/components/ui/Section.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import { typo } from '~/lib/typografia';
import type { NavItem } from '~/data/nav';

/**
 * Wspólny nagłówek podstron. Utrzymuje jeden H1 na stronę i stały rytm
 * wejścia w treść, żeby podstrony nie wyglądały jak zlepek osobnych projektów.
 */
interface Props {
  eyebrow?: string;
  title: string;
  /**
   * Tytuł łamany na WIERSZE, po jednym elemencie blokowym na wiersz —
   * ten sam mechanizm co w hero strony głównej.
   *
   * Potrzebny tam, gdzie hasło ma stać w słupku niezależnie od tego, ile
   * miejsca zostaje w wierszu. Samo zwężenie pudełka do `min-content`
   * nie wystarcza: szerokość spada wtedy do najdłuższego słowa, a krótsze
   * wyrazy potrafią się w niej zmieścić po dwa (zmierzone na /zajecia:
   * „SIŁA SPOKÓJ" mieści się w 426 px szerokości słowa „RÓWNOWAGA").
   *
   * Pominięty — tytuł renderuje się dokładnie jak dotąd, jednym ciągiem.
   */
  titleLines?: readonly string[];
  lead?: string;
  /**
   * Lead rozbity na OSOBNE AKAPITY, po jednym elemencie na zdanie.
   *
   * Jeden ciąg z dwoma zdaniami zostawia pierwsze słowo drugiego zdania
   * doklejone do końca wiersza pierwszego — przeglądarka nie ma powodu
   * łamać wiersza akurat po kropce, a wiązanie sierot obejmuje tylko wyrazy
   * jedno- i dwuliterowe. Zgłoszone na `/kontakt` przy słowie „Wszystko".
   *
   * Osobne akapity rozstrzygają to strukturą, a nie sztucznym łamaniem:
   * `<br>` w środku zdania psułby skład przy każdej innej szerokości.
   *
   * Pominięty — renderuje się `lead`, dokładnie jak dotąd.
   */
  leadLines?: readonly string[];
  crumbs?: NavItem[];
  tone?: 'default' | 'alt' | 'soft';
  size?: 'sm' | 'md';
}

const {
  eyebrow,
  title,
  titleLines,
  lead,
  leadLines,
  crumbs,
  tone = 'default',
  size = 'md',
} = Astro.props;
---

<Section as="div" size={size} tone={tone} class="page-header">
  {crumbs && <Breadcrumbs items={crumbs} />}
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  {/* Wiązanie sierot stoi tu, a nie na czternastu podstronach z osobna —
      to jedyne wejście w treść, przez które przechodzą wszystkie. */}
  {/* Spacja MIĘDZY wierszami jest konieczna, choć wizualnie nic nie robi.
      Wiersze są blokowe, więc odstęp się nie renderuje — ale bez niego
      treść nagłówka to jeden ciąg „SIŁASPOKÓJRÓWNOWAGA" i tak właśnie
      przeczytałby go czytnik ekranu. Ta sama uwaga stoi w Hero.astro. */}
  <h1 class="page-header__title">
    {titleLines
      ? titleLines.map((wiersz, i) => (
          <>
            {i > 0 && ' '}
            <span class="page-header__titleWiersz">{wiersz}</span>
          </>
        ))
      : typo(title)}
  </h1>
  {/* Kreska stoi też pod tytułem bez leadu (np. podstrony studiów, polityki) —
      domyka nagłówek, zamiast zostawiać go zawieszonym nad treścią. */}
  <span class="page-header__rule" aria-hidden="true"></span>
  {leadLines
    ? leadLines.map((akapit) => <p class="lead page-header__lead">{typo(akapit)}</p>)
    : lead && <p class="lead page-header__lead">{typo(lead)}</p>}
</Section>

<style>
  /* Typografia wejścia siedzi w `base.css` — te same reguły obsługują
     dwukolumnowy nagłówek pierwszej wizyty. Tutaj zostaje sam odstęp. */
  .page-header {
    padding-block-end: var(--space-lg);
  }

  /* Wiersz tytułu. Reguła jest tu, a nie w base.css, bo dotyczy wyłącznie
     nagłówków korzystających z `titleLines` — reszta serwisu jej nie widzi. */
  .page-header__titleWiersz {
    display: block;
  }
</style>
