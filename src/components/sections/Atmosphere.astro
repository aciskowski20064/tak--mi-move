---
import { Image } from 'astro:assets';
import Section from '~/components/ui/Section.astro';
import { home } from '~/data/copy/home';
import spotkanie from '~/assets/photos/atmo-spotkanie.jpg';
import szatnia from '~/assets/photos/atmo-szatnia.jpg';
import herbata from '~/assets/photos/atmo-herbata.jpg';
import praktyka from '~/assets/photos/atmo-praktyka.jpg';

/**
 * Brief §12.8: duże zdjęcia z krótkimi podpisami zamiast galerii miniatur.
 *
 * Układ celowo wyrównany — równe kolumny, wspólna linia góry i dołu.
 * Kadry są pionowe (3:4) i przycinamy je do wspólnych proporcji,
 * żeby wiersz nie „schodkował”.
 *
 * UWAGA: żadne z tych zdjęć nie jest przypisane do konkretnej lokalizacji.
 * Potwierdzony jest wyłącznie kadr z hero (Pruszcz Gdański).
 */
const photoMap: Record<string, ImageMetadata> = {
  'atmo-spotkanie': spotkanie,
  'atmo-szatnia': szatnia,
  'atmo-herbata': herbata,
  'atmo-praktyka': praktyka,
};

const t = home.atmosphere;
---

<Section size="lg">
  <header class="atmo__head">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
  </header>

  <div class="atmo__grid">
    {
      t.photos.map((photo) => (
        <figure class="atmo__figure">
          <Image
            src={photoMap[photo.key]!}
            alt={photo.alt}
            widths={[480, 760, 1000]}
            sizes="(min-width: 48rem) 46vw, 100vw"
            loading="lazy"
            class="atmo__image"
          />
        </figure>
      ))
    }
  </div>
</Section>

<style>
  .atmo__head {
    max-width: var(--container-text);
    margin-block-end: var(--space-lg);
  }

  .atmo__head h2 {
    margin-block: var(--space-2xs) var(--space-sm);
  }

  .atmo__grid {
    display: grid;
    gap: var(--space-md);
  }

  .atmo__figure {
    margin: 0;
  }

  .atmo__image {
    inline-size: 100%;
    block-size: auto;
    /* 3:2 to natywna proporcja wszystkich czterech kadrów — zero przycięcia.
       Makieta ma kafle jeszcze szersze, ale przy 2:1 trzeba by zabrać 30%
       wysokości, a na trzech zdjęciach stoją ludzie i ucięłoby im głowy. */
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .atmo__caption {
    margin-block-start: var(--space-2xs);
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (min-width: 48rem) {
    .atmo__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
    }
  }
</style>
