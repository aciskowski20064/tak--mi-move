---
import { getCollection } from 'astro:content';
import { typo } from '~/lib/typografia';
import Section from '~/components/ui/Section.astro';
import ClassCard from '~/components/ui/ClassCard.astro';
import Todo from '~/components/ui/Todo.astro';
import { home } from '~/data/copy/home';
import { copyOrNull } from '~/lib/copy';
import { locations } from '~/data/site';

/**
 * Brief §12.5 i §13: NIE ciąg identycznych kart z tym samym zdjęciem
 * i jednozdaniowym opisem. Układ edytorialny — lista z wyraźną typografią,
 * cienkimi liniami i informacją, gdzie dane zajęcia się odbywają.
 *
 * Opisy pochodzą z kolekcji treści. Dopóki zespół ich nie napisze,
 * wiersz pokazuje samą nazwę i lokalizacje — nic nie jest dogenerowywane.
 */
const entries = await getCollection('classes', ({ data }) => import.meta.env.DEV || !data.draft);
const classes = entries.sort((a, b) => a.data.order - b.data.order);


const t = home.classes;
---

{
  classes.length > 0 && (
    <Section size="lg" tone="alt" id="zajecia" class="zajecia-sekcja">
      <header class="classes__head">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2>{typo(t.title)}</h2>
        <p class="lead">{typo(t.lead)}</p>
      </header>

      <ol class="classes__list">
        {classes.map((entry, index) => (
          <li>
            <ClassCard
              href={`/zajecia/${entry.id}`}
              name={entry.data.name}
              description={copyOrNull(entry.data.shortDescription)}
              index={index + 1}
            />
          </li>
        ))}
      </ol>

      <p class="classes__all">
        <a href="/zajecia">{t.allLabel}</a>
      </p>
    </Section>
  )
}

<style>
  /* Góra sekcji obcięta symetrycznie do dołu sekcji lokalizacji nad nią —
     obie stoją na tym samym tonie `alt`, więc razem dają teraz ok. 4–6 rem
     zamiast 9–16 rem. Dół zostaje pełny: niżej zaczyna się inny ton i tam
     przerwa ma co rozdzielać.

     :global, bo klasa trafia na korzeń komponentu Section i nosi JEGO scope. */
  :global(.section.zajecia-sekcja) {
    padding-block-start: var(--space-lg);
  }

  .classes__head {
    max-width: var(--container-text);
  }

  .classes__head h2 {
    margin-block: var(--space-2xs) var(--space-sm);
  }

  /* Kreska oddziela wstęp od kart — na makiecie ciągnie się przez całą
     szerokość sekcji, nie tylko pod węższym akapitem.

     Dwa odstępy nakładały się na siebie: `--space-lg` nad kreską i `--space-xl`
     pod nią, razem do 8 rem między leadem a pierwszym kaflem. Oba schodzą
     o stopień, więc kreska trzyma się nagłówka, a kafle kreski. */
  .classes__list {
    list-style: none;
    padding: 0;
    margin: 0;
    margin-block-start: var(--space-md);
    padding-block-start: var(--space-lg);
    border-block-start: var(--hairline) solid var(--line);
    display: grid;
    gap: var(--space-md);
  }

  /* Kafel wypełnia komórkę, więc sąsiedzi w rzędzie mają równą wysokość —
     `.karta` ma wewnątrz tor `1fr` na opisie i rozciąga się bez psucia
     rytmu. Ta sama reguła stoi przy siatce kafli na /zajecia. */
  .classes__list > li {
    display: grid;
  }

  .classes__all {
    margin-block-start: var(--space-lg);
    font-size: var(--fs-small);
  }

  .classes__all a {
    color: var(--text-accent);
  }

  /* Progi i liczba kolumn dokładnie te same co w siatce kafli na /zajecia —
     ta sama lista zajęć nie ma się łamać na dwóch stronach inaczej. */
  @media (min-width: 48rem) {
    .classes__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Trzy kolumny, nie pięć: sześć kafli układa się wtedy w pełne dwa rzędy
     po trzy, a nie w rząd pięciu i jeden osierocony. Rynna zostaje
     `--space-md`, tak jak na /zajecia. */
  @media (min-width: 64rem) {
    .classes__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
