---
import { getCollection } from 'astro:content';
import Section from '~/components/ui/Section.astro';
import Mark from '~/components/ui/Mark.astro';
import Todo from '~/components/ui/Todo.astro';
import { home } from '~/data/copy/home';
import { copyOrNull } from '~/lib/copy';
import { locations } from '~/data/site';

/**
 * Brief §12.5 i §13: NIE ciąg identycznych kart z tym samym zdjęciem
 * i jednozdaniowym opisem. Układ edytorialny — lista z wyraźną typografią,
 * cienkimi liniami i informacją, gdzie dane zajęcia się odbywają.
 *
 * Opisy pochodzą z kolekcji treści. Dopóki zespół ich nie napisze,
 * wiersz pokazuje samą nazwę i lokalizacje — nic nie jest dogenerowywane.
 */
const entries = await getCollection('classes', ({ data }) => import.meta.env.DEV || !data.draft);
const classes = entries.sort((a, b) => a.data.order - b.data.order);

const cityName = (slug: string) => locations.find((l) => l.slug === slug)?.city ?? slug;

const t = home.classes;
---

{
  classes.length > 0 && (
    <Section size="lg" tone="alt" id="zajecia">
      <header class="classes__head">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2>{t.title}</h2>
        <p class="lead">{t.lead}</p>
      </header>

      <ol class="classes__list">
        {classes.map((entry, index) => {
          const description = copyOrNull(entry.data.shortDescription);

          return (
            <li class="class-row">
              <a class="class-row__link" href={`/zajecia/${entry.id}`} data-event="class_detail_view">
                <span class="class-row__index">{String(index + 1).padStart(2, '0')}</span>

                <span class="class-row__body">
                  <span class="class-row__name">{entry.data.name}</span>
                  {description && <span class="class-row__desc">{description}</span>}
                  <span class="class-row__where">
                    {entry.data.locationSlugs.map((slug) => cityName(slug)).join(' · ')}
                  </span>
                </span>

                <span class="class-row__go" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12h15m0 0-6-6m6 6-6 6" />
                  </svg>
                </span>
              </a>

              {!description && <Todo label={entry.data.shortDescription} block />}
            </li>
          );
        })}
      </ol>

      <p class="classes__all">
        <a href="/zajecia">{t.allLabel}</a>
      </p>
    </Section>
  )
}

<style>
  .classes__head {
    max-width: var(--container-text);
  }

  .classes__head h2 {
    margin-block: var(--space-2xs) var(--space-sm);
  }

  /* Kreska oddziela wstęp od kart — na makiecie ciągnie się przez całą
     szerokość sekcji, nie tylko pod węższym akapitem. */
  .classes__list {
    list-style: none;
    padding: 0;
    margin: 0;
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-xl);
    border-block-start: var(--hairline) solid var(--line);
    display: grid;
    gap: var(--space-md);
  }

  .class-row {
    display: grid;
  }

  /* Cały kafel jest odsyłaczem, nie sama nazwa — większy cel dotyku
     i mniej miejsc, w które trzeba trafić palcem. */
  .class-row__link {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: var(--space-2xs);
    block-size: 100%;
    padding: var(--space-md);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .class-row__link:hover {
    border-color: var(--accent);
    background: var(--surface);
  }

  .class-row__index {
    font-size: var(--fs-small);
    color: var(--text-accent);
    font-variant-numeric: tabular-nums;
  }

  .class-row__name {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
  }

  .class-row__body {
    display: contents;
  }

  .class-row__desc {
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: 1.55;
  }

  .class-row__where {
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-block-start: var(--space-sm);
  }

  /* Kółko ze strzałką zamiast kropli: to jest przycisk „wejdź”, a kropla
     jest w tym projekcie znacznikiem, nie wskazaniem kierunku. */
  .class-row__go {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: var(--radius-pill);
    border: var(--hairline) solid var(--line-detail);
    color: var(--accent-strong);
    margin-block-start: var(--space-sm);
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .class-row__go svg {
    inline-size: 1.1rem;
    block-size: 1.1rem;
  }

  .class-row__link:hover .class-row__go {
    background: var(--accent);
    color: var(--on-accent);
    border-color: transparent;
  }

  .classes__all {
    margin-block-start: var(--space-lg);
    font-size: var(--fs-small);
  }

  .classes__all a {
    color: var(--text-accent);
  }

  @media (min-width: 40rem) {
    .classes__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Pięć kolumn dopiero tam, gdzie kafel ma sensowną szerokość. Niżej
     dwie, bo przy pięciu opis schodzi do ~14 znaków w wierszu. */
  @media (min-width: 64rem) {
    .classes__list {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-sm);
    }
  }
</style>
