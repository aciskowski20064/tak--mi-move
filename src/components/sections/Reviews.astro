---
import { getCollection, render } from 'astro:content';
import Section from '~/components/ui/Section.astro';
import Mark from '~/components/ui/Mark.astro';
import Button from '~/components/ui/Button.astro';
import Todo from '~/components/ui/Todo.astro';
import { home } from '~/data/copy/home';

/**
 * Brief §12.10: źródłem mogą być wyłącznie zweryfikowane opinie Google
 * albo wiadomości klientów za zgodą. Nie wolno przepisywać opinii bez źródła
 * ani tworzyć cytatów „w duchu” prawdziwych.
 *
 * Filtr `consent` jest twardy — brak zgody oznacza brak publikacji.
 */
const entries = await getCollection('reviews', ({ data }) => data.consent);
const sorted = entries.sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const reviews = await Promise.all(
  sorted.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const t = home.reviews;
import { showPlaceholders } from '~/lib/copy';
const isDev = showPlaceholders;

const sourceLabel = { google: 'Opinia Google', facebook: 'Opinia z Facebooka', direct: 'Wiadomość od klientki' };
---

{
  (reviews.length > 0 || isDev) && (
    <Section size="lg">
      <header class="reviews__head">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2>{t.title}</h2>
        <p class="reviews__rating">
          <Mark size="0.7rem" />
          {t.ratingLabel}
        </p>
      </header>

      {reviews.length > 0 ? (
        <ul class="reviews__grid">
          {reviews.map(({ entry, Content }) => (
            <li class="review">
              <Mark size="1rem" class="review__mark" />
              <blockquote class="review__quote">
                <Content />
              </blockquote>
              <figcaption class="review__meta">
                <span class="review__author">{entry.data.author}</span>
                {entry.data.sourceUrl ? (
                  <a href={entry.data.sourceUrl} target="_blank" rel="noopener nofollow">
                    {sourceLabel[entry.data.source]}
                  </a>
                ) : (
                  <span>{sourceLabel[entry.data.source]}</span>
                )}
              </figcaption>
            </li>
          ))}
        </ul>
      ) : (
        <Todo
          label="TODO(klientka): 3–6 realnych opinii z linkiem do źródła i zgodą autorek — bez tego sekcja opinii nie renderuje się w ogóle"
          block
        />
      )}

      {/* Zachęta do wystawienia opinii. Stoi także wtedy, gdy cytatów jeszcze
          nie ma — prośba o opinię nie wymaga posiadania opinii. */}
      <aside class="reviews__cta">
        <p class="reviews__ctaLead">{t.ctaLead}</p>
        <Button href={t.ctaUrl} newTab variant="secondary" source="reviews" event="review_click">
          {t.ctaLabel}
        </Button>
      </aside>
    </Section>
  )
}

<style>
  .reviews__head {
    max-width: var(--container-text);
    margin-block-end: var(--space-lg);
  }

  .reviews__rating {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-sm);
    font-size: var(--fs-small);
    color: var(--text-accent);
  }

  /* Zachęta oddzielona od cytatów linią — to prośba do czytelnika, nie
     kolejna opinia. */
  .reviews__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-lg);
    border-block-start: var(--hairline) solid var(--line);
  }

  .reviews__ctaLead {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .reviews__head h2 {
    margin-block-start: var(--space-2xs);
  }

  .reviews__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }

  /* Kafel zamiast kolumny z kreską u góry. Autor odsunięty do dołu karty
     przez `auto 1fr auto` — bez tego karty z krótszym cytatem miały podpis
     zawieszony w połowie wysokości, a rząd wyglądał na rozjechany. */
  .review {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-sm);
    /* Piasek na kremie — ten sam wzorzec co kafle na /o-nas. Karta w kolorze
       tła sekcji nie odcinała się wcale, a sama ramka to za mało. */
    background: var(--surface-alt);
    border-radius: var(--radius-card);
    padding: var(--space-lg);
  }

  .review :global(.review__mark) {
    color: var(--accent);
  }

  .review__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    line-height: var(--lh-heading);
  }

  .review__meta {
    padding-block-start: var(--space-sm);
    border-block-start: var(--hairline) solid var(--line-strong);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  .review__author {
    font-weight: 500;
    color: var(--text);
  }

  @media (min-width: 48rem) {
    .reviews__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
    }
  }
</style>
