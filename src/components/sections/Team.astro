---
import { Image } from 'astro:assets';
import Section from '~/components/ui/Section.astro';
import { typo } from '~/lib/typografia';
import Mark from '~/components/ui/Mark.astro';
import { pages } from '~/data/copy/pages';

/**
 * Sekcja „Prowadzące" po decyzji klientki (odpowiedź 1): bez nazwisk,
 * bez zdjęć osób, bez kart. Zostaje ogólna informacja, cztery cechy wspólne
 * z odpowiedzi 13–16 i odesłanie do grafiku — dokładnie to, o co prosiła.
 *
 * UKŁAD DWUKOLUMNOWY (28.08.2026). Wcześniej cała sekcja była jedną
 * wyśrodkowaną kolumną: kadr na środku, pod nim tekst, pod nim śródtytuł
 * i karty. Przy pionowym zdjęciu zespołu dawało to prawie 1500 px wysokości
 * i sekcja rozjeżdżała się w pionie.
 *
 * Teraz góra sekcji jest dwukolumnowa — kadr po lewej, nagłówek i opis po
 * prawej — a „Co nas łączy" stoi pod nią jako osobny blok, oddzielony
 * ornamentem. Ten sam ornament (kreska, znak marki, kreska) był tu wcześniej
 * pod tytułem; przeniesiony w miejsce, gdzie realnie coś rozdziela.
 */
// TEMP — final team photo pending client approval.
// Jedyne miejsce ze ścieżką kadru zespołu: podmiana to zmiana tej linii.
// Kandydatki wskazane w shortliście, żadna niezatwierdzona: `TAK MI MOVE (3)`
// i `DSC01989` z materiałów oraz `zespol-przy-logo.jpg` (ten stoi już
// w intro tej podstrony, więc świadomie go tu nie powtarzam).
import fotoZespolu from '~/assets/photos/zespol-grupa.jpg';

const t = pages.about.crew;

/**
 * Dwa zdania klientki rozdzielone na osobne akapity. Treść jest nietknięta —
 * dzielimy ją przy renderowaniu, po kropce kończącej pierwsze zdanie, żeby
 * w danych została jednym ciągiem (idzie stamtąd również do opisów dla
 * wyszukiwarek, gdzie podział na akapity nie ma sensu).
 */
const zdania = t.body.split(/(?<=\.)\s+/).filter(Boolean);
---

<Section size="lg" tone="alt" class="crewSekcja">
  <div class="crew">
    <div class="crew__glowna">
      <figure class="crew__figura">
        <Image
          src={fotoZespolu}
          alt="Cztery prowadzące TAK MI MOVE w sali studia"
          widths={[380, 560, 760]}
          sizes="(min-width: 60rem) 42vw, 100vw"
          loading="lazy"
          class="crew__foto"
        />
      </figure>

      <div class="crew__tresc">
        <p class="crew__eyebrow eyebrow">{t.eyebrow}</p>
        <h2 class="crew__title">{typo(t.title)}</h2>

        {zdania.map((zdanie) => <p class="crew__lead">{typo(zdanie)}</p>)}
      </div>
    </div>

    {/* Separator między „Prowadzącymi" a „Co nas łączy" — kreska, znak
        marki, kreska. Element już obecny w systemie, nie nowy pomysł. */}
    <div class="crew__ornament" aria-hidden="true">
      <span class="crew__rule"></span>
      <Mark size="1.5rem" />
      <span class="crew__rule"></span>
    </div>

    <div class="crew__laczy">
      <h3 class="crew__valuesTitle">{typo(t.valuesTitle)}</h3>

      <ul class="crew__values">
        {
          t.values.map((value) => (
            <li class="crew__value">
              <span class="znak crew__badge" aria-hidden="true">
                <Mark size="1.1rem" />
              </span>
              <span class="crew__label">{typo(value)}</span>
            </li>
          ))
        }
      </ul>

      <a class="crew__link" href={t.linkHref}>{typo(t.linkLabel)}</a>
    </div>
  </div>
</Section>

<style>
  /* Kontener węższy od pasa treści. Przy pełnej szerokości kadr i tekst
     rozjeżdżały się na 1191 px i sekcja przestawała być kompozycją. */
  .crew {
    max-inline-size: 70rem;
    margin-inline: auto;
    display: grid;
    gap: var(--space-xl);
    justify-items: center;
  }

  .crew__glowna {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    inline-size: 100%;
  }

  .crew__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .crew__eyebrow::before {
    content: '';
    inline-size: 1.75rem;
    block-size: 1px;
    background: var(--line-detail);
  }

  .crew__title {
    font-size: var(--fs-h2);
    margin-block: var(--space-2xs) var(--space-md);
  }

  .crew__ornament {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    inline-size: min(100%, 22rem);
    color: var(--accent);
  }

  .crew__rule {
    flex: 1;
    block-size: 1px;
    background: var(--line-detail);
  }

  /* Kadr zespołu: jeden, klientka prosiła o ZDJĘCIE kadry, nie o galerię.
     Proporcja natywna pliku (1536 × 2048, czyli pion 3:4) — bez `cover`
     i bez wymuszonej proporcji kafel pokazuje cały kadr. */
  /* Sufit 22 rem obowiązuje tylko w układzie pionowym, gdzie kadr stoi
     nad tekstem i bez ograniczenia rozciągnąłby się na całą sekcję. */
  .crew__figura {
    margin: 0;
    inline-size: 100%;
    max-inline-size: 22rem;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .crew__foto {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 4;
  }

  /* Dwa zdania jako osobne akapity, każde w wąskiej mierze. Jeden szeroki
     blok na całą kolumnę czytał się jako ściana tekstu. */
  .crew__lead {
    max-inline-size: 36ch;
  }

  .crew__lead + .crew__lead {
    margin-block-start: var(--space-sm);
  }

  .crew__laczy {
    inline-size: 100%;
    display: grid;
    justify-items: center;
  }

  .crew__valuesTitle {
    font-size: var(--fs-h4);
  }

  .crew__values {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-md);
    display: grid;
    gap: var(--space-md);
    /* Sufit szerokości: bez niego cztery pozycje rozjeżdżają się na całą
       sekcję i karty ciągną się przez pół ekranu.

       46rem → 62rem (30.08.2026). Przy 46rem karta miała 354 px, z czego na
       tekst zostawało 243 px po odjęciu wypełnienia, znaku (2,5rem) i odstępu.
       Najdłuższa nazwa — „Otwartość na drugiego człowieka" — potrzebuje przy
       21 px pisma ok. 342 px, więc łamała się na dwa wiersze na KAŻDEJ
       szerokości. „Fachowe przygotowanie" (241 px) mieściło się na styk
       i pękało od 1440 px w górę, gdy wypełnienie karty urosło z 27,2 do 28 px.

       Przy 62rem karta ma ok. 482 px i ok. 369 px na tekst: najdłuższa nazwa
       stoi w jednym wierszu z zapasem, a nie na granicy. Sufit zostaje, bo bez
       niego karty rozciągnęłyby się na całe 70rem kontenera. */
    inline-size: min(100%, 62rem);
  }

  /* DOMKNIĘTY BLOK: ta sama receptura co karty wartości wyżej na tej
     podstronie — włoskowaty obrys i promień 14 px. Różni je wypełnienie:
     tutaj `--surface`, bo sekcja stoi na tonie `alt` i bez niego karta nie
     miałaby się na czym odciąć. */
  .crew__value {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-align: start;
    background: var(--surface);
    border: var(--hairline) solid var(--line);
    border-radius: 14px;
    padding: var(--space-sm) var(--space-md);
  }

  .crew__badge {
    --znak-size: 2.5rem;
    flex: none;
  }

  .crew__label {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    line-height: 1.3;
  }

  /* Oddech od kart powyżej: 16 px kleiło odsyłacz do dolnej krawędzi
     ostatniego bloku i wyglądał jak dopisek, a nie jak wyjście z sekcji. */
  .crew__link {
    margin-block-start: var(--space-lg);
    font-size: var(--fs-body);
    color: var(--text-accent);
    text-decoration: none;
    border-block-end: var(--hairline) solid currentColor;
    padding-block-end: 0.2em;
  }

  .crew__link:hover {
    border-block-end-width: 2px;
  }

  @media (min-width: 48rem) {
    .crew__values {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
      /* Wszystkie cztery karty równej wysokości także wtedy, gdy przy
         węższym oknie któraś etykieta jednak się złamie. */
      align-items: stretch;
    }
  }

  /* Kadr po lewej, treść po prawej. 0,8fr wobec 1fr daje kolumnie zdjęcia
     ok. 43% szerokości — tyle, żeby kadr niósł swoją wagę i nie przejmował
     sekcji. Poniżej progu wszystko schodzi w pion w kolejności:
     kadr, nagłówek z opisem, separator, „Co nas łączy", karty. */
  @media (min-width: 60rem) {
    .crew__glowna {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
      gap: var(--space-2xl);
      justify-items: start;
    }

    /* Sufit zdjęty: w dwóch kolumnach szerokość kadru wyznacza tor
       siatki, nie sztywna wartość. Przy 22 rem kadr miał 352 px, czyli
       31% kontenera — o jedną trzecią mniej, niż daje mu jego własna
       kolumna. Teraz wypełnia ją i siedzi w zamówionym paśmie 40–45%. */
    .crew__figura {
      max-inline-size: none;
    }
  }
</style>
