---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Section from '~/components/ui/Section.astro';
import Todo from '~/components/ui/Todo.astro';
import { home } from '~/data/copy/home';
import { copyOrNull, showPlaceholders } from '~/lib/copy';

/**
 * Brief §12.9. Na dostarczonych zdjęciach jest sześć instruktorek, ale
 * nie znamy ich imion ani nie mamy zgód na publikację wizerunku.
 *
 * Filtr `photoConsent` jest twardy: osoba bez zgody nie pojawi się na stronie
 * niezależnie od tego, co ktoś wpisze w pozostałych polach.
 */
const entries = await getCollection('team', ({ data }) => !data.draft && data.photoConsent);
const members = entries.sort((a, b) => a.data.order - b.data.order).slice(0, 4);

const t = home.team;
const lead = copyOrNull(t.lead);
const isDev = showPlaceholders;
---

{
  (members.length > 0 || isDev) && (
    <Section size="lg" tone="alt">
      <header class="team__head">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2>{t.title}</h2>
        {lead ? <p class="lead">{lead}</p> : <Todo label={t.lead} block />}
      </header>

      {members.length > 0 ? (
        <>
          <ul class="team__grid">
            {members.map((member) => (
              <li class="member">
                {member.data.photo && (
                  <Image
                    src={member.data.photo}
                    alt={member.data.photoAlt ?? `${member.data.name} — instruktorka TAK MI MOVE`}
                    widths={[280, 560]}
                    sizes="(min-width: 48rem) 22vw, 45vw"
                    loading="lazy"
                    class="member__photo"
                  />
                )}
                <h3 class="member__name">{member.data.name}</h3>
                {member.data.role && <p class="member__role">{member.data.role}</p>}
                {member.data.specialties && (
                  <p class="member__specialties">{member.data.specialties.join(' · ')}</p>
                )}
              </li>
            ))}
          </ul>

          <p class="team__all">
            <a href="/o-nas">{t.allLabel}</a>
          </p>
        </>
      ) : (
        <Todo
          label="TODO(klientka): imiona, role, specjalizacje, bio i ZGODY na publikację wizerunku — bez tego sekcja zespołu nie renderuje się w ogóle"
          block
        />
      )}
    </Section>
  )
}

<style>
  .team__head {
    max-width: var(--container-text);
    margin-block-end: var(--space-lg);
  }

  .team__head h2 {
    margin-block: var(--space-2xs) var(--space-sm);
  }

  .team__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }

  .member__photo {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-block-end: var(--space-sm);
  }

  .member__name {
    font-size: var(--fs-h4);
  }

  .member__role,
  .member__specialties {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .member__specialties {
    margin-block-start: var(--space-3xs);
  }

  .team__all {
    margin-block-start: var(--space-lg);
    font-size: var(--fs-small);
  }

  .team__all a {
    color: var(--text-accent);
  }

  @media (min-width: 40rem) {
    .team__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .team__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
