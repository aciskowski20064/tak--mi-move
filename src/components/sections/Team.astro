---
import Section from '~/components/ui/Section.astro';
import { pages } from '~/data/copy/pages';

/**
 * Sekcja „Prowadzące" po decyzji klientki (odpowiedź 1): bez nazwisk,
 * bez zdjęć, bez kart osób. Zostaje ogólna informacja, cztery cechy wspólne
 * z odpowiedzi 13–16 i odesłanie do grafiku — dokładnie to, o co prosiła.
 *
 * Poprzednia wersja czytała kolekcję `team` bramkowaną zgodami na wizerunek.
 * Kolekcja zniknęła razem z modelem: nie ma już czego bramkować, a sekcja
 * prosiła w demie o dane, które klientka wcześniej odrzuciła.
 *
 * Cztery cechy celowo nie są siatką kafli. Strona ma już „Co jest dla nas
 * ważne" w tej formie, a treść obu bloków się zazębia („fachowe
 * przygotowanie" ≈ „Bezpiecznie", „otwartość" ≈ „Ze wsparciem"). Jedna
 * linia czyta się jak zdanie, siatka czytałaby się jak powtórzenie.
 */
const t = pages.about.crew;
---

<Section size="lg" tone="alt">
  <div class="crew">
    <div class="crew__head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="crew__title">{t.title}</h2>
    </div>

    <div class="crew__body">
      <p class="lead crew__lead">{t.body}</p>

      <ul class="crew__values">
        {t.values.map((value) => <li class="crew__value">{value}</li>)}
      </ul>

      <a class="crew__link" href={t.linkHref}>{t.linkLabel}</a>
    </div>
  </div>
</Section>

<style>
  .crew {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
  }

  .crew__title {
    font-size: var(--fs-h2);
    margin-block-start: var(--space-2xs);
  }

  .crew__body {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  .crew__lead {
    max-width: var(--measure);
  }

  /* Cechy jako spokojna lista rozdzielona włoskowymi liniami, nie jako
     kafle i nie jako jeden ciąg. Ciąg zostawiał sierotę w drugim wierszu
     (3 + 1), a przy każdej zmianie szerokości łamał się gdzie indziej —
     lista wygląda tak samo na telefonie i na monitorze. */
  .crew__values {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    inline-size: min(100%, 30rem);
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    line-height: 1.3;
  }

  .crew__value {
    padding-block: var(--space-sm);
  }

  .crew__value + .crew__value {
    border-block-start: var(--hairline) solid var(--line);
  }

  .crew__link {
    font-size: var(--fs-small);
    color: var(--text-accent);
    text-decoration: none;
    border-block-end: var(--hairline) solid currentColor;
    padding-block-end: 0.2em;
  }

  .crew__link:hover {
    border-block-end-width: 2px;
  }

  @media (min-width: 48rem) {
    /* Ten sam podział co w sekcji lokalizacji niżej — nagłówek trzyma lewą
       kolumnę, treść bierze resztę. */
    .crew {
      grid-template-columns: auto 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
