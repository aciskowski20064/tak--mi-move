---
import { Image } from 'astro:assets';
import Section from '~/components/ui/Section.astro';
import Mark from '~/components/ui/Mark.astro';
import { locations, formatAddress, site } from '~/data/site';
import { home } from '~/data/copy/home';

import zdjecieP from '~/assets/photos/studio-pruszcz-sala.jpg';
import zdjecieG from '~/assets/photos/studio-gdansk-sala.jpg';

/**
 * Brief §12.4: podkreślić, że to jedna marka z dwiema przestrzeniami,
 * i ułatwić wybór.
 *
 * Układ przeniesiony 1:1 z /studia (decyzja z 21.08.2026). Wcześniej strona
 * główna miała własny wariant tej samej sekcji, więc te same dwie lokalizacje
 * wyglądały na dwóch podstronach inaczej. Jeden kafel, jeden zestaw danych.
 *
 * Kadr zamiast opisu: różnicę między jasną salą z jodełką w Pruszczu
 * a betonem i złoconymi lustrami w Gdańsku widać szybciej, niż da się ją
 * przeczytać. Opisy sal zostały na podstronach studiów.
 */
const zdjecia: Record<string, ImageMetadata> = {
  'pruszcz-gdanski': zdjecieP,
  gdansk: zdjecieG,
};

const t = home.studios;
---

<Section size="lg" tone="alt">
  <p class="eyebrow">{t.eyebrow}</p>
  <h2 class="studios__title">{t.title}</h2>
  <p class="lead studios__lead">{t.lead}</p>

  <ul class="studios">
    {
      locations.map((location) => (
        <li class="studio-card">
          <div class="studio-card__head">
            <Mark size="0.9rem" class="studio-card__mark" />
            <h3 class="studio-card__name">{location.city}</h3>
          </div>

          <p class="studio-card__address">{formatAddress(location)}</p>

          <figure class="studio-card__figure">
            <Image
              src={zdjecia[location.slug]}
              alt={`Sala studia TAK MI MOVE w ${location.cityLocative}`}
              widths={[480, 720, 1000]}
              sizes="(min-width: 48rem) 42vw, 100vw"
              loading="lazy"
              class="studio-card__photo"
            />
          </figure>

          <dl class="studio-card__contact">
            <dt>Telefon</dt>
            <dd>
              <a href={`tel:${site.phone}`} data-event="phone_click">{site.phoneDisplay}</a>
            </dd>
            <dt>E-mail</dt>
            <dd>
              <a href={`mailto:${location.email}`} data-event="email_click">{location.email}</a>
            </dd>
          </dl>

          <p class="studio-card__links">
            <a href={`/studia/${location.slug}`} data-event="studio_location_select">
              {t.linkLabel}
            </a>
            <a href={`/grafik?studio=${location.slug}`} data-event="schedule_page_view">
              {t.scheduleLabel}
            </a>
          </p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .studios__title {
    margin-block: var(--space-2xs) var(--space-sm);
  }

  .studios__lead {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .studios {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }

  /* Kafel z cienką linią w środku, nad nazwą — ten sam co na /studia. */
  .studio-card {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    background: var(--surface);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-card);
    padding: var(--space-lg);
  }

  .studio-card::before {
    content: '';
    block-size: 1px;
    background: var(--line-detail);
    margin-block-end: var(--space-sm);
  }

  .studio-card__head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .studio-card__head :global(.studio-card__mark) {
    color: var(--accent);
  }

  .studio-card__name {
    font-size: var(--fs-h2);
  }

  .studio-card__address {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .studio-card__figure {
    margin: 0;
    margin-block-start: var(--space-md);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .studio-card__photo {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .studio-card__contact {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3xs) var(--space-sm);
    margin-block-start: var(--space-sm);
    font-size: var(--fs-small);
  }

  .studio-card__contact dt {
    color: var(--text-muted);
  }

  .studio-card__contact dd {
    margin: 0;
  }

  .studio-card__contact a {
    color: var(--text-accent);
  }

  .studio-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin-block-start: var(--space-md);
    font-size: var(--fs-small);
  }

  .studio-card__links a {
    color: var(--text-accent);
    padding-block: 0.25rem;
  }

  @media (min-width: 48rem) {
    .studios {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }
</style>
