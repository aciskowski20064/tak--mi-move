---
/**
 * SYGNET i MOTYW — dwa różne elementy, które brandbook trzyma osobno.
 *
 *   `sygnet`  oficjalna część znaku: litera „O" ze słowa MOVE, pierścień
 *             z prześwitem (arkusz 15). Ma pole ochronne `1/2 y`, minimum
 *             4 mm / 20 px (§3.3–3.4) i WYŁĄCZNIE dwa kolory: czerń albo
 *             biel. Przebarwianie znaku zakazuje arkusz 31.
 *
 *   `motyw`   dekoracyjna pochodna sygnetu: ta sama sylwetka jako pełna,
 *             zamknięta plama (arkusz 27). Brandbook §6 przewiduje ją jako
 *             aplę kolorystyczną i jako maskę zdjęcia, więc TU kolor jest
 *             dozwolony — róż, szałwia, szarość.
 *
 * ŹRÓDŁO obu ścieżek: wektory wyciągnięte wprost z brandbooka (arkusz 27,
 * gdzie sygnet i motyw stoją obok siebie). Poprzednia wersja komponentu
 * używała kształtu obrysowanego programowo z rastra, ze zgodnością 93,5%
 * IoU deklarowaną w komentarzu — czyli rekonstrukcji, nie oryginału.
 *
 * Nazwy `ring` i `solid` z poprzedniej wersji zostają jako aliasy, żeby nie
 * przepisywać kilkudziesięciu wywołań w serwisie.
 */
import sygnetSvg from '~/assets/brand/sygnet.svg?raw';
import motywSvg from '~/assets/brand/motyw.svg?raw';

interface Props {
  /** `ring`/`sygnet` — znak oficjalny. `solid`/`motyw` — pochodna dekoracyjna. */
  variant?: 'ring' | 'solid' | 'sygnet' | 'motyw';
  size?: string;
  class?: string;
}

const { variant = 'ring', size = '1em', class: className } = Astro.props;

const toMotyw = variant === 'solid' || variant === 'motyw';

/* Minimum 20 px dotyczy SYGNETU (§3.3). Motyw jest dekoracją bez progu,
   ale zostawiamy tę samą podłogę — poniżej 20 px żadna z tych sylwetek
   nie jest już czytelna. */
const svg = (toMotyw ? motywSvg : sygnetSvg)
  .trim()
  .replace(
    '<svg',
    `<svg class="${className ?? ''}" style="inline-size:${size};block-size:${size};min-inline-size:20px;min-block-size:20px;flex:none;color:var(--sygnet-kolor)" aria-hidden="true" focusable="false"`,
  );
---

<Fragment set:html={svg} />
