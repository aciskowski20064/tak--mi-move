---
import type { CtaSource } from '~/types';

/**
 * Jedyny komponent przycisku w serwisie. Brief §31: nie używamy wielu etykiet
 * dla tej samej akcji, więc warianty różnią się wagą wizualną, nie treścią.
 *
 * SYSTEM WEZWAŃ (Etap 3) — trzy poziomy i nic poza nimi:
 *
 *   primary     wypełniona terakota, ciemny tekst (6.18:1). Akcja, po którą
 *               przyszedł czytelnik: rezerwacja, otwarcie grafiku.
 *   secondary   kontur, tekst w kolorze treści. Akcja równoległa, która ma
 *               być widoczna, ale nie ma przechwytywać uwagi.
 *   quiet       sam tekst z podkreśleniem. Wyjście poboczne — odsyłacz
 *               do podstrony, doprecyzowanie. Ta sama postać co `.link-cta`
 *               z base.css, który obsługuje odsyłacze poza tym komponentem.
 *
 * Zasady „jeden primary na ekran" świadomie NIE stosujemy. Dwa równorzędne
 * wyjścia obok siebie (umów wizytę i zobacz grafik) są uczciwe wobec
 * czytelnika, bo prowadzą do dwóch różnych rzeczy, których obu może chcieć.
 * Wymagamy natomiast, żeby nie stały obok siebie dwa przyciski WYPEŁNIONE
 * o różnej wadze — wtedy żaden nie jest pierwszy.
 *
 * `source` trafia do atrybutu data-cta-source i jest odczytywany przez
 * analitykę (zdarzenie booking_cta_click, brief §47).
 */
interface Props {
  /** Pominięty razem z `disabled` — przycisk bez celu nie ma adresu. */
  href?: string;
  /**
   * Wezwanie przygotowane, ale bez celu — renderuje `<button disabled>`
   * zamiast odsyłacza. Powstało dla oferty eventowej na /o-nas, gdzie
   * układ ma być gotowy, zanim klientka przyśle PDF: przycisk widać,
   * a martwego `href="#"` nie ma.
   *
   * Wygląd jest ten sam — te same klasy `.btn`, ten sam wariant — więc
   * po podpięciu pliku geometria się nie zmienia.
   */
  disabled?: boolean;
  variant?: 'primary' | 'secondary' | 'quiet';
  size?: 'md' | 'lg';
  newTab?: boolean;
  source?: CtaSource;
  event?: string;
  class?: string;
}

const {
  href,
  disabled = false,
  variant = 'primary',
  size = 'md',
  newTab = false,
  source,
  event,
  class: className,
} = Astro.props;

const external = !disabled && (newTab || (href ?? '').startsWith('http'));
---

{
  disabled ? (
    <button
      type="button"
      disabled
      class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
      data-cta-source={source}
    >
      <span class="btn__label">
        <slot />
      </span>
    </button>
  ) : (
    <a
      href={href}
      class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener' : undefined}
      data-cta-source={source}
      data-event={event}
    >
      <span class="btn__label">
        <slot />
      </span>
      {external && <span class="visually-hidden">(otwiera się w nowej karcie)</span>}
    </a>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    padding-block: 0.72em;
    padding-inline: 1.5em;
    /* Cel dotykowy. Przy ~70% ruchu z telefonów przycisk rezerwacji
       nie może być niższy niż palec — 44 px to minimum z wytycznych. */
    min-block-size: 44px;
    border: var(--hairline) solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-text);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .btn--lg {
    font-size: var(--fs-body);
    padding-inline: 1.9em;
  }

  /* Stan bez celu — GOTOWY PRZYCISK MARKI, CHWILOWO NIEAKTYWNY.

     Pierwsza wersja miała `opacity: 0.55` i terakota schodziła do bladego
     różu na kremowym tle — wyglądało to jak systemowy, wyszarzony
     placeholder, a nie jak przygotowane wezwanie marki. Zostaje pełne
     tło `--accent`, a nieaktywność niesie sam kursor i brak reakcji na
     najechanie: `disabled` na `<button>` wyłącza hover i fokus, więc
     żadna reguła stanu nie ma jak zadziałać.

     Zejście nasycenia zostaje, ale minimalne — etykieta `--on-accent`
     na `--accent` daje 6.18:1, przy 0.9 nadal ponad 5:1. Geometria
     identyczna z wersją aktywną, więc po podpięciu adresu nic
     nie skacze. */
  .btn:disabled {
    opacity: 0.9;
    cursor: default;
  }

  /* Tło --accent + tekst --on-accent = 6.2:1.
     Biel na terakocie daje 2.4:1 i jest w tym projekcie zakazana. */
  .btn--primary {
    background: var(--accent);
    color: var(--on-accent);
  }

  .btn--primary:hover {
    background: var(--accent-strong);
    color: var(--text-invert);
  }

  .btn--secondary {
    border-color: var(--line-strong);
    color: var(--text);
  }

  /* Podświetlenie z koloru marki, nie z dębu ze zdjęć podłogi. Terakota
     na 12% jest ledwie muśnięciem tła i nie konkuruje z wariantem
     wypełnionym, a należy do palety. */
  .btn--secondary:hover {
    border-color: var(--text);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .btn--quiet {
    padding-inline: 0;
    color: var(--text-accent);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.3em;
  }

  .btn--quiet:hover {
    text-decoration-color: currentColor;
  }
</style>
