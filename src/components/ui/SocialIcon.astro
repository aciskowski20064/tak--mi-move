---
/**
 * Znak platformy społecznościowej.
 *
 * Brief §8 wybiera symbol-kroplę zamiast biblioteki ikon, ale ta reguła
 * dotyczy ozdobników. Logotyp Instagrama i Facebooka to znaki rozpoznawcze
 * cudzych marek — czytelne bez podpisu i nie do zastąpienia kroplą.
 * Dlatego są jedynymi piktogramami w serwisie.
 *
 * Ścieżki rysowane samodzielnie z prostych figur (prostokąt zaokrąglony,
 * okrąg, kropka; litera „f"), żeby nie wciągać biblioteki ikon dla dwóch
 * znaków.
 */
interface Props {
  platform: 'instagram' | 'facebook';
  size?: string;
}

const { platform, size = '1.25rem' } = Astro.props;
---

{
  platform === 'instagram' ? (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      style={`inline-size:${size};block-size:${size};flex:none`}
      aria-hidden="true"
      focusable="false"
    >
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      style={`inline-size:${size};block-size:${size};flex:none`}
      aria-hidden="true"
      focusable="false"
    >
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <path
        d="M15.2 8.2h-1.5c-.8 0-1.2.4-1.2 1.1V11h2.6l-.4 2.6h-2.2V20"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path d="M10.1 11h2.4" stroke-linecap="round" />
    </svg>
  )
}
