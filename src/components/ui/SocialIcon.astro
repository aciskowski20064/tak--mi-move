---
/**
 * Znak platformy społecznościowej.
 *
 * Brief §8 wybiera symbol-kroplę zamiast biblioteki ikon, ale ta reguła
 * dotyczy ozdobników. Logotyp Instagrama i Facebooka to znaki rozpoznawcze
 * cudzych marek — czytelne bez podpisu i nie do zastąpienia kroplą.
 * Dlatego są jedynymi piktogramami w serwisie.
 *
 * Przerysowane 25.08.2026 wg wzorów przysłanych przez klientkę: glif stoi
 * w cienkim okręgu, a Facebook to samo „f", nie kwadrat z literą w środku.
 * Okrąg wpisuje je w język strony — te same kółka konturowe niosą już
 * strzałki kafli i piktogramy faktów.
 *
 * Jedno odstępstwo od wzoru, świadome: u klientki glif zajmuje ok. 37%
 * średnicy okręgu. Przy 17 px w stopce dałoby to literę wysoką na 6 px,
 * czyli nieczytelną. Proporcja jest zacieśniona do ok. 60%, żeby znak
 * działał w rozmiarze, w jakim faktycznie stoi na stronie.
 *
 * Rysowane z prostych figur, bez wciągania biblioteki ikon.
 */
interface Props {
  platform: 'instagram' | 'facebook';
  size?: string;
}

const { platform, size = '1.25rem' } = Astro.props;
const styl = `inline-size:${size};block-size:${size};flex:none`;
---

{
  platform === 'instagram' ? (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
      style={styl}
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="12" cy="12" r="11" />
      <rect x="7.4" y="7.4" width="9.2" height="9.2" rx="2.9" />
      <circle cx="12" cy="12" r="2.5" />
      <circle cx="15.2" cy="8.9" r="0.62" fill="currentColor" stroke="none" />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" fill="none" style={styl} aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.3" />
      {/* Litera „f" rysowana jako wypełniony kształt, nie obrys — tak jak
          na wzorze. Pionowa laska z chorągiewką u góry i poprzeczka. */}
      <path
        d="M14.6 6.6h-1.5c-1.9 0-3 1.1-3 3v1.7H8.4v2.4h1.7V19h2.5v-5.3h1.8l.4-2.4h-2.2V9.9c0-.7.3-1 1-1h1z"
        fill="currentColor"
      />
    </svg>
  )
}
