---
/**
 * Mapa Google osadzona na stałe — decyzja z 20.08.2026.
 *
 * Wcześniej mapa startowała jako statyczny panel z przyciskiem, żeby nie
 * łączyć się z Google przed zgodą na cookies. Klientka chce widzieć mapę
 * od razu, więc panel zniknął.
 *
 * UWAGA przy wdrażaniu zgody na cookies (brief §49): to jest właśnie ten
 * element, który baner musi bramkować. Osadzona ramka Google ustawia swoje
 * cookies przy wczytaniu, a strona nie ma jeszcze mechanizmu zgody.
 * `loading="lazy"` ogranicza to o tyle, że ramka wczytuje się dopiero przy
 * dojściu do niej wzrokiem, a nie przy samym wejściu na stronę.
 *
 * Odsyłacze pod mapą działają zawsze — to zwykłe linki, nie osadzenia,
 * więc same z siebie niczego nie zapisują.
 */
interface Props {
  address: string;
  label: string;
}

const { address, label } = Astro.props;

const query = encodeURIComponent(address);
const embedUrl = `https://www.google.com/maps?q=${query}&output=embed`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${query}`;
const viewUrl = `https://www.google.com/maps/search/?api=1&query=${query}`;
---

<figure class="map">
  <iframe
    class="map__frame"
    src={embedUrl}
    title={`Mapa dojazdu — ${label}`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen></iframe>

  <figcaption class="map__actions">
    <a href={directionsUrl} target="_blank" rel="noopener" data-event="studio_map_click">
      Wyznacz trasę
    </a>
    <a href={viewUrl} target="_blank" rel="noopener" data-event="studio_map_click">
      Otwórz w Google Maps
    </a>
  </figcaption>
</figure>

<style>
  .map {
    margin: 0;
  }

  .map__frame {
    display: block;
    inline-size: 100%;
    aspect-ratio: 16 / 10;
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-md);
  }

  .map__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin-block-start: var(--space-sm);
    font-size: var(--fs-small);
  }

  .map__actions a {
    color: var(--text-accent);
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
  }
</style>
