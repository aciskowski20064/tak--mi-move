---
import { Image } from 'astro:assets';
import kwiat from '~/assets/brand/ornament-kwiat.png';
import lisc from '~/assets/brand/ornament-lisc.png';

/**
 * Ornament roślinny z materiałów agencji kreatywnej klientki.
 *
 * ŹRÓDŁO: pliki pobrane przez klientkę z Canvy (25.08.2026), kompletne,
 * z przezroczystym tłem. Wcześniejsze wycinki z wyrenderowanego szablonu
 * posta zostały porzucone — były przycięte przez kadr i niższej jakości.
 *
 * CZEGO NIE WOLNO Z NIMI ROBIĆ: przerysowywać, rekonstruować, generować
 * podobnych, zmieniać kolorów wewnętrznych. To ilustracja klientki i ma
 * zostać dokładnie taka, jaka przyszła. Kolory z jej wnętrza (#d29c8c,
 * #94aca1, #dbb16d) nie są i nie będą tokenami interfejsu.
 *
 * TEN KOMPONENT NIE JEST JESZCZE NIGDZIE UŻYWANY — i tak ma być.
 * Etap 3 przygotowuje wyłącznie techniczną możliwość; rozmieszczenie
 * ornamentów projektują Etapy 4–9, każdy w swoim widoku.
 *
 * BUDŻET NA CAŁĄ WITRYNĘ: kilka świadomych wystąpień, nie więcej.
 * Ornament ma być gościem, nie drugim językiem wizualnym obok
 * symbolu-kropli. Zawsze dekoracyjny, zawsze `aria-hidden`, nigdy pod
 * tekstem o niskim kontraście, nigdy animowany.
 */
interface Props {
  motyw: 'kwiat' | 'lisc';
  /** Szerokość renderowania w pikselach — wysokość wynika z proporcji. */
  szerokosc?: number;
  /** Stonowanie. Ornament rzadko ma stać w pełnej sile. */
  krycie?: number;
  class?: string;
}

const { motyw, szerokosc = 320, krycie = 1, class: className } = Astro.props;

const zrodla = { kwiat, lisc } as const;
---

<Image
  src={zrodla[motyw]}
  alt=""
  width={szerokosc}
  densities={[1, 2]}
  loading="lazy"
  aria-hidden="true"
  class:list={['ornament', className]}
  style={krycie === 1 ? undefined : `opacity:${krycie}`}
/>

<style>
  .ornament {
    display: block;
    block-size: auto;
    /* Ornament nigdy nie przechwytuje kliknięcia — leży pod treścią,
       nawet gdy wizualnie na nią zachodzi. */
    pointer-events: none;
    user-select: none;
  }
</style>
