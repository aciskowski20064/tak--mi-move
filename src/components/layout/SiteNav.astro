---
import { getCollection } from 'astro:content';
import { mainNav, type NavItem } from '~/data/nav';
import { locations } from '~/data/site';

interface Props {
  variant: 'desktop' | 'mobile';
  currentPath: string;
}

const { variant, currentPath } = Astro.props;

/**
 * Podmenu składane z tych samych źródeł, z których generują się strony
 * (kolekcja `classes` i lista lokalizacji). Ten sam filtr co w getStaticPaths,
 * więc nawigacja nie może wskazać na stronę, która nie powstała.
 */
const classEntries = await getCollection('classes', ({ data }) => import.meta.env.DEV || !data.draft);
const classChildren: NavItem[] = classEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ label: entry.data.name, href: `/zajecia/${entry.id}` }));

const studioChildren: NavItem[] = locations.map((location) => ({
  label: location.city,
  href: `/studia/${location.slug}`,
}));

const items: NavItem[] = mainNav.map((item) => {
  if (item.href === '/zajecia' && classChildren.length > 0) return { ...item, children: classChildren };
  if (item.href === '/studia') return { ...item, children: studioChildren };
  return item;
});

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<ul class:list={['nav', `nav--${variant}`]}>
  {
    items.map((item) => (
      <li class="nav__item">
        <a
          href={item.href}
          class="nav__link"
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
        {item.children && variant === 'mobile' && (
          <ul class="nav__sub">
            {item.children.map((child) => (
              <li>
                <a href={child.href} class="nav__sublink">
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>

<style>
  .nav {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav__link {
    display: inline-block;
    /* WCAG 2.2 AA 2.5.8 — cel dotyku min. 24 px. Sam tekst ma 18 px. */
    padding-block: 0.25rem;
    font-size: var(--fs-small);
    text-decoration: none;
    color: var(--text);
    transition: color var(--dur) var(--ease);
  }

  .nav__link:hover {
    color: var(--text-accent);
  }

  /* Stan aktywny nie może być komunikowany samym kolorem (brief §44). */
  .nav__link[aria-current='page'] {
    color: var(--text-accent);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.4em;
  }

  /* ——— desktop ——— */
  .nav--desktop {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.3rem + 1.5vw, 2rem);
  }

  .nav--desktop .nav__sub {
    display: none;
  }

  /* ——— mobile ——— */
  .nav--mobile {
    display: grid;
    gap: var(--space-md);
  }

  .nav--mobile .nav__link {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    letter-spacing: 0.02em;
  }

  .nav__sub {
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0 0 0 var(--space-sm);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
    border-left: var(--hairline) solid var(--line);
  }

  .nav__sublink {
    display: inline-block;
    padding-block: 0.25rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
    text-decoration: none;
  }

  .nav__sublink:hover {
    color: var(--text);
  }
</style>
