---
import Logo from '~/components/ui/Logo.astro';
import Mark from '~/components/ui/Mark.astro';
import { site, booking, locations, formatAddress } from '~/data/site';
import { mainNav, footerLegalNav } from '~/data/nav';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Logo tone="light" width={96} />
      <p class="footer__claim">{site.tagline} w Gdańsku i Pruszczu Gdańskim.</p>
      <a class="footer__booking" href={booking.frontOfficeUrl} target="_blank" rel="noopener" data-cta-source="footer" data-event="booking_cta_click">
        <Mark size="0.85em" />
        {booking.label}
      </a>
    </div>

    <div class="footer__cols">
      {
        locations.map((location) => (
          <div class="footer__col">
            <h2 class="footer__heading">{location.city}</h2>
            <address class="footer__address">
              {formatAddress(location)}
              <br />
              <a href={`tel:${site.phone}`} data-event="phone_click">{site.phoneDisplay}</a>
              <br />
              <a href={`mailto:${location.email}`} data-event="email_click">{location.email}</a>
            </address>
            <ul class="footer__social">
              {location.social.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener me">{s.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="footer__col">
        <h2 class="footer__heading">Serwis</h2>
        <ul class="footer__list">
          {mainNav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="container footer__bar">
    <p class="footer__legalName">
      <span>© {year} {site.name}</span>
      {site.legalName && <span><span class="footer__sep" aria-hidden="true">·</span>{site.legalName}</span>}
      {site.vatId && <span><span class="footer__sep" aria-hidden="true">·</span>NIP {site.vatId}</span>}
    </p>
    <ul class="footer__legal">
      {footerLegalNav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-invert);
    color: var(--text-invert);
    padding-block: var(--space-xl) var(--space-md);
    margin-block-start: auto;
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .footer__inner {
    display: grid;
    gap: var(--space-xl);
  }

  .footer__claim {
    max-width: 24ch;
    margin-block-start: var(--space-sm);
    color: color-mix(in srgb, var(--bone) 72%, transparent);
    font-size: var(--fs-small);
  }

  .footer__booking {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-md);
    padding-block-end: 0.35em;
    border-block-end: var(--hairline) solid var(--accent);
    color: var(--accent);
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
  }

  .footer__booking:hover {
    text-decoration: none;
    color: var(--bone);
    border-block-end-color: var(--bone);
  }

  .footer__cols {
    display: grid;
    gap: var(--space-lg);
  }

  .footer__heading {
    font-family: var(--font-text);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--bone) 60%, transparent);
    margin-block-end: var(--space-xs);
  }

  .footer__address {
    font-style: normal;
    font-size: var(--fs-small);
    line-height: var(--lh-loose);
  }

  .footer__social,
  .footer__list {
    list-style: none;
    padding: 0;
    margin: var(--space-xs) 0 0;
    display: grid;
    font-size: var(--fs-small);
  }

  /* Cel dotykowy. WCAG 2.2 AA wymaga 24 px, ale stopka to gęsta lista
     odnośników obsługiwana kciukiem — dobijamy do 44 px paddingiem,
     zamiast powiększać sam tekst. */
  .footer__social a,
  .footer__list a,
  .footer__address a,
  .footer__legal a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-block: 0.3rem;
  }

  .footer__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: var(--hairline) solid color-mix(in srgb, var(--bone) 18%, transparent);
    font-size: var(--fs-caption);
    color: color-mix(in srgb, var(--bone) 62%, transparent);
  }

  /* Na wąskim ekranie dane rejestrowe idą w słupek, bez separatorów — kropka
     zawijana razem z tekstem lądowałaby na początku wiersza i udawała punktor.
     Separatory wracają dopiero wtedy, gdy całość mieści się w jednej linii. */
  .footer__legalName {
    display: flex;
    flex-direction: column;
  }

  .footer__sep {
    display: none;
  }

  @media (min-width: 48rem) {
    .footer__legalName {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .footer__sep {
      display: inline;
      margin-inline: var(--space-2xs);
      opacity: 0.5;
    }
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 48rem) {
    .footer__cols {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .footer__inner {
      grid-template-columns: minmax(16rem, 22rem) 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
