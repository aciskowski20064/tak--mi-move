---
import Logo from '~/components/ui/Logo.astro';
import Mark from '~/components/ui/Mark.astro';
import SocialIcon from '~/components/ui/SocialIcon.astro';
import { site, booking, locations } from '~/data/site';
import { mainNav, footerLegalNav } from '~/data/nav';
import { typo } from '~/lib/typografia';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      {/* Ciemna wersja znaku, bo stopka przestała być ciemna. Jasny wordmark
          dawał na szałwii 2.24:1 i po prostu by na niej zniknął. */}
      {/* Stopka ma miejsce na wariant podstawowy z dopiskiem STUDIO,
          w minimum 130 px z brandbooka §1.4. Na szałwiowej apli znak
          czarny — brandbook §4.2 punkt 2. */}
      <Logo variant="pionowy" tone="dark" width={130} />
      <p class="footer__claim">{typo(`${site.tagline} w Gdańsku i Pruszczu Gdańskim.`)}</p>
      <a class="footer__booking" href={booking.frontOfficeUrl} target="_blank" rel="noopener" data-cta-source="footer" data-event="booking_cta_click">
        <Mark size="0.85em" />
        {typo(booking.label)}
      </a>
    </div>

    <div class="footer__cols">
      {
        locations.map((location) => (
          <div class="footer__col">
            <h2 class="footer__heading">{location.city}</h2>
            {/* Adres składany z części, nie z gotowego napisu: przy jednym
                ciągu przeglądarka łamała wiersz wewnątrz kodu pocztowego,
                po dywizie — „80-" zostawało w pierwszej linijce, „756 Gdańsk"
                schodziło do drugiej. Kod i miasto trzymają się teraz razem. */}
            <address class="footer__address">
              {typo(location.street)},{' '}
              <span class="footer__miejscowosc">
                {location.postalCode} {location.city}
              </span>
              <br />
              <a href={`tel:${site.phone}`} data-event="phone_click">{site.phoneDisplay}</a>
              <br />
              <a href={`mailto:${location.email}`} data-event="email_click">{location.email}</a>
            </address>
            {/* Klientka zgłosiła (25.08.2026), że przy nazwach kont nie widać,
                która platforma jest która. Znak stoi PRZED nazwą i jest
                dekoracyjny — nazwa profilu zostaje tekstem, więc czytnik
                ekranu nadal czyta konkretne konto, a nie samą platformę.
                `SocialIcon` istniał już i działał na /kontakt; tutaj brakowało
                wyłącznie jego użycia. */}
            <ul class="footer__social">
              {location.social.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener me" class="footer__socialLink">
                    {/* Większy niż poprzedni znak bez okręgu: glif siedzi
                        teraz w kółku, więc przy 17 px sama litera schodziła
                        poniżej progu czytelności. */}
                    <SocialIcon platform={s.platform} size="1.35rem" />
                    <span>{typo(s.label)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="footer__col">
        <h2 class="footer__heading">Serwis</h2>
        <ul class="footer__list">
          {mainNav.map((item) => (
            <li><a href={item.href}>{typo(item.label)}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="container footer__bar">
    <p class="footer__legalName">
      <span>© {year} {typo(site.name)}</span>
      {site.legalName && <span><span class="footer__sep" aria-hidden="true">·</span>{typo(site.legalName)}</span>}
      {site.vatId && <span><span class="footer__sep" aria-hidden="true">·</span>NIP {site.vatId}</span>}
    </p>
    <ul class="footer__legal">
      {footerLegalNav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>

    {/* Podpis wykonawcy. Trzeci element paska prawnego, nie osobny wiersz —
        w słupku na telefonie zawija się razem z resztą, bez dokładania
        stopce wysokości. Bez logo i bez wezwania do działania: to nota,
        nie reklama. */}
    <p class="footer__autor">
      Realizacja:{' '}
      <a href="https://luviq.pl" target="_blank" rel="noopener">LUVIQ</a>
    </p>
  </div>
</footer>

<style>
  /* Stopka na szałwii marki #90aba2 (Etap 3, 25.08.2026). Wcześniej stała
     na --sage-darkest — szałwii przyciemnionej do 21% jasności, której
     klientka nie rozpoznała jako swojej. Tamten kolor nie pochodził
     z żadnego materiału, więc został usunięty, a nie poprawiony.

     Stopka jest przez to JASNA, nie ciemna, i to jest świadome: nie ma
     powodu, dla którego musiałaby być ciemna, a jasna szałwia jest kolorem,
     który klientka faktycznie ma.

     KONSEKWENCJA, o której trzeba pamiętać przy każdej kolejnej zmianie:
     terakota na szałwii daje 1.03:1, czyli jest niewidoczna. Stopka jako
     jedyne miejsce w serwisie nie ma akcentu w kolorze marki — hierarchię
     buduje w niej wielkość pisma i waga, nie kolor. */
  .footer {
    background: var(--surface-footer);
    color: var(--text-on-sage);
    padding-block: var(--space-xl) var(--space-md);
    margin-block-start: auto;
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .footer__inner {
    display: grid;
    gap: var(--space-xl);
  }

  .footer__claim {
    max-width: 24ch;
    margin-block-start: var(--space-sm);
    color: var(--text-on-sage-muted);
    font-size: var(--fs-small);
  }

  .footer__booking {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-md);
    padding-block-end: 0.35em;
    border-block-end: var(--hairline) solid var(--text-on-sage);
    color: var(--text-on-sage);
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
  }

  .footer__booking:hover {
    text-decoration: none;
    border-block-end-width: 2px;
  }

  .footer__cols {
    display: grid;
    gap: var(--space-lg);
  }

  .footer__heading {
    font-family: var(--font-text);
    font-size: var(--fs-caption);
    font-weight: 400;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-on-sage-muted);
    margin-block-end: var(--space-xs);
  }

  .footer__address {
    font-style: normal;
    font-size: var(--fs-small);
    line-height: var(--lh-loose);
  }

  /* Dywiz w kodzie pocztowym jest dla przeglądarki miejscem złamania wiersza
     jak każdy inny. Twarda spacja tego nie naprawi, bo złamanie wypada
     wewnątrz „80-756", a nie przy odstępie — stąd zakaz łamania na całości. */
  .footer__miejscowosc {
    white-space: nowrap;
  }

  .footer__social,
  .footer__list {
    list-style: none;
    padding: 0;
    margin: var(--space-xs) 0 0;
    display: grid;
    font-size: var(--fs-small);
  }

  /* Cel dotykowy. WCAG 2.2 AA wymaga 24 px, ale stopka to gęsta lista
     odnośników obsługiwana kciukiem — dobijamy do 44 px paddingiem,
     zamiast powiększać sam tekst. */
  /* Znak platformy i nazwa konta w jednym wierszu. Odstęp mały — znak ma
     rozpoznawać, nie konkurować z tekstem. */
  .footer__socialLink {
    gap: var(--space-2xs);
  }

  .footer__social a,
  .footer__list a,
  .footer__address a,
  .footer__legal a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-block: 0.3rem;
  }

  .footer__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: var(--hairline) solid var(--line-on-sage);
    font-size: var(--fs-caption);
    color: var(--text-on-sage-muted);
  }

  /* Na wąskim ekranie dane rejestrowe idą w słupek, bez separatorów — kropka
     zawijana razem z tekstem lądowałaby na początku wiersza i udawała punktor.
     Separatory wracają dopiero wtedy, gdy całość mieści się w jednej linii. */
  .footer__legalName {
    display: flex;
    flex-direction: column;
  }

  .footer__sep {
    display: none;
  }

  @media (min-width: 48rem) {
    .footer__legalName {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .footer__sep {
      display: inline;
      margin-inline: var(--space-2xs);
      opacity: 0.5;
    }
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Nota o wykonawcy. Dziedziczy stopień pisma i kolor z paska prawnego,
     więc nie ma własnej wagi wizualnej i nie konkuruje z marką studia.
     Sama nazwa dostaje wyłącznie podkreślenie — bez koloru akcentu, który
     na szałwii i tak byłby niewidoczny (kontrast 1.03). */
  .footer__autor a {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    text-underline-offset: 0.25em;
  }

  .footer__autor a:hover {
    text-decoration-color: currentColor;
  }

  @media (min-width: 48rem) {
    .footer__cols {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .footer__inner {
      grid-template-columns: minmax(16rem, 22rem) 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
